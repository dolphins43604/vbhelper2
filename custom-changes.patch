+package com.github.nacabaro.vbhelper.daos
+
+import androidx.room.Dao
+import androidx.room.Query
+import androidx.room.Upsert
+import com.github.nacabaro.vbhelper.domain.card.CardCharacter
+import com.github.nacabaro.vbhelper.domain.card.CardProgress
+import com.github.nacabaro.vbhelper.dtos.ToolsDtos
+
+/** Queries for card cleanup (duplicates, safe delete) and Jogress. */
+@Dao
+interface ToolsDao {
+    @Query(
+        """
+        SELECT COUNT(*) FROM UserCharacter uc
+        JOIN CardCharacter cc ON uc.charId = cc.id
+        WHERE cc.cardId = :cardId
+    """
+    )
+    suspend fun countStoredDigimonForCard(cardId: Long): Int
+
+    @Query("SELECT * FROM CardCharacter WHERE cardId = :cardId")
+    suspend fun getCardCharacters(cardId: Long): List<CardCharacter>
+
+    @Query("UPDATE UserCharacter SET charId = :toCharId WHERE charId = :fromCharId")
+    suspend fun moveStoredDigimon(fromCharId: Long, toCharId: Long)
+
+    @Query("UPDATE TransformationHistory SET stageId = :toCharId WHERE stageId = :fromCharId")
+    suspend fun moveTransformationHistory(fromCharId: Long, toCharId: Long)
+
+    @Query("INSERT OR IGNORE INTO Dex(id, discoveredOn) SELECT :toCharId, discoveredOn FROM Dex WHERE id = :fromCharId")
+    suspend fun copyDexEntry(fromCharId: Long, toCharId: Long)
+
+    @Query("SELECT * FROM CardProgress WHERE cardId = :cardId")
+    suspend fun getCardProgress(cardId: Long): CardProgress?
+
+    @Upsert
+    suspend fun saveCardProgress(progress: CardProgress)
+
+    @Query(
+        """
+        SELECT
+            cf.toCharaId AS toCharaId,
+            cf.attribute AS partnerAttribute,
+            cc.charaIndex AS charaIndex,
+            cc.cardId AS cardId,
+            cc.stage AS stage,
+            s.spriteIdle1 AS spriteIdle,
+            s.width AS spriteWidth,
+            s.height AS spriteHeight
+        FROM CardFusions cf
+        JOIN CardCharacter cc ON cc.id = cf.toCharaId
+        JOIN Sprite s ON s.id = cc.spriteId
+        WHERE cf.fromCharaId = :charaId
+        ORDER BY cc.charaIndex
+    """
+    )
+    suspend fun getJogressOptions(charaId: Long): List<ToolsDtos.JogressOption>
+
+    @Query(
+        """
+        UPDATE UserCharacter
+        SET charId = :newCharId, currentPhaseBattlesWon = 0, currentPhaseBattlesLost = 0
+        WHERE id = :userCharacterId
+    """
+    )
+    suspend fun transformStoredDigimon(userCharacterId: Long, newCharId: Long)
+}
