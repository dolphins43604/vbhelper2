+
+/**
+ * Pick an imported card, pick a Digimon on it, set its stats, and save it to
+ * storage. From storage it can be sent to the bracelet like any scanned Digimon.
+ */
+@Composable
+fun CreateCharacterScreen(
+    navController: NavController
+) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val repository = remember { CharacterForgeRepository(application.container.db) }
+    val scope = rememberCoroutineScope()
+
+    var cards by remember { mutableStateOf<List<Card>>(emptyList()) }
+    var selectedCard by remember { mutableStateOf<Card?>(null) }
+    var options by remember { mutableStateOf<List<ForgeDtos.CardCharacterOption>>(emptyList()) }
+    var selectedOption by remember { mutableStateOf<ForgeDtos.CardCharacterOption?>(null) }
+    var deviceType by remember { mutableStateOf(DeviceType.BEDevice) }
+    var stats by remember { mutableStateOf(ForgeStats()) }
+    var saving by remember { mutableStateOf(false) }
+
+    LaunchedEffect(Unit) {
+        cards = repository.getCards()
+    }
+
+    LaunchedEffect(selectedCard) {
+        selectedOption = null
+        options = selectedCard?.let { repository.getCharacterOptions(it.id) } ?: emptyList()
+        // BE Memory cards only work on a Vital Bracelet BE.
+        if (selectedCard?.isBEm == true) deviceType = DeviceType.BEDevice
+    }
+
+    Scaffold(
+        topBar = {
+            TopBanner(
+                text = stringResource(R.string.forge_create_title),
+                onBackClick = { navController.popBackStack() }
+            )
+        }
+    ) { contentPadding ->
+        LazyColumn(
+            verticalArrangement = Arrangement.spacedBy(8.dp),
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(top = contentPadding.calculateTopPadding())
+                .padding(horizontal = 16.dp)
+        ) {
+            if (cards.isEmpty()) {
+                item {
+                    Text(
+                        text = stringResource(R.string.forge_no_cards),
+                        modifier = Modifier.padding(vertical = 24.dp)
+                    )
+                }
+                return@LazyColumn
+            }
+
+            item { StepTitle(stringResource(R.string.forge_step_card)) }
+            items(cards, key = { it.id }) { card ->
+                FilterChip(
+                    selected = selectedCard?.id == card.id,
+                    onClick = { selectedCard = card },
+                    label = { Text(card.name) },
+                    modifier = Modifier.fillMaxWidth()
+                )
+            }
+
+            if (selectedCard != null) {
+                item { StepTitle(stringResource(R.string.forge_step_digimon)) }
+                items(options.chunked(4)) { row ->
+                    Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                        row.forEach { option ->
+                            CharacterEntry(
+                                icon = BitmapData(
+                                    bitmap = option.spriteIdle,
+                                    width = option.spriteWidth,
+                                    height = option.spriteHeight
+                                ),
+                                multiplier = 3,
+                                cardColors = if (selectedOption?.id == option.id) {
+                                    CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.primary)
+                                } else {
+                                    CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainerHighest)
+                                },
+                                onClick = { selectedOption = option },
+                                modifier = Modifier.weight(1f)
+                            )
+                        }
+                        repeat(4 - row.size) { Spacer(Modifier.weight(1f)) }
+                    }
+                }
+            }
+
+            if (selectedOption != null) {
+                item {
+                    Text(
+                        text = stringResource(
+                            R.string.forge_selected_summary,
+                            selectedOption!!.charaIndex,
+                            selectedOption!!.stage,
+                            selectedOption!!.attribute.name
+                        ),
+                        style = MaterialTheme.typography.bodyMedium
+                    )
+                }
+
+                item { StepTitle(stringResource(R.string.forge_step_bracelet)) }
+                item {
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        FilterChip(
+                            selected = deviceType == DeviceType.BEDevice,
+                            onClick = { deviceType = DeviceType.BEDevice },
+                            label = { Text(stringResource(R.string.forge_bracelet_be)) }
+                        )
+                        if (selectedCard?.isBEm != true) {
+                            FilterChip(
+                                selected = deviceType == DeviceType.VBDevice,
+                                onClick = { deviceType = DeviceType.VBDevice },
+                                label = { Text(stringResource(R.string.forge_bracelet_vb)) }
+                            )
+                        }
+                    }
+                }
+
+                item { StepTitle(stringResource(R.string.forge_step_stats)) }
+                item {
+                    StatsForm(
+                        stats = stats,
+                        deviceType = deviceType,
+                        onChange = { stats = it }
+                    )
+                }
+
+                item {
+                    Column(Modifier.padding(vertical = 16.dp)) {
+                        Text(
+                            text = stringResource(R.string.forge_test_warning),
+                            style = MaterialTheme.typography.bodySmall,
+                            modifier = Modifier.padding(bottom = 8.dp)
+                        )
+                        Button(
+                            enabled = !saving,
+                            onClick = {
+                                val card = selectedCard
+                                val option = selectedOption
+                                if (card != null && option != null) {
+                                saving = true
+                                scope.launch {
+                                    val newId = repository.createCharacter(card, option, deviceType, stats)
+                                    saving = false
+                                    Toast.makeText(
+                                        application,
+                                        application.getString(R.string.forge_created_toast),
+                                        Toast.LENGTH_SHORT
+                                    ).show()
+                                    navController.navigate(
+                                        NavigationItems.Scan.route.replace("{characterId}", newId.toString())
+                                    ) {
+                                        popUpTo(NavigationItems.Storage.route)
+                                    }
+                                }
+                                }
+                            },
+                            modifier = Modifier.fillMaxWidth()
+                        ) {
+                            Text(stringResource(R.string.forge_create_and_send))
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun StepTitle(text: String) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.titleLarge,
+        modifier = Modifier.padding(top = 12.dp)
+    )
+}
