+// ------------------------------------------------------------------------------------------ fight
+
+private sealed interface Step {
+    data object Idle : Step
+    data class Selected(val unit: Int) : Step
+    data class Moved(val unit: Int, val dest: Pos) : Step
+    data class Targeting(val unit: Int, val dest: Pos, val skill: Skill) : Step
+    data class Confirm(val unit: Int, val dest: Pos, val skill: Skill, val target: Int, val forecast: Forecast) : Step
+    /** Looking at any Digimon's details; taps keep working as in [back]. */
+    data class Inspect(val unit: Int, val back: Step) : Step
+}
+
+private fun skillCostText(s: Skill): String {
+    val cost = if (s.cost == 0) "free" else "${s.cost} Energy"
+    val range = when (s.kind) {
+        SkillKind.SELF -> "self"
+        SkillKind.ATTACK -> "range ${s.range}"
+        else -> "within ${s.range}"
+    }
+    return "$cost · $range"
+}
+
+@Composable
+private fun Fight(battle: TacticsBattle, frames: Map<Long, Frames>, onDone: () -> Unit) {
+    val scope = rememberCoroutineScope()
+    var tick by remember { mutableIntStateOf(0) }
+    var step by remember { mutableStateOf<Step>(Step.Idle) }
+    var busy by remember { mutableStateOf(false) }
+    val poses = remember { mutableStateMapOf<Int, Pose>() }
+    val popups = remember { mutableStateMapOf<Int, String>() }
+    var frame by remember { mutableIntStateOf(0) }
+
+    LaunchedEffect(Unit) {
+        while (true) { delay(500); frame++ }
+    }
+
+    suspend fun animate(events: List<BattleEvent>) {
+        for (e in events) {
+            when (e) {
+                is BattleEvent.Moved -> { poses[e.id] = Pose.WALK; tick++; delay(250); poses.remove(e.id) }
+                is BattleEvent.Hit -> {
+                    poses[e.attacker] = Pose.ATTACK; popups[e.target] = "-${e.damage}${if (e.crit) "!" else ""}"; tick++
+                    delay(450); poses.remove(e.attacker); popups.remove(e.target)
+                }
+                is BattleEvent.Miss -> {
+                    poses[e.attacker] = Pose.ATTACK; poses[e.target] = Pose.DODGE; popups[e.target] = "miss"; tick++
+                    delay(450); poses.remove(e.attacker); poses.remove(e.target); popups.remove(e.target)
+                }
+                is BattleEvent.Support -> { poses[e.user] = Pose.HAPPY; popups[e.user] = e.skill; tick++; delay(450); poses.remove(e.user); popups.remove(e.user) }
+                is BattleEvent.Line -> {}
+            }
+        }
+        tick++
+    }
+
+    fun doAction(unit: Int, dest: Pos, skill: Skill?, target: Int?, guard: Boolean = false) {
+        val f = battle.byId(unit)
+        val t = target?.let { battle.byId(it) }
+        busy = true
+        step = Step.Idle
+        scope.launch {
+            animate(battle.act(f, dest, skill, t, guard))
+            busy = false
+            tick++
+        }
+    }
+
+    fun endTurn() {
+        busy = true
+        step = Step.Idle
+        scope.launch {
+            battle.beginEnemyPhase(); tick++
+            delay(300)
+            while (true) {
+                val ev = battle.enemyStep() ?: break
+                animate(ev)
+                delay(150)
+            }
+            busy = false
+            tick++
+        }
+    }
+
+    // read tick so the board recomposes after every engine change
+    @Suppress("UNUSED_VARIABLE") val t0 = tick
+
+    Column(
+        Modifier
+            .fillMaxSize()
+            .verticalScroll(rememberScrollState()),
+        verticalArrangement = Arrangement.spacedBy(8.dp)
+    ) {
+        val winner = battle.winner
+        Row(Modifier.fillMaxWidth().padding(top = 6.dp), verticalAlignment = Alignment.CenterVertically) {
+            Text(
+                when {
+                    winner == TacticsBattle.PLAYER -> "Victory!"
+                    winner == TacticsBattle.ENEMY -> "Defeated"
+                    battle.enemyPhase -> "Round ${battle.round} · Enemy phase"
+                    else -> "Round ${battle.round} · Your phase"
+                },
+                style = MaterialTheme.typography.titleMedium,
+                modifier = Modifier.weight(1f)
+            )
+            if (winner == null) {
+                Button(onClick = { endTurn() }, enabled = !busy && !battle.enemyPhase) { Text("End turn") }
+            }
+        }
+
+        Board(battle, frames, step, poses, popups, frame, tick) { pos -> if (!busy && winner == null) step = onTap(battle, step, pos) }
+
+        IntentList(battle)
+
+        if (winner != null) {
+            Card(Modifier.fillMaxWidth()) {
+                Column(Modifier.padding(12.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                    Text(if (winner == TacticsBattle.PLAYER) "Your team won in ${battle.round} rounds." else "Your team was knocked out.",
+                        style = MaterialTheme.typography.titleMedium)
+                    Text("This is a test fight: no rewards or records change yet. Tell Claude what felt off.", style = MaterialTheme.typography.bodySmall)
+                    Button(onClick = onDone, modifier = Modifier.fillMaxWidth()) { Text("Back to setup") }
+                }
+            }
+        } else {
+            ActionPanel(battle, step, busy,
+                onSkill = { s ->
+                    val st = step
+                    if (st is Step.Moved) {
+                        if (s.kind == SkillKind.ATTACK) {
+                            val f = battle.byId(st.unit)
+                            val targets = battle.targetsFrom(f, st.dest, s)
+                            step = if (targets.size == 1) Step.Confirm(f.id, st.dest, s, targets[0].id, battle.forecast(f, st.dest, s, targets[0]))
+                            else Step.Targeting(st.unit, st.dest, s)
+                        } else doAction(st.unit, st.dest, s, null)
+                    }
+                },
+                onGuard = { (step as? Step.Moved)?.let { doAction(it.unit, it.dest, null, null, guard = true) } },
+                onWait = { (step as? Step.Moved)?.let { doAction(it.unit, it.dest, null, null) } },
+                onConfirm = { (step as? Step.Confirm)?.let { doAction(it.unit, it.dest, it.skill, it.target) } },
+                onCancel = {
+                    step = when (val st = step) {
+                        is Step.Confirm -> Step.Moved(st.unit, st.dest)
+                        is Step.Targeting -> Step.Moved(st.unit, st.dest)
+                        is Step.Inspect -> st.back
+                        else -> Step.Idle
+                    }
+                }
+            )
+        }
+
+        Text("Log", style = MaterialTheme.typography.labelLarge)
+        battle.log.take(8).forEach { Text(it, style = MaterialTheme.typography.bodySmall) }
+        Spacer(Modifier.height(24.dp))
+    }
+}
