+/**
+ * Phase 3 test fight: your stored Digimon against one card's Digimon on a 6×6 grid,
+ * with enemy intents and a Fire Emblem-style forecast before every attack.
+ */
+@Composable
+fun TacticsScreen(navController: NavController, characterId: Long) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val repo = remember { TacticsRepository(application, application.container.db) }
+    var mode by remember { mutableStateOf<Mode>(Mode.Setup) }
+
+    Scaffold(
+        topBar = {
+            TopBanner(
+                text = stringResource(R.string.tactics_title),
+                onBackClick = { if (mode is Mode.Setup) navController.popBackStack() else mode = Mode.Setup }
+            )
+        }
+    ) { padding ->
+        Box(
+            Modifier
+                .fillMaxSize()
+                .padding(top = padding.calculateTopPadding())
+                .padding(horizontal = 12.dp)
+        ) {
+            when (val m = mode) {
+                is Mode.Setup -> Setup(repo, characterId) { battle, frames -> mode = Mode.Fight(battle, frames) }
+                is Mode.Fight -> Fight(m.battle, m.frames, onDone = { mode = Mode.Setup })
+            }
+        }
+    }
+}
