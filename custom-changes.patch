+++ b/app/src/main/java/com/github/nacabaro/vbhelper/source/RunRepository.kt
@@ -0,0 +1,355 @@
+package com.github.nacabaro.vbhelper.source
+
+import android.content.Context
+import com.github.nacabaro.vbhelper.database.AppDatabase
+import com.github.nacabaro.vbhelper.dtos.TacticsDtos
+import com.github.nacabaro.vbhelper.roguelike.Crest
+import com.github.nacabaro.vbhelper.roguelike.EnemyPlan
+import com.github.nacabaro.vbhelper.roguelike.Equipped
+import com.github.nacabaro.vbhelper.roguelike.FighterSpec
+import com.github.nacabaro.vbhelper.roguelike.Gear
+import com.github.nacabaro.vbhelper.roguelike.GearLine
+import com.github.nacabaro.vbhelper.roguelike.GearSlot
+import com.github.nacabaro.vbhelper.roguelike.Growth
+import com.github.nacabaro.vbhelper.roguelike.MapNode
+import com.github.nacabaro.vbhelper.roguelike.Member
+import com.github.nacabaro.vbhelper.roguelike.NodeType
+import com.github.nacabaro.vbhelper.roguelike.Pending
+import com.github.nacabaro.vbhelper.roguelike.Rarity
+import com.github.nacabaro.vbhelper.roguelike.RunState
+import com.github.nacabaro.vbhelper.roguelike.Skills
+import com.github.nacabaro.vbhelper.roguelike.Stage
+import com.github.nacabaro.vbhelper.roguelike.Upgrades
+import com.github.nacabaro.vbhelper.utils.DebugLog
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import kotlin.math.abs
+import kotlin.random.Random
+
+private const val TAG = "Rogue"
+
+/**
+ * Everything the roguelike run needs from the phone: the saved run, gear and Bits (kept between runs),
+ * enemies built from each card's real evolution lines, and the rewards that go home to the real Digimon.
+ */
+class RunRepository(context: Context, db: AppDatabase) {
+    private val dao = db.tacticsDao()
+    val tactics = TacticsRepository(context, db)
+    private val runFile = File(context.filesDir, "rogue_run.json")
+    private val gearFile = File(context.filesDir, "rogue_gear.json")
+    private val upgradeFile = File(context.filesDir, "rogue_upgrades.json")
+    private val unitCache = mutableMapOf<Long, List<TacticsDtos.Fighter>>()
+
+    data class Lineup(val enemies: List<Pair<TacticsDtos.Fighter, FighterSpec>>, val messages: List<String>)
+
+    suspend fun units(cardId: Long): List<TacticsDtos.Fighter> = withContext(Dispatchers.IO) {
+        unitCache.getOrPut(cardId) { dao.getCardAll(cardId) }
+    }
+
+    // ------------------------------------------------------------------ run lifecycle
+
+    suspend fun newRun(party: List<Long>, cards: List<Long>): RunState {
+        val seed = System.nanoTime()
+        val run = RunState(seed, cards, party.map { Member(it) })
+        cards.forEachIndexed { area, card -> run.lineages[area] = buildLineages(card, Random(seed + area)) }
+        DebugLog.i(TAG, "New run: party $party, cards $cards")
+        save(run)
+        return run
+    }
+
+    /** Evolution chains on a card, starting from baby forms: In-Training → Child → … as far as the card goes. */
+    private suspend fun buildLineages(cardId: Long, rng: Random): List<List<Long>> {
+        val all = units(cardId)
+        val byId = all.associateBy { it.unitKey }
+        val evos = withContext(Dispatchers.IO) { dao.getEvolutions(cardId) }.groupBy({ it.fromId }, { it.toId })
+        val roots = all.filter { it.stage == 1 }.ifEmpty { all.filter { it.stage == 2 } }.ifEmpty { all }
+        if (roots.isEmpty()) return emptyList()
+        val chains = mutableListOf<List<Long>>()
+        repeat(12) { i ->
+            if (chains.size >= 5) return@repeat
+            val root = roots[(i + rng.nextInt(roots.size)) % roots.size]
+            val chain = mutableListOf(root.unitKey)
+            var cur = root
+            repeat(8) {
+                val next = evos[cur.unitKey].orEmpty().mapNotNull { byId[it] }.filter { it.stage > cur.stage }.randomOrNull(rng)
+                    ?: return@repeat
+                chain += next.unitKey; cur = next
+            }
+            if (chain !in chains) chains += chain
+        }
+        return chains
+    }
+
+    // ------------------------------------------------------------------ fighters
+
+    private fun group(stage: Int) = stage.coerceIn(1, 5)
+
+    /** A card Digimon for [stage] from evolution chain [chain], or the closest one the card has. */
+    private suspend fun pick(run: RunState, chain: Int, stage: Int, rng: Random): TacticsDtos.Fighter? {
+        val all = units(run.cards[run.area])
+        if (all.isEmpty()) return null
+        val byId = all.associateBy { it.unitKey }
+        val chains = run.lineages[run.area].orEmpty()
+        if (chains.isNotEmpty()) {
+            val c = chains[chain % chains.size].mapNotNull { byId[it] }
+            c.firstOrNull { group(it.stage) == stage }?.let { return it }
+        }
+        val best = all.map { group(it.stage) }.distinct().minBy { abs(it - stage) }
+        return all.filter { group(it.stage) == best }.random(rng)
+    }
+
+    /** Baby forms (and odd entries) have no battle stats on the card: use their stage's typical numbers. */
+    private fun fixStats(f: TacticsDtos.Fighter): TacticsDtos.Fighter {
+        if (f.hp > 0 && f.ap > 0 && f.dp > 0) return f
+        val st = Stage.fromCard(f.stage)
+        return f.copy(hp = st.medHp.toInt(), ap = st.medAp.toInt(), dp = st.medDp.toInt())
+    }
+
+    suspend fun partyStage(run: RunState): Stage =
+        run.partyStage(run.members.mapNotNull { tactics.stored(it.key)?.stage })
+
+    suspend fun enemies(run: RunState, node: MapNode, type: NodeType): Lineup {
+        val stage = partyStage(run)
+        val slots = EnemyPlan.slots(run.area, node.row, type, stage)
+        val rng = Random(run.seed + run.area * 1000L + node.id)
+        val messages = mutableListOf<String>()
+        val out = slots.mapIndexedNotNull { i, slot ->
+            val chain = if (slot.boss) 0 else (i + node.id) % 5
+            val f = pick(run, chain, slot.cardStage, rng) ?: return@mapIndexedNotNull null
+            if (!slot.minion) {
+                val prev = run.seen[chain]
+                val p = if (prev != null && prev != f.unitKey) units(run.cards[run.area]).firstOrNull { it.unitKey == prev } else null
+                if (p != null && p.stage < f.stage) messages += "${tactics.name(p)} digivolved into ${tactics.name(f)}!"
+                run.seen[chain] = f.unitKey
+            }
+            val skills = Growth.skillPool(tactics.field(f), run.area, emptyList()).filter { !it.generic }
+                .shuffled(rng).take(EnemyPlan.skillCount(run.area, type))
+            val spec = tactics.spec(fixStats(f), skills, slot.scale, slot.scale * slot.atkExtra)
+                .copy(key = -(i + 1).toLong(), name = tactics.name(f) + if (slot.boss) " (Boss)" else "")
+            f to spec
+        }
+        return Lineup(out, messages)
+    }
+
+    suspend fun party(run: RunState): List<Pair<TacticsDtos.Fighter, FighterSpec>> {
+        val gear = loadGear()
+        val ups = loadUpgrades()
+        return run.members.mapNotNull { m ->
+            val f = tactics.stored(m.key) ?: return@mapNotNull null
+            val eq = gear[m.key]
+            f to tactics.spec(f, m.skills.mapNotNull { Skills.byName(it) }).copy(
+                startHp = maxOf(0.01, m.hp),
+                skillLevels = m.levels.toMap(),
+                mods = run.mods(m, eq, ups.levels[m.key].orEmpty()),
+                crest = eq?.crest?.crest
+            )
+        }
+    }
+
+    /** Befriended Digimon, strengthened to match your party so their assist always matters. */
+    suspend fun assists(run: RunState): List<FighterSpec> {
+        val stage = partyStage(run)
+        val pool = run.cards.distinct().flatMap { units(it) }
+        return run.friends.mapIndexedNotNull { i, id ->
+            val f = pool.firstOrNull { it.unitKey == id } ?: return@mapIndexedNotNull null
+            val scale = stage.tier / Stage.fromCard(f.stage).tier
+            tactics.spec(fixStats(f), emptyList(), scale, scale).copy(key = -(100 + i).toLong())
+        }
+    }
+
+    /** A wild Digimon for a Befriend stop, at the stage enemies are at right now. */
+    suspend fun wild(run: RunState, node: MapNode): TacticsDtos.Fighter? {
+        val stage = EnemyPlan.mainStage(run.area, node.row, NodeType.BATTLE)
+        return pick(run, Random(run.seed + node.id).nextInt(5), stage, Random(run.seed + node.id * 3L))
+    }
+
+    suspend fun friend(run: RunState, id: Long): TacticsDtos.Fighter? =
+        run.cards.distinct().flatMap { units(it) }.firstOrNull { it.unitKey == id }
+
+    // ------------------------------------------------------------------ rewards home
+
+    /** Battle won: +1 win and −30 min timer for each Digimon; boss: +1 trophy and another −60 min. */
+    suspend fun rewardWin(run: RunState, type: NodeType) = withContext(Dispatchers.IO) {
+        val minutes = 30 + if (type == NodeType.BOSS) 60 else 0
+        for (m in run.members) {
+            try {
+                dao.addWin(m.key)
+                dao.cutTimer(m.key, minutes)
+                if (type == NodeType.BOSS) dao.addTrophy(m.key)
+            } catch (e: Exception) {
+                DebugLog.e(TAG, "Could not send a reward home to Digimon ${m.key}", e)
+            }
+        }
+        run.rewardWins++
+        run.rewardMinutes += minutes
+    }
+
+    private suspend fun rewardClear(run: RunState) = withContext(Dispatchers.IO) {
+        for (m in run.members) try { dao.cutTimer(m.key, 120) } catch (e: Exception) { DebugLog.e(TAG, "Clear reward failed", e) }
+        run.rewardMinutes += 120
+    }
+
+    // ------------------------------------------------------------------ saving
+
+    suspend fun save(run: RunState) = withContext(Dispatchers.IO) {
+        if (run.cleared && !run.clearPaid) { run.clearPaid = true; rewardClear(run) }
+        if (run.bitsEarned > run.bitsPaid) {
+            addBits(run.bitsEarned - run.bitsPaid); run.bitsPaid = run.bitsEarned
+        }
+        try { runFile.writeText(runToJson(run).toString()) } catch (e: Exception) { DebugLog.e(TAG, "Could not save the run", e) }
+    }
+
+    suspend fun load(): RunState? = withContext(Dispatchers.IO) {
+        if (!runFile.exists()) return@withContext null
+        try { runFromJson(JSONObject(runFile.readText())) } catch (e: Exception) {
+            DebugLog.e(TAG, "Saved run was unreadable; starting fresh", e); null
+        }
+    }
+
+    fun deleteRun() { runFile.delete() }
+
+    private fun runToJson(r: RunState) = JSONObject().apply {
+        put("v", 1)
+        put("seed", r.seed)
+        put("cards", JSONArray(r.cards))
+        put("members", JSONArray(r.members.map { m ->
+            JSONObject().put("key", m.key).put("hp", m.hp).put("skills", JSONArray(m.skills))
+                .put("levels", JSONObject(m.levels.mapValues { it.value } as Map<*, *>))
+                .put("boosts", JSONObject(m.boosts.mapValues { it.value } as Map<*, *>))
+        }))
+        put("area", r.area); put("node", r.node); put("nodeType", r.nodeType?.name ?: "")
+        put("pending", r.pending.name); put("xp", r.xp); put("level", r.level)
+        put("picks", JSONArray(r.picks)); put("counter", r.counter); put("coins", r.coins)
+        put("chips", JSONArray(r.chips)); put("friends", JSONArray(r.friends)); put("badLuck", r.badLuck)
+        r.gearDrop?.let { put("gearDrop", gearToJson(it)) }
+        put("bought", JSONArray(r.bought.toList())); put("stopUsed", r.stopUsed)
+        put("lineages", JSONObject().apply { r.lineages.forEach { (a, cs) -> put(a.toString(), JSONArray(cs.map { JSONArray(it) })) } })
+        put("seen", JSONObject().apply { r.seen.forEach { (k, v) -> put(k.toString(), v) } })
+        put("battlesWon", r.battlesWon); put("bossesBeaten", r.bossesBeaten)
+        put("bitsEarned", r.bitsEarned); put("bitsPaid", r.bitsPaid); put("clearPaid", r.clearPaid)
+        put("rewardWins", r.rewardWins); put("rewardMinutes", r.rewardMinutes); put("gearFromStop", r.gearFromStop)
+        put("visited", JSONArray(r.visited)); put("over", r.over); put("cleared", r.cleared)
+        put("log", JSONArray(r.log))
+    }
+
+    private fun longs(a: JSONArray?) = if (a == null) emptyList() else (0 until a.length()).map { a.getLong(it) }
+    private fun ints(a: JSONArray?) = if (a == null) emptyList() else (0 until a.length()).map { a.getInt(it) }
+    private fun strings(a: JSONArray?) = if (a == null) emptyList() else (0 until a.length()).map { a.getString(it) }
+
+    private fun runFromJson(o: JSONObject): RunState {
+        val ma = o.getJSONArray("members")
+        val members = (0 until ma.length()).map { i ->
+            val m = ma.getJSONObject(i)
+            val lv = m.optJSONObject("levels") ?: JSONObject()
+            val bo = m.optJSONObject("boosts") ?: JSONObject()
+            Member(
+                m.getLong("key"), m.getDouble("hp"), strings(m.optJSONArray("skills")).toMutableList(),
+                lv.keys().asSequence().associateWith { lv.getInt(it) }.toMutableMap(),
+                bo.keys().asSequence().associateWith { bo.getDouble(it) }.toMutableMap()
+            )
+        }
+        val r = RunState(o.getLong("seed"), longs(o.getJSONArray("cards")), members)
+        r.area = o.optInt("area"); r.node = o.optInt("node", -1)
+        r.nodeType = o.optString("nodeType").takeIf { it.isNotEmpty() }?.let { NodeType.valueOf(it) }
+        r.pending = Pending.valueOf(o.optString("pending", "NONE"))
+        r.xp = o.optInt("xp"); r.level = o.optInt("level", 1)
+        r.picks += longs(o.optJSONArray("picks")); r.counter = o.optInt("counter"); r.coins = o.optInt("coins")
+        r.chips += strings(o.optJSONArray("chips")); r.friends += longs(o.optJSONArray("friends")); r.badLuck = o.optInt("badLuck")
+        r.gearDrop = o.optJSONObject("gearDrop")?.let { gearFromJson(it) }
+        r.bought += ints(o.optJSONArray("bought")); r.stopUsed = o.optBoolean("stopUsed")
+        o.optJSONObject("lineages")?.let { l ->
+            l.keys().forEach { k ->
+                val arr = l.getJSONArray(k)
+                r.lineages[k.toInt()] = (0 until arr.length()).map { longs(arr.getJSONArray(it)) }
+            }
+        }
+        o.optJSONObject("seen")?.let { s -> s.keys().forEach { k -> r.seen[k.toInt()] = s.getLong(k) } }
+        r.battlesWon = o.optInt("battlesWon"); r.bossesBeaten = o.optInt("bossesBeaten")
+        r.bitsEarned = o.optInt("bitsEarned"); r.bitsPaid = o.optInt("bitsPaid"); r.clearPaid = o.optBoolean("clearPaid")
+        r.rewardWins = o.optInt("rewardWins"); r.rewardMinutes = o.optInt("rewardMinutes"); r.gearFromStop = o.optBoolean("gearFromStop")
+        r.visited += ints(o.optJSONArray("visited")); r.over = o.optBoolean("over"); r.cleared = o.optBoolean("cleared")
+        r.log += strings(o.optJSONArray("log"))
+        return r
+    }
+
+    // ------------------------------------------------------------------ gear (kept between runs)
+
+    private fun gearToJson(g: Gear) = JSONObject().put("id", g.id).put("slot", g.slot.name).put("rarity", g.rarity.name)
+        .put("crest", g.crest?.name ?: "")
+        .put("lines", JSONArray(g.lines.map { JSONObject().put("stat", it.stat).put("value", it.value) }))
+
+    private fun gearFromJson(o: JSONObject): Gear {
+        val la = o.optJSONArray("lines") ?: JSONArray()
+        return Gear(
+            o.getLong("id"), GearSlot.valueOf(o.getString("slot")), Rarity.valueOf(o.getString("rarity")),
+            (0 until la.length()).map { la.getJSONObject(it).let { l -> GearLine(l.getString("stat"), l.getDouble("value")) } },
+            o.optString("crest").takeIf { it.isNotEmpty() }?.let { Crest.valueOf(it) }
+        )
+    }
+
+    fun loadGear(): Map<Long, Equipped> = try {
+        if (!gearFile.exists()) emptyMap() else {
+            val o = JSONObject(gearFile.readText())
+            o.keys().asSequence().associate { k ->
+                val e = o.getJSONObject(k)
+                k.toLong() to Equipped(e.optJSONObject("plugin")?.let { gearFromJson(it) }, e.optJSONObject("crest")?.let { gearFromJson(it) })
+            }
+        }
+    } catch (e: Exception) { DebugLog.e(TAG, "Gear file unreadable", e); emptyMap() }
+
+    /** Equips [g] on Digimon [key] and returns what it replaced. */
+    fun equip(key: Long, g: Gear): Gear? {
+        val all = loadGear().toMutableMap()
+        val cur = all[key] ?: Equipped()
+        val old = if (g.slot == GearSlot.CREST) cur.crest else cur.plugin
+        all[key] = if (g.slot == GearSlot.CREST) cur.copy(crest = g) else cur.copy(plugin = g)
+        val o = JSONObject()
+        all.forEach { (k, e) ->
+            o.put(k.toString(), JSONObject().apply {
+                e.plugin?.let { put("plugin", gearToJson(it)) }
+                e.crest?.let { put("crest", gearToJson(it)) }
+            })
+        }
+        gearFile.writeText(o.toString())
+        return old
+    }
+
+    // ------------------------------------------------------------------ Bits upgrades (shared pool)
+
+    data class UpgradeState(val bits: Int, val levels: Map<Long, Map<String, Int>>)
+
+    fun loadUpgrades(): UpgradeState = try {
+        if (!upgradeFile.exists()) UpgradeState(0, emptyMap()) else {
+            val o = JSONObject(upgradeFile.readText())
+            val l = o.optJSONObject("levels") ?: JSONObject()
+            UpgradeState(o.optInt("bits"), l.keys().asSequence().associate { k ->
+                val s = l.getJSONObject(k)
+                k.toLong() to s.keys().asSequence().associateWith { s.getInt(it) }
+            })
+        }
+    } catch (e: Exception) { DebugLog.e(TAG, "Upgrades file unreadable", e); UpgradeState(0, emptyMap()) }
+
+    private fun saveUpgrades(u: UpgradeState) {
+        val l = JSONObject()
+        u.levels.forEach { (k, m) -> l.put(k.toString(), JSONObject(m as Map<*, *>)) }
+        upgradeFile.writeText(JSONObject().put("bits", u.bits).put("levels", l).toString())
+    }
+
+    private fun addBits(n: Int) {
+        val u = loadUpgrades(); saveUpgrades(u.copy(bits = u.bits + n))
+    }
+
+    /** Buys one level of [stat] for Digimon [key]. Returns false if it can't. */
+    fun buyUpgrade(key: Long, stat: String): Boolean {
+        val u = loadUpgrades()
+        val lv = u.levels[key]?.get(stat) ?: 0
+        val cost = Upgrades.cost(lv)
+        if (lv >= Upgrades.MAX || u.bits < cost) return false
+        val mine = (u.levels[key] ?: emptyMap()).toMutableMap().apply { put(stat, lv + 1) }
+        saveUpgrades(UpgradeState(u.bits - cost, u.levels + (key to mine)))
+        return true
+    }
+}
