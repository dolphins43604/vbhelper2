+package com.github.nacabaro.vbhelper.dtos
+
+import com.github.cfogrady.vbnfc.data.NfcCharacter
+
+object OfflineBattleDtos {
+    data class MyFighter(
+        val userCharacterId: Long,
+        val vitalPoints: Int,
+        val mood: Int,
+        val injuryStatus: NfcCharacter.InjuryStatus,
+        val phaseWins: Int,
+        val phaseLosses: Int,
+        val totalWins: Int,
+        val totalLosses: Int,
+        val stage: Int,
+        val baseHp: Int,
+        val baseAp: Int,
+        val baseBp: Int,
+        val isBem: Boolean,
+        val trainingHp: Int,
+        val trainingAp: Int,
+        val trainingBp: Int,
+        val idle1: ByteArray,
+        val idle2: ByteArray,
+        val attack: ByteArray,
+        val dodge: ByteArray,
+        val width: Int,
+        val height: Int
+    ) {
+        override fun equals(other: Any?) = other is MyFighter && other.userCharacterId == userCharacterId
+        override fun hashCode() = userCharacterId.hashCode()
+    }
+
+    data class CpuFighter(
+        val id: Long,
+        val cardName: String,
+        val stage: Int,
+        val hp: Int,
+        val ap: Int,
+        val bp: Int,
+        val idle1: ByteArray,
+        val idle2: ByteArray,
+        val attack: ByteArray,
+        val dodge: ByteArray,
+        val width: Int,
+        val height: Int
+    ) {
+        override fun equals(other: Any?) = other is CpuFighter && other.id == id && other.hp == hp
+        override fun hashCode() = 31 * id.hashCode() + hp
+    }
+}
