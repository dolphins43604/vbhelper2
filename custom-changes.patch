+private class FightSetup(val battle: TacticsBattle, val frames: Map<Long, Frames>, val background: Background?, val type: NodeType)
+
+/**
+ * Phase 4: the roguelike run. Your 3 Digimon cross 3 areas (one imported card each) on a branching map.
+ * Enemies start as baby forms and evolve as you go; the run saves after every step.
+ */
+@Composable
+fun RogueScreen(navController: NavController, characterId: Long) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val repo = remember { RunRepository(application, application.container.db) }
+    val scope = rememberCoroutineScope()
+    var run by remember { mutableStateOf<RunState?>(null) }
+    var loaded by remember { mutableStateOf(false) }
+    var version by remember { mutableIntStateOf(0) }
+    var fight by remember { mutableStateOf<FightSetup?>(null) }
+    var upgrades by remember { mutableStateOf(false) }
+    val party = remember { mutableStateMapOf<Long, TacticsDtos.Fighter>() }
+    val cardNames = remember { mutableStateMapOf<Long, String>() }
+
+    LaunchedEffect(Unit) {
+        run = repo.load()
+        repo.tactics.cards().forEach { cardNames[it.id] = it.name }
+        loaded = true
+    }
+    LaunchedEffect(run?.seed) {
+        run?.members?.forEach { m -> repo.tactics.stored(m.key)?.let { party[m.key] = it } }
+    }
+
+    /** Saves after every change and redraws. */
+    fun commit() {
+        version++
+        val r = run ?: return
+        scope.launch { repo.save(r); version++ }
+    }
+
+    Scaffold(
+        topBar = {
+            TopBanner(
+                text = "Roguelike run",
+                onBackClick = {
+                    when {
+                        fight != null -> fight = null       // leaving a fight restarts it next time
+                        upgrades -> upgrades = false
+                        else -> navController.popBackStack()
+                    }
+                }
+            )
+        }
+    ) { padding ->
+        Box(
+            Modifier
+                .fillMaxSize()
+                .padding(top = padding.calculateTopPadding())
+                .padding(horizontal = 12.dp)
+        ) {
+            @Suppress("UNUSED_VARIABLE") val v = version
+            val r = run
+            val f = fight
+            if (!loaded) {
+                Text("Loading…", modifier = Modifier.padding(16.dp))
+            } else if (upgrades) {
+                UpgradesPanel(repo, onClose = { upgrades = false })
+            } else if (r == null) {
+                RunSetup(repo, characterId, onUpgrades = { upgrades = true }) { partyIds, cards ->
+                    scope.launch {
+                        run = repo.newRun(partyIds, cards)
+                        version++
+                    }
+                }
+            } else if (f != null) {
+                TacticsFight(f.battle, f.frames, f.background, onDone = { fight = null }, onFinish = { won ->
+                    val type = f.type
+                    if (won) {
+                        val left = f.battle.fighters.filter { it.side == TacticsBattle.PLAYER }
+                            .map { if (it.alive) it.hp / it.maxHp else 0.0 }
+                        r.winFight(left) { luck -> GearRoll.roll(r.rng(), luck) }
+                        if (r.pending == Pending.NONE) r.finishStop()
+                        scope.launch { repo.rewardWin(r, type); repo.save(r); version++ }
+                    } else r.loseFight()
+                    fight = null
+                    commit()
+                })
+            } else {
+                RunHub(r, repo, party, cardNames, version, { commit() },
+                    onUpgrades = { upgrades = true },
+                    onFight = { setup -> fight = setup },
+                    onFinished = {
+                        repo.deleteRun(); run = null; party.clear(); version++
+                    })
+            }
+        }
+    }
+}
