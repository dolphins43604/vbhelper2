+/**
+ * Shows every Jogress this Digimon's card allows, which of your stored
+ * Digimon can be the partner, and performs it.
+ */
+@Composable
+fun JogressScreen(
+    navController: NavController,
+    characterId: Long
+) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val db = application.container.db
+    val forge = remember { CharacterForgeRepository(db) }
+    val storage = remember { StorageRepository(db) }
+    val scope = rememberCoroutineScope()
+
+    var base by remember { mutableStateOf<CharacterDtos.CharacterWithSprites?>(null) }
+    var options by remember { mutableStateOf<List<ToolsDtos.JogressOption>>(emptyList()) }
+    var everyone by remember { mutableStateOf<List<CharacterDtos.CharacterWithSprites>>(emptyList()) }
+    var loaded by remember { mutableStateOf(false) }
+    var pending by remember { mutableStateOf<Pair<ToolsDtos.JogressOption, CharacterDtos.CharacterWithSprites>?>(null) }
+
+    LaunchedEffect(characterId) {
+        val b = storage.getSingleCharacter(characterId)
+        base = b
+        options = forge.jogressOptions(b.charId)
+        everyone = storage.getAllCharacters().first()
+        loaded = true
+    }
+
+    Scaffold(
+        topBar = {
+            TopBanner(
+                text = stringResource(R.string.jogress_title),
+                onBackClick = { navController.popBackStack() }
+            )
+        }
+    ) { contentPadding ->
+        LazyColumn(
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(top = contentPadding.calculateTopPadding())
+                .padding(horizontal = 16.dp)
+        ) {
+            val b = base
+            if (!loaded || b == null) {
+                item { Text(stringResource(R.string.forge_loading), Modifier.padding(24.dp)) }
+                return@LazyColumn
+            }
+            if (options.isEmpty()) {
+                item {
+                    Text(
+                        text = stringResource(R.string.jogress_none),
+                        modifier = Modifier.padding(vertical = 24.dp)
+                    )
+                }
+                return@LazyColumn
+            }
+
+            item {
+                Text(
+                    text = stringResource(R.string.jogress_intro),
+                    style = MaterialTheme.typography.bodyMedium,
+                    modifier = Modifier.padding(top = 8.dp)
+                )
+            }
+
+            items(options) { option ->
+                val partners = everyone.filter {
+                    it.id != b.id && !it.isInAdventure && it.attribute == option.partnerAttribute
+                }
+                Card(
+                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainerHigh),
+                    modifier = Modifier.fillMaxWidth()
+                ) {
+                    Column(Modifier.padding(12.dp)) {
+                        Row(verticalAlignment = Alignment.CenterVertically) {
+                            CharacterEntry(
+                                icon = BitmapData(option.spriteIdle, option.spriteWidth, option.spriteHeight),
+                                multiplier = 3,
+                                modifier = Modifier.width(96.dp)
+                            )
+                            Spacer(Modifier.width(12.dp))
+                            Column {
+                                Text(
+                                    text = stringResource(R.string.jogress_result, option.charaIndex, option.stage),
+                                    style = MaterialTheme.typography.titleMedium
+                                )
+                                Text(
+                                    text = stringResource(R.string.jogress_needs, option.partnerAttribute.name),
+                                    style = MaterialTheme.typography.bodySmall
+                                )
+                            }
+                        }
+                        if (partners.isEmpty()) {
+                            Text(
+                                text = stringResource(R.string.jogress_no_partner, option.partnerAttribute.name),
+                                style = MaterialTheme.typography.bodySmall,
+                                color = MaterialTheme.colorScheme.outline,
+                                modifier = Modifier.padding(top = 8.dp)
+                            )
+                        } else {
+                            Text(
+                                text = stringResource(R.string.jogress_pick_partner),
+                                style = MaterialTheme.typography.labelLarge,
+                                modifier = Modifier.padding(top = 8.dp, bottom = 4.dp)
+                            )
+                            partners.chunked(4).forEach { row ->
+                                Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                                    row.forEach { partner ->
+                                        CharacterEntry(
+                                            icon = BitmapData(partner.spriteIdle, partner.spriteWidth, partner.spriteHeight),
+                                            multiplier = 2,
+                                            onClick = { pending = option to partner },
+                                            modifier = Modifier.weight(1f)
+                                        )
+                                    }
+                                    repeat(4 - row.size) { Spacer(Modifier.weight(1f)) }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    pending?.let { (option, _) ->
+        AlertDialog(
+            onDismissRequest = { pending = null },
+            title = { Text(stringResource(R.string.jogress_title)) },
+            text = { Text(stringResource(R.string.jogress_confirm_text)) },
+            confirmButton = {
+                TextButton(onClick = {
+                    pending = null
+                    scope.launch {
+                        forge.jogress(characterId, option)
+                        Toast.makeText(application, application.getString(R.string.jogress_done), Toast.LENGTH_SHORT).show()
+                        navController.popBackStack()
+                    }
+                }) { Text(stringResource(R.string.jogress_go)) }
+            },
+            dismissButton = {
+                TextButton(onClick = { pending = null }) { Text(stringResource(R.string.merge_cancel)) }
+            }
+        )
+    }
+}
