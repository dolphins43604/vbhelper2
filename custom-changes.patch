+package com.github.nacabaro.vbhelper.source
+
+import com.github.cfogrady.vbnfc.data.NfcCharacter
+import com.github.cfogrady.vbnfc.vb.SpecialMission
+import com.github.nacabaro.vbhelper.database.AppDatabase
+import com.github.nacabaro.vbhelper.domain.card.Card
+import com.github.nacabaro.vbhelper.domain.device_data.BECharacterData
+import com.github.nacabaro.vbhelper.domain.device_data.SpecialMissions
+import com.github.nacabaro.vbhelper.domain.device_data.UserCharacter
+import com.github.nacabaro.vbhelper.domain.device_data.VBCharacterData
+import com.github.nacabaro.vbhelper.dtos.ForgeDtos
+import com.github.nacabaro.vbhelper.dtos.ToolsDtos
+import com.github.nacabaro.vbhelper.utils.DebugLog
+import androidx.room.withTransaction
+import com.github.nacabaro.vbhelper.utils.DeviceType
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.firstOrNull
+import kotlinx.coroutines.withContext
+
+/**
+ * Editable stats for a Digimon. Every value is kept inside [ForgeLimits]
+ * before it is written, so the bracelet never receives an out-of-range value.
+ */
+data class ForgeStats(
+    val ageInDays: Int = 0,
+    val mood: Int = 50,
+    val vitalPoints: Int = 0,
+    val transformationCountdown: Int = 0,
+    val injured: Boolean = false,
+    val trophies: Int = 0,
+    val currentPhaseBattlesWon: Int = 0,
+    val currentPhaseBattlesLost: Int = 0,
+    val totalBattlesWon: Int = 0,
+    val totalBattlesLost: Int = 0,
+    // BE only
+    val trainingHp: Int = 0,
+    val trainingAp: Int = 0,
+    val trainingBp: Int = 0,
+    val remainingTrainingTimeInMinutes: Int = 0,
+    val abilityRarity: NfcCharacter.AbilityRarity = NfcCharacter.AbilityRarity.None
+) {
+    fun clamped(): ForgeStats = copy(
+        ageInDays = ageInDays.coerceIn(ForgeLimits.AGE),
+        mood = mood.coerceIn(ForgeLimits.MOOD),
+        vitalPoints = vitalPoints.coerceIn(ForgeLimits.VITALS),
+        transformationCountdown = transformationCountdown.coerceIn(ForgeLimits.TIMER_MINUTES),
+        trophies = trophies.coerceIn(ForgeLimits.TROPHIES),
+        currentPhaseBattlesWon = currentPhaseBattlesWon.coerceIn(ForgeLimits.BATTLES),
+        currentPhaseBattlesLost = currentPhaseBattlesLost.coerceIn(ForgeLimits.BATTLES),
+        totalBattlesWon = totalBattlesWon.coerceIn(ForgeLimits.BATTLES),
+        totalBattlesLost = totalBattlesLost.coerceIn(ForgeLimits.BATTLES),
+        trainingHp = trainingHp.coerceIn(ForgeLimits.BE_TRAINING),
+        trainingAp = trainingAp.coerceIn(ForgeLimits.BE_TRAINING),
+        trainingBp = trainingBp.coerceIn(ForgeLimits.BE_TRAINING),
+        remainingTrainingTimeInMinutes = remainingTrainingTimeInMinutes.coerceIn(ForgeLimits.TIMER_MINUTES)
+    )
+}
+
+object ForgeLimits {
+    val AGE = 0..99
+    val MOOD = 0..100
+    val VITALS = 0..9999
+    val TIMER_MINUTES = 0..9999
+    val TROPHIES = 0..999
+    val BATTLES = 0..999
+    val BE_TRAINING = 0..999
+}
+
+class CharacterForgeRepository(
+    private val db: AppDatabase
+) {
+    suspend fun getCards(): List<Card> = withContext(Dispatchers.IO) {
+        db.cardDao().getAllCards()
+    }
+
+    suspend fun getCharacterOptions(cardId: Long): List<ForgeDtos.CardCharacterOption> =
+        withContext(Dispatchers.IO) {
+            db.characterDao().getCharacterOptionsForCard(cardId)
+        }
+
+    /**
+     * Builds a brand-new Digimon in storage, the same way VBHelper stores a scanned one,
+     * so the existing "Send to watch" flow can transfer it.
+     * Returns the new character's id.
+     */
+    suspend fun createCharacter(
+        card: Card,
+        option: ForgeDtos.CardCharacterOption,
+        deviceType: DeviceType,
+        stats: ForgeStats
+    ): Long = withContext(Dispatchers.IO) {
+        val s = stats.clamped()
+        val dao = db.userCharacterDao()
+
+        val characterId = dao.insertCharacterData(
+            UserCharacter(
+                charId = option.id,
+                ageInDays = s.ageInDays,
+                mood = s.mood,
+                vitalPoints = s.vitalPoints,
+                transformationCountdown = s.transformationCountdown,
+                injuryStatus = if (s.injured) NfcCharacter.InjuryStatus.Injury
+                               else NfcCharacter.InjuryStatus.None,
+                trophies = s.trophies,
+                currentPhaseBattlesWon = s.currentPhaseBattlesWon,
+                currentPhaseBattlesLost = s.currentPhaseBattlesLost,
+                totalBattlesWon = s.totalBattlesWon,
+                totalBattlesLost = s.totalBattlesLost,
+                activityLevel = 0,
+                heartRateCurrent = 0,
+                characterType = deviceType,
+                isActive = false
+            )
+        )
+
+        if (deviceType == DeviceType.BEDevice) {
+            dao.insertBECharacterData(
+                BECharacterData(
+                    id = characterId,
+                    trainingHp = s.trainingHp,
+                    trainingAp = s.trainingAp,
+                    trainingBp = s.trainingBp,
+                    remainingTrainingTimeInMinutes = s.remainingTrainingTimeInMinutes,
+                    itemEffectMentalStateValue = 0,
+                    itemEffectMentalStateMinutesRemaining = 0,
+                    itemEffectActivityLevelValue = 0,
+                    itemEffectActivityLevelMinutesRemaining = 0,
+                    itemEffectVitalPointsChangeValue = 0,
+                    itemEffectVitalPointsChangeMinutesRemaining = 0,
+                    abilityRarity = s.abilityRarity,
+                    abilityType = 0,
+                    abilityBranch = 0,
+                    abilityReset = 0,
+                    rank = 0,
+                    itemType = 0,
+                    itemMultiplier = 0,
+                    itemRemainingTime = 0,
+                    otp0 = "",
+                    otp1 = "",
+                    // Same defaults VBHelper uses for Digimon imported from VitalWear
+                    minorVersion = 0,
+                    majorVersion = 0
+                )
+            )
+        } else {
+            dao.insertVBCharacterData(
+                VBCharacterData(
+                    id = characterId,
+                    generation = 1,
+                    totalTrophies = s.trophies
+                )
+            )
+            // A real Vital Bracelet always reports four mission slots; store four empty ones.
+            val emptyMissions = Array(4) {
+                SpecialMissions(
+                    characterId = characterId,
+                    goal = 0,
+                    watchId = 0,
+                    progress = 0,
+                    status = SpecialMission.Status.UNAVAILABLE,
+                    timeElapsedInMinutes = 0,
+                    timeLimitInMinutes = 0,
+                    missionType = SpecialMission.Type.NONE
+                )
+            }
+            dao.insertSpecialMissions(*emptyMissions)
+        }
+
+        val now = System.currentTimeMillis()
+        dao.insertTransformation(characterId, option.charaIndex, card.id, now)
+        db.dexDao().insertCharacter(option.charaIndex, card.id, now)
+
+        characterId
+    }
+
+    /** Jogress results this stored Digimon's card defines for it. */
+    suspend fun jogressOptions(cardCharacterId: Long): List<ToolsDtos.JogressOption> =
+        withContext(Dispatchers.IO) { db.toolsDao().getJogressOptions(cardCharacterId) }
+
+    /**
+     * Jogress: the Digimon becomes [option]'s result, the same way the bracelet
+     * evolves it. The partner only lends its attribute and is left unchanged.
+     * Current-stage battles reset like a normal evolution; totals are kept.
+     */
+    suspend fun jogress(userCharacterId: Long, option: ToolsDtos.JogressOption) = withContext(Dispatchers.IO) {
+        val now = System.currentTimeMillis()
+        db.withTransaction {
+            db.toolsDao().transformStoredDigimon(userCharacterId, option.toCharaId)
+            db.userCharacterDao().insertTransformation(userCharacterId, option.charaIndex, option.cardId, now)
+            db.dexDao().insertCharacter(option.charaIndex, option.cardId, now)
+        }
+        DebugLog.i("Jogress", "Digimon $userCharacterId became card ${option.cardId} slot ${option.charaIndex}")
+    }
+
+    suspend fun loadStats(characterId: Long): Pair<DeviceType, ForgeStats> = withContext(Dispatchers.IO) {
+        val dao = db.userCharacterDao()
+        val c = dao.getCharacter(characterId)
+        val be = if (c.characterType == DeviceType.BEDevice) dao.getBeData(characterId).firstOrNull() else null
+
+        c.characterType to ForgeStats(
+            ageInDays = c.ageInDays,
+            mood = c.mood,
+            vitalPoints = c.vitalPoints,
+            transformationCountdown = c.transformationCountdown,
+            injured = c.injuryStatus != NfcCharacter.InjuryStatus.None,
+            trophies = c.trophies,
+            currentPhaseBattlesWon = c.currentPhaseBattlesWon,
+            currentPhaseBattlesLost = c.currentPhaseBattlesLost,
+            totalBattlesWon = c.totalBattlesWon,
+            totalBattlesLost = c.totalBattlesLost,
+            trainingHp = be?.trainingHp ?: 0,
+            trainingAp = be?.trainingAp ?: 0,
+            trainingBp = be?.trainingBp ?: 0,
+            remainingTrainingTimeInMinutes = be?.remainingTrainingTimeInMinutes ?: 0,
+            abilityRarity = be?.abilityRarity ?: NfcCharacter.AbilityRarity.None
+        )
+    }
+
+    suspend fun saveStats(characterId: Long, stats: ForgeStats) = withContext(Dispatchers.IO) {
+        val s = stats.clamped()
+        val dao = db.userCharacterDao()
+        val c = dao.getCharacter(characterId)
+
+        val injury = when {
+            !s.injured -> NfcCharacter.InjuryStatus.None
+            c.injuryStatus != NfcCharacter.InjuryStatus.None -> c.injuryStatus
+            else -> NfcCharacter.InjuryStatus.Injury
+        }
+
+        dao.updateCharacter(
+            c.copy(
+                ageInDays = s.ageInDays,
+                mood = s.mood,
+                vitalPoints = s.vitalPoints,
+                transformationCountdown = s.transformationCountdown,
+                injuryStatus = injury,
+                trophies = s.trophies,
+                currentPhaseBattlesWon = s.currentPhaseBattlesWon,
+                currentPhaseBattlesLost = s.currentPhaseBattlesLost,
+                totalBattlesWon = s.totalBattlesWon,
+                totalBattlesLost = s.totalBattlesLost
+            )
+        )
+
+        if (c.characterType == DeviceType.BEDevice) {
+            val be = dao.getBeData(characterId).firstOrNull()
+            if (be != null) {
+                dao.updateBECharacterData(
+                    be.copy(
+                        trainingHp = s.trainingHp,
+                        trainingAp = s.trainingAp,
+                        trainingBp = s.trainingBp,
+                        remainingTrainingTimeInMinutes = s.remainingTrainingTimeInMinutes,
+                        abilityRarity = s.abilityRarity
+                    )
+                )
+            }
+        }
+    }
+}
