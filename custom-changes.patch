+    fun byName(name: String): Skill? = POOL.firstOrNull { it.name == name }
+
+    /** Skills a Digimon can learn: its Field's pool, or every skill when it has no Field. */
+    fun poolFor(field: Field?): List<Skill> =
+        if (field == null) POOL else POOL.filter { it.field == field } + POOL.filter { it.generic }
+
+    fun fieldPassive(field: Field?): String = when (field) {
+        Field.DR -> "Rage: up to +50% damage as HP drops"
+        Field.NSP -> "Pack Hunt: +25% damage per ally within 2 of the target; +10% HP"
+        Field.DS -> "Tide: heals 2% each turn; +15% vs Slowed"
+        Field.WG -> "Tailwind: +1 move, +1 range on ranged skills, +8 EVA"
+        Field.ME -> "Overclock: starts with a Shield; +2% damage each turn"
+        Field.NSO -> "Drain: heals 15% of damage; attacks may Curse"
+        Field.VB -> "Purify: heals the weakest ally a little each turn; +10% vs Virus"
+        Field.JT -> "Swarm: attacks Poison; +15% vs Poisoned"
+        null -> "No Field passive"
+    } + " (stronger at higher stages)"
+
+    fun attrTrait(attr: Attr): String = when (attr) {
+        Attr.VACCINE -> "Firewall: starts with an 8% Shield"
+        Attr.VIRUS -> "Corrupt: ignores 20% of DEF"
+        Attr.DATA -> "Analyze: +5 hit and +5% damage per repeat hit"
+        Attr.FREE -> "Adapt: first attack counts as advantaged"
+    }
+}
