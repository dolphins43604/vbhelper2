+                            val on = s.name in chosen
+                            FilterChip(
+                                selected = on,
+                                onClick = {
+                                    picks[id] = if (on) chosen - s.name else if (chosen.size < 2) chosen + s.name else chosen
+                                },
+                                label = {
+                                    Column(Modifier.padding(vertical = 4.dp)) {
+                                        Text("${s.name} · ${skillCostText(s)}", fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                                        Text(s.description, fontSize = 12.sp)
+                                    }
+                                },
+                                modifier = Modifier.fillMaxWidth()
+                            )
+                        }
+                    }
+                }
+            }
+        }
