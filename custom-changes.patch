--- /dev/null
+++ b/app/src/main/java/com/github/nacabaro/vbhelper/utils/DebugLog.kt
@@ -0,0 +1,82 @@
+package com.github.nacabaro.vbhelper.utils
+
+import android.content.Context
+import android.util.Log
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * A small in-app log for debugging bracelet transfers.
+ *
+ * Lines are kept in memory (shown live on the transfer screens) and appended
+ * to debug-log.txt in the app's private files, so they survive a crash or restart
+ * and can be shared from Settings > Debug log.
+ */
+object DebugLog {
+    private const val MAX_LINES = 500
+    private const val MAX_FILE_BYTES = 512 * 1024L
+    private const val FILE_NAME = "debug-log.txt"
+
+    private val time = SimpleDateFormat("HH:mm:ss.SSS", Locale.US)
+    private val _lines = MutableStateFlow<List<String>>(emptyList())
+    val lines: StateFlow<List<String>> = _lines.asStateFlow()
+
+    @Volatile
+    private var file: File? = null
+
+    fun init(context: Context) {
+        if (file != null) return
+        val f = File(context.applicationContext.filesDir, FILE_NAME)
+        file = f
+        // Show the tail of the previous session too, so a crash can still be inspected.
+        runCatching {
+            if (f.exists()) {
+                _lines.value = f.readLines().takeLast(MAX_LINES)
+            }
+        }
+    }
+
+    fun i(tag: String, message: String) = add("I", tag, message, null)
+    fun w(tag: String, message: String) = add("W", tag, message, null)
+    fun e(tag: String, message: String, error: Throwable? = null) = add("E", tag, message, error)
+
+    fun clear() {
+        _lines.value = emptyList()
+        runCatching { file?.writeText("") }
+    }
+
+    fun asText(): String = _lines.value.joinToString("\n")
+
+    @Synchronized
+    private fun add(level: String, tag: String, message: String, error: Throwable?) {
+        when (level) {
+            "E" -> Log.e(tag, message, error)
+            "W" -> Log.w(tag, message)
+            else -> Log.i(tag, message)
+        }
+
+        val stamp = time.format(Date())
+        val newLines = mutableListOf("$stamp $level/$tag: $message")
+        if (error != null) {
+            newLines += "    ${error.javaClass.simpleName}: ${error.message}"
+            error.stackTrace.take(6).forEach { newLines += "      at $it" }
+            error.cause?.let { newLines += "    caused by ${it.javaClass.simpleName}: ${it.message}" }
+        }
+
+        _lines.value = (_lines.value + newLines).takeLast(MAX_LINES)
+
+        runCatching {
+            val f = file ?: return
+            if (f.exists() && f.length() > MAX_FILE_BYTES) {
+                f.writeText(_lines.value.joinToString("\n", postfix = "\n"))
+            } else {
+                f.appendText(newLines.joinToString("\n", postfix = "\n"))
+            }
+        }
+    }
+}
