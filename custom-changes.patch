+@Composable
+@NonSkippableComposable
+private fun RunHub(
+    run: RunState,
+    repo: RunRepository,
+    party: Map<Long, TacticsDtos.Fighter>,
+    cardNames: Map<Long, String>,
+    version: Int,
+    commit: () -> Unit,
+    onUpgrades: () -> Unit,
+    onFight: (FightSetup) -> Unit,
+    onFinished: () -> Unit
+) {
+    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+        Spacer(Modifier.height(4.dp))
+        if (run.over) {
+            RunOver(run, version, onFinished)
+            return@Column
+        }
+        Text("Area ${run.area + 1} of 3 · ${cardNames[run.cards[run.area]] ?: "Card"}", style = MaterialTheme.typography.titleMedium)
+        PartyPanel(run, repo, party, version)
+        when (run.pending) {
+            Pending.START_SKILLS -> StartSkills(run, repo, party, version, commit)
+            Pending.LEVEL_UP -> LevelUp(run, repo, party, version, commit)
+            Pending.GEAR -> GearPanel(run, repo, party, version, commit)
+            Pending.FIGHT -> FightIntro(run, repo, party, version, onFight)
+            Pending.STOP -> StopPanel(run, repo, party, version, commit)
+            Pending.REWARD, Pending.NONE -> {
+                Text("Choose your next stop", style = MaterialTheme.typography.labelLarge)
+                MapView(run, version) { n -> run.enter(n); commit() }
+                LegendText()
+            }
+        }
+        if (run.log.isNotEmpty()) {
+            Text("Log", style = MaterialTheme.typography.labelLarge)
+            run.log.take(6).forEach { Text(it, style = MaterialTheme.typography.bodySmall) }
+        }
+        Spacer(Modifier.height(24.dp))
+    }
+}
