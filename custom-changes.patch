+// ------------------------------------------------------------------------------------------ setup
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun Setup(
+    repo: TacticsRepository,
+    leaderId: Long,
+    onStart: (TacticsBattle, Map<Long, Frames>, Background?) -> Unit
+) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val storage = remember { StorageRepository(application.container.db) }
+    val scope = rememberCoroutineScope()
+
+    var everyone by remember { mutableStateOf<List<CharacterDtos.CharacterWithSprites>>(emptyList()) }
+    var cards by remember { mutableStateOf<List<TacticsDtos.CardOption>>(emptyList()) }
+    val party = remember { mutableStateListOf(leaderId) }
+    val loaded = remember { mutableStateMapOf<Long, TacticsDtos.Fighter>() }
+    val picks = remember { mutableStateMapOf<Long, List<String>>() }
+    var cardId by remember { mutableStateOf<Long?>(null) }
+    var area by remember { mutableIntStateOf(0) }
+    var kind by remember { mutableStateOf(TacticsRepository.StopKind.BATTLE) }
+    var error by remember { mutableStateOf<String?>(null) }
+
+    LaunchedEffect(Unit) {
+        everyone = storage.getAllCharacters().first()
+        cards = repo.cards()
+        cardId = cards.firstOrNull { !it.isBem }?.id ?: cards.firstOrNull()?.id
+    }
+    LaunchedEffect(party.toList()) {
+        for (id in party) if (id !in loaded) repo.stored(id)?.let { loaded[id] = it }
+    }
+
+    Column(
+        Modifier
+            .fillMaxSize()
+            .verticalScroll(rememberScrollState()),
+        verticalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+        Text("Your team (${party.size}/3)", style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(top = 8.dp))
+        Text("Tap Digimon to add or remove them. The first one is the Digimon you came from.", style = MaterialTheme.typography.bodySmall)
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            everyone.filter { !it.isInAdventure && it.stage >= 2 }.forEach { c ->
+                val selected = c.id in party
+                FilterChip(
+                    selected = selected,
+                    onClick = {
+                        if (c.id == leaderId) return@FilterChip
+                        if (selected) party.remove(c.id) else if (party.size < 3) party.add(c.id)
+                    },
+                    label = { SpriteImage(c.spriteIdle, c.spriteWidth, c.spriteHeight, Modifier.size(36.dp), flip = true) }
+                )
+            }
+        }
+
+        party.forEach { id ->
+            val f = loaded[id] ?: return@forEach
+            val chosen = picks[id] ?: emptyList()
+            Card(Modifier.fillMaxWidth()) {
+                Column(Modifier.padding(10.dp)) {
+                    Row(verticalAlignment = Alignment.CenterVertically) {
+                        SpriteImage(f.idle1, f.width, f.height, Modifier.size(40.dp), flip = true)
+                        Spacer(Modifier.width(8.dp))
+                        Column {
+                            Text(repo.name(f), fontWeight = FontWeight.SemiBold)
+                            Text(
+                                "${Stage.fromCard(f.stage).label} · ${repo.attr(f.attribute).label} · ${repo.field(f)?.label ?: "No Field"}",
+                                style = MaterialTheme.typography.bodySmall
+                            )
+                        }
+                    }
+                    Text(Skills.fieldPassive(repo.field(f)), style = MaterialTheme.typography.bodySmall)
+                    Text(Skills.attrTrait(repo.attr(f.attribute)), style = MaterialTheme.typography.bodySmall)
+                    Text("Learned skills (${chosen.size}/2):", style = MaterialTheme.typography.labelLarge, modifier = Modifier.padding(top = 6.dp))
+                    Text("Every Digimon also has Attack (free, range 1) and Special Move (3 Energy, range 2, no counter).",
+                        style = MaterialTheme.typography.bodySmall)
+                    Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
+                        Skills.poolFor(repo.field(f)).forEach { s ->
+                            val on = s.name in chosen
+                            FilterChip(
+                                selected = on,
+                                onClick = {
+                                    picks[id] = if (on) chosen - s.name else if (chosen.size < 2) chosen + s.name else chosen
+                                },
+                                label = {
+                                    Column(Modifier.padding(vertical = 4.dp)) {
+                                        Text("${s.name} · ${skillCostText(s)}", fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                                        Text(s.description, fontSize = 12.sp)
+                                    }
+                                },
+                                modifier = Modifier.fillMaxWidth()
+                            )
+                        }
+                    }
+                }
+            }
+        }
+
+        Text("Enemy card", style = MaterialTheme.typography.titleMedium)
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+            cards.forEach { c ->
+                FilterChip(selected = c.id == cardId, onClick = { cardId = c.id }, label = { Text(c.name, fontSize = 12.sp) })
+            }
+        }
+        Text("Difficulty", style = MaterialTheme.typography.titleMedium)
+        Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+            (0..2).forEach { a ->
+                FilterChip(selected = area == a, onClick = { area = a }, label = { Text("Area ${a + 1}") })
+            }
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+            TacticsRepository.StopKind.entries.forEach { k ->
+                FilterChip(selected = kind == k, onClick = { kind = k }, label = { Text(k.label) })
+            }
+        }
+        error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+        Button(
+            enabled = cardId != null && party.all { it in loaded },
+            onClick = {
+                scope.launch {
+                    try {
+                        val members = party.mapNotNull { loaded[it] }
+                        val stage = Stage.entries[members.maxOf { Stage.fromCard(it.stage).ordinal }]
+                        val team = members.map { f -> repo.spec(f, (picks[f.unitKey] ?: emptyList()).mapNotNull { Skills.byName(it) }) }
+                        val foes = repo.enemies(cardId!!, stage, area, kind, Random(System.nanoTime()))
+                        if (foes.isEmpty()) {
+                            error = "That card has no battle-stage Digimon."
+                            return@launch
+                        }
+                        // Card Digimon and stored Digimon can share ids; enemies get their own key space.
+                        val enemySpecs = foes.mapIndexed { i, (_, s) -> s.copy(key = -(i + 1).toLong()) }
+                        val enemyFrames = foes.mapIndexed { i, (f, _) -> -(i + 1).toLong() to Frames(f) }.toMap()
+                        DebugLog.i("Tactics", "Test fight: ${team.joinToString { it.name }} vs ${enemySpecs.joinToString { it.name }} (area ${area + 1}, ${kind.label})")
+                        val bg = try { repo.background(cardId!!) } catch (e: Exception) { null }
+                        onStart(TacticsBattle(team, enemySpecs), members.associate { it.unitKey to Frames(it) } + enemyFrames, bg)
+                    } catch (e: Exception) {
+                        DebugLog.e("Tactics", "Could not start the test fight", e)
+                        error = "Could not start: ${e.message}"
+                    }
+                }
+            },
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(vertical = 12.dp)
+        ) { Text("Start test fight") }
+    }
+}
