@@ -0,0 +1,105 @@
+package com.github.nacabaro.vbhelper.source
+
+import android.content.Context
+import com.github.nacabaro.vbhelper.database.AppDatabase
+import com.github.nacabaro.vbhelper.dtos.OfflineBattleDtos
+import com.github.nacabaro.vbhelper.screens.offlineBattle.BattleEngine
+import com.github.nacabaro.vbhelper.screens.offlineBattle.FighterStats
+import com.github.nacabaro.vbhelper.utils.DebugLog
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.withContext
+import kotlin.random.Random
+
+/**
+ * Offline battles: an arena ladder of five opponents per Digimon and raid
+ * bosses taken from your cards' adventure bosses. Every win or loss is added
+ * to the Digimon's battle record (current stage and total, capped at 999), so
+ * it counts toward evolution once the Digimon is sent back to the bracelet.
+ */
+class OfflineBattleRepository(
+    context: Context,
+    private val db: AppDatabase,
+    private val currency: CurrencyRepository
+) {
+    private val prefs = context.applicationContext.getSharedPreferences("offline_battles", Context.MODE_PRIVATE)
+    private val dao = db.offlineBattleDao()
+
+    companion object {
+        const val LADDER_SIZE = 5
+        private val LADDER_MULTIPLIERS = listOf(0.85, 0.95, 1.05, 1.15, 1.25)
+        const val RAID_HP_MULTIPLIER = 3.0
+        const val LADDER_CLEAR_BONUS = 3000
+
+        fun arenaWinCredits(rung: Int) = 500 * (rung + 1)
+        fun raidWinCredits(bossStage: Int) = 2000 + 500 * bossStage
+    }
+
+    data class LadderOpponent(val rung: Int, val stats: FighterStats, val stage: Int)
+
+    suspend fun fighter(userCharacterId: Long): OfflineBattleDtos.MyFighter? =
+        withContext(Dispatchers.IO) { dao.getFighter(userCharacterId) }
+
+    /** Five opponents at your Digimon's stage, easiest first. Stays the same all day. */
+    suspend fun ladder(me: OfflineBattleDtos.MyFighter): List<LadderOpponent> = withContext(Dispatchers.IO) {
+        val pool = dao.getOpponentsAtStage(me.stage, me.isBem)
+            .sortedBy { BattleEngine.power(it.hp, it.ap, it.bp) }
+        if (pool.isEmpty()) return@withContext emptyList()
+
+        val day = System.currentTimeMillis() / 86_400_000L
+        val random = Random(me.userCharacterId * 31 + day)
+        (0 until LADDER_SIZE).map { rung ->
+            // Spread picks from the weaker end of the pool to the stronger end.
+            val band = pool.size.toDouble() / LADDER_SIZE
+            val from = (rung * band).toInt().coerceAtMost(pool.size - 1)
+            val to = ((rung + 1) * band).toInt().coerceIn(from + 1, pool.size)
+            val pick = pool[random.nextInt(from, to)]
+            LadderOpponent(rung, BattleEngine.fromCpu(pick, LADDER_MULTIPLIERS[rung]), pick.stage)
+        }
+    }
+
+    suspend fun raidBosses(): List<OfflineBattleDtos.CpuFighter> =
+        withContext(Dispatchers.IO) { dao.getRaidBosses().distinctBy { Triple(it.id, it.hp, it.ap) } }
+
+    fun ladderRung(userCharacterId: Long): Int = prefs.getInt("ladder_$userCharacterId", 0)
+
+    private fun setLadderRung(userCharacterId: Long, rung: Int) {
+        prefs.edit().putInt("ladder_$userCharacterId", rung).apply()
+    }
+
+    /** Records an arena fight and returns the credits earned. */
+    suspend fun finishArenaFight(userCharacterId: Long, rung: Int, won: Boolean): Int = withContext(Dispatchers.IO) {
+        var credits = 0
+        if (won) {
+            dao.addWin(userCharacterId)
+            credits = arenaWinCredits(rung)
+            if (rung + 1 >= LADDER_SIZE) {
+                credits += LADDER_CLEAR_BONUS
+                setLadderRung(userCharacterId, 0)
+            } else {
+                setLadderRung(userCharacterId, rung + 1)
+            }
+        } else {
+            dao.addLoss(userCharacterId)
+            setLadderRung(userCharacterId, 0)
+        }
+        addCredits(credits)
+        DebugLog.i("Battle", "Arena rung ${rung + 1}: ${if (won) "won" else "lost"} (Digimon $userCharacterId), +$credits credits")
+        credits
+    }
+
+    /** Records a raid for every Digimon that fought and returns the credits earned. */
+    suspend fun finishRaid(fought: List<Long>, bossStage: Int, won: Boolean): Int = withContext(Dispatchers.IO) {
+        fought.forEach { if (won) dao.addWin(it) else dao.addLoss(it) }
+        val credits = if (won) raidWinCredits(bossStage) else 0
+        addCredits(credits)
+        DebugLog.i("Battle", "Raid ${if (won) "won" else "lost"} with ${fought.size} Digimon, +$credits credits")
+        credits
+    }
+
+    private suspend fun addCredits(amount: Int) {
+        if (amount <= 0) return
+        val now = currency.currencyValue.first()
+        currency.setCurrencyValue(now + amount)
+    }
+}
diff --git a/app/src/main/java/com/github/nacabaro/vbhelper/source/RunRepository.kt b/app/src/main/java/com/github/nacabaro/vbhelper/source/RunRepository.kt
