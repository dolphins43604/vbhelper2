+
+/** Full transfer log, newest at the bottom, with copy / share / clear. */
+@Composable
+fun DebugLogScreen(
+    navController: NavController
+) {
+    val context = LocalContext.current
+    DebugLog.init(context)
+    val lines by DebugLog.lines.collectAsState()
+    val listState = rememberLazyListState()
+
+    LaunchedEffect(lines.size) {
+        if (lines.isNotEmpty()) listState.scrollToItem(lines.lastIndex)
+    }
+
+    Scaffold(
+        topBar = {
+            TopBanner(
+                text = stringResource(R.string.debug_log_title),
+                onBackClick = { navController.popBackStack() }
+            )
+        }
+    ) { contentPadding ->
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(top = contentPadding.calculateTopPadding())
+                .padding(horizontal = 12.dp)
+        ) {
+            Row(
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(vertical = 8.dp)
+            ) {
+                Button(
+                    onClick = {
+                        val clipboard = context.getSystemService(ClipboardManager::class.java)
+                        clipboard?.setPrimaryClip(ClipData.newPlainText("VBHelper debug log", DebugLog.asText()))
+                        Toast.makeText(context, context.getString(R.string.debug_log_copied), Toast.LENGTH_SHORT).show()
+                    },
+                    modifier = Modifier.weight(1f)
+                ) { Text(stringResource(R.string.debug_log_copy)) }
+
+                Button(
+                    onClick = {
+                        val send = Intent(Intent.ACTION_SEND).apply {
+                            type = "text/plain"
+                            putExtra(Intent.EXTRA_SUBJECT, "VBHelper Custom debug log")
+                            putExtra(Intent.EXTRA_TEXT, DebugLog.asText())
+                        }
+                        context.startActivity(Intent.createChooser(send, null))
+                    },
+                    modifier = Modifier.weight(1f)
+                ) { Text(stringResource(R.string.debug_log_share)) }
+
+                OutlinedButton(
+                    onClick = { DebugLog.clear() },
+                    modifier = Modifier.weight(1f)
+                ) { Text(stringResource(R.string.debug_log_clear)) }
+            }
+
+            if (lines.isEmpty()) {
+                Text(
+                    text = stringResource(R.string.debug_log_empty),
+                    modifier = Modifier.padding(top = 16.dp)
+                )
+            }
+
+            LazyColumn(
+                state = listState,
+                modifier = Modifier.fillMaxSize()
+            ) {
+                items(lines) { line ->
+                    Text(
+                        text = line,
+                        fontFamily = FontFamily.Monospace,
+                        fontSize = 11.sp,
+                        lineHeight = 14.sp,
+                        color = if (line.contains(" E/")) MaterialTheme.colorScheme.error
+                                else MaterialTheme.colorScheme.onSurface
+                    )
+                }
+            }
+        }
+    }
+}
