+/**
+ * Change the stats of a Digimon in storage. The new values go to the
+ * bracelet the next time it is sent with "Send to watch".
+ */
+@Composable
+fun EditCharacterScreen(
+    navController: NavController,
+    characterId: Long
+) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val repository = remember { CharacterForgeRepository(application.container.db) }
+    val scope = rememberCoroutineScope()
+
+    var stats by remember { mutableStateOf<ForgeStats?>(null) }
+    var deviceType by remember { mutableStateOf(DeviceType.BEDevice) }
+    var saving by remember { mutableStateOf(false) }
+
+    LaunchedEffect(characterId) {
+        val (type, loaded) = repository.loadStats(characterId)
+        deviceType = type
+        stats = loaded
+    }
+
+    Scaffold(
+        topBar = {
+            TopBanner(
+                text = stringResource(R.string.forge_edit_title),
+                onBackClick = { navController.popBackStack() }
+            )
+        }
+    ) { contentPadding ->
+        LazyColumn(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(top = contentPadding.calculateTopPadding())
+                .padding(horizontal = 16.dp)
+        ) {
+            val current = stats
+            if (current == null) {
+                item { Text(stringResource(R.string.forge_loading), modifier = Modifier.padding(24.dp)) }
+                return@LazyColumn
+            }
+
+            item {
+                StatsForm(
+                    stats = current,
+                    deviceType = deviceType,
+                    onChange = { stats = it }
+                )
+            }
+
+            item { Column {
+                Text(
+                    text = stringResource(R.string.forge_edit_hint),
+                    style = MaterialTheme.typography.bodySmall,
+                    modifier = Modifier.padding(vertical = 8.dp)
+                )
+                Button(
+                    enabled = !saving,
+                    onClick = {
+                        saving = true
+                        scope.launch {
+                            repository.saveStats(characterId, current)
+                            saving = false
+                            Toast.makeText(
+                                application,
+                                application.getString(R.string.forge_saved_toast),
+                                Toast.LENGTH_SHORT
+                            ).show()
+                            navController.popBackStack()
+                        }
+                    },
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(bottom = 24.dp)
+                ) {
+                    Text(stringResource(R.string.forge_save))
+                }
+            } }
+        }
+    }
+}
