+        Text("Enemy card", style = MaterialTheme.typography.titleMedium)
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+            cards.forEach { c ->
+                FilterChip(selected = c.id == cardId, onClick = { cardId = c.id }, label = { Text(c.name, fontSize = 12.sp) })
+            }
+        }
+        Text("Difficulty", style = MaterialTheme.typography.titleMedium)
+        Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+            (0..2).forEach { a ->
+                FilterChip(selected = area == a, onClick = { area = a }, label = { Text("Area ${a + 1}") })
+            }
+        }
