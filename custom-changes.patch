+@Composable
+private fun Hub(
+    me: OfflineBattleDtos.MyFighter,
+    ladder: List<OfflineBattleRepository.LadderOpponent>,
+    rung: Int,
+    bosses: List<OfflineBattleDtos.CpuFighter>,
+    onArena: (OfflineBattleRepository.LadderOpponent) -> Unit,
+    onRaid: (OfflineBattleDtos.CpuFighter) -> Unit
+) {
+    val stats = remember(me) { BattleEngine.fromMine(me) }
+    LazyColumn(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+        item {
+            Card(colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainerHigh)) {
+                Row(Modifier.padding(12.dp), verticalAlignment = Alignment.CenterVertically) {
+                    Sprite(stats.sprites.idle1, stats.sprites.width, stats.sprites.height, flip = true, multiplier = 3)
+                    Spacer(Modifier.width(12.dp))
+                    Column {
+                        Text(stringResource(R.string.offline_stats, stats.hp, stats.ap, stats.bp), fontWeight = FontWeight.Bold)
+                        Text(stringResource(R.string.offline_record, me.phaseWins, me.phaseLosses, me.totalWins, me.totalLosses),
+                            style = MaterialTheme.typography.bodySmall)
+                    }
+                }
+            }
+        }
+
+        item { Text(stringResource(R.string.offline_arena_title), style = MaterialTheme.typography.titleLarge) }
+        if (ladder.isEmpty()) {
+            item { Text(stringResource(R.string.offline_no_opponents), style = MaterialTheme.typography.bodySmall) }
+        } else {
+            item {
+                Text(stringResource(R.string.offline_arena_desc, rung + 1, OfflineBattleRepository.LADDER_SIZE),
+                    style = MaterialTheme.typography.bodySmall)
+            }
+            items(ladder) { opp ->
+                val state = when {
+                    opp.rung < rung -> stringResource(R.string.offline_rung_beaten)
+                    opp.rung == rung -> stringResource(R.string.offline_rung_next, OfflineBattleRepository.arenaWinCredits(opp.rung))
+                    else -> stringResource(R.string.offline_rung_locked)
+                }
+                OpponentRow(
+                    sprite = opp.stats.sprites,
+                    title = stringResource(R.string.offline_rung, opp.rung + 1, opp.stats.name),
+                    subtitle = "${opp.stats.hp} HP · ${opp.stats.ap} AP · ${opp.stats.bp} BP · $state",
+                    enabled = opp.rung == rung,
+                    onClick = { onArena(opp) }
+                )
+            }
+        }
+
+        item { Text(stringResource(R.string.offline_raid_title), style = MaterialTheme.typography.titleLarge) }
+        if (bosses.isEmpty()) {
+            item { Text(stringResource(R.string.offline_no_bosses), style = MaterialTheme.typography.bodySmall) }
+        } else {
+            item { Text(stringResource(R.string.offline_raid_desc), style = MaterialTheme.typography.bodySmall) }
+            items(bosses) { boss ->
+                OpponentRow(
+                    sprite = FighterStats.Sprites(boss.idle1, boss.idle2, boss.attack, boss.dodge, boss.width, boss.height),
+                    title = boss.cardName,
+                    subtitle = stringResource(R.string.offline_boss_line, boss.stage, OfflineBattleRepository.raidWinCredits(boss.stage)),
+                    enabled = true,
+                    onClick = { onRaid(boss) }
+                )
+            }
+        }
+        item { Spacer(Modifier.height(24.dp)) }
+    }
+}
