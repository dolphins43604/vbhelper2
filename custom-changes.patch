+private sealed interface BattleMode {
+    data object Hub : BattleMode
+    data class Arena(val opponent: OfflineBattleRepository.LadderOpponent) : BattleMode
+    data class RaidSetup(val boss: OfflineBattleDtos.CpuFighter) : BattleMode
+    data class Raid(val boss: OfflineBattleDtos.CpuFighter, val team: List<Pair<Long, FighterStats>>) : BattleMode
+    data class Result(val won: Boolean, val credits: Int, val message: String) : BattleMode
+}
