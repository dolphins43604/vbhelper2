+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+@NonSkippableComposable
+private fun ActionPanel(
+    battle: TacticsBattle,
+    step: Step,
+    busy: Boolean,
+    onSkill: (Skill) -> Unit,
+    onGuard: () -> Unit,
+    onWait: () -> Unit,
+    onConfirm: () -> Unit,
+    onCancel: () -> Unit
+) {
+    val unitId = when (step) {
+        is Step.Selected -> step.unit
+        is Step.Moved -> step.unit
+        is Step.Targeting -> step.unit
+        is Step.Confirm -> step.unit
+        else -> null
+    }
+    if (step is Step.Inspect) {
+        UnitDetails(battle, battle.byId(step.unit), onClose = onCancel)
+        return
+    }
+    if (unitId == null) {
+        Text(
+            if (busy) "…" else "Tap one of your Digimon (A, B, C) to select it. Tap a blue tile to move, or tap a red enemy to attack it. " +
+                    "Tap any Digimon to see its details and skills. A red ! marks who an enemy will hit. " +
+                    "✦ = aura (green tiles help you, purple tiles hurt you), ▲ = buffed.",
+            style = MaterialTheme.typography.bodySmall
+        )
+        return
+    }
+    val f = battle.byId(unitId)
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(10.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text("${f.name} · ${f.stage.label} · ${f.attr.label} · ${f.field?.label ?: "No Field"}", fontWeight = FontWeight.SemiBold)
+            Text("HP ${f.hp.toInt()}/${f.maxHp.toInt()} · Energy ${f.energy}/${f.energyMax} · ATK ${f.atk.toInt()} · DEF ${f.def.toInt()} · SPD ${f.spd.toInt()}" +
+                    (if (f.shield > 0) " · Firewall ${f.shield.toInt()}" else ""), style = MaterialTheme.typography.bodySmall)
+            BuffLines(f)
+            when (step) {
+                is Step.Selected -> Text("Tap a blue tile to move (its own tile to stay), or tap a red enemy to attack it.", style = MaterialTheme.typography.bodySmall)
+                is Step.Moved -> {
+                    Text("Choose an action (or tap a red enemy to attack it):", style = MaterialTheme.typography.bodySmall)
+                    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                        f.skills.forEach { s ->
+                            val inRange = s.kind != SkillKind.ATTACK || battle.targetsFrom(f, step.dest, s).isNotEmpty()
+                            val usable = battle.canUse(f, s) && inRange
+                            val why = when {
+                                battle.costOf(f, s) > f.energy -> "needs ${battle.costOf(f, s)} Energy"
+                                !inRange -> "no enemy in range from here"
+                                !battle.canUse(f, s) -> "can't use now"
+                                else -> null
+                            }
+                            OutlinedButton(onClick = { onSkill(s) }, enabled = usable, modifier = Modifier.fillMaxWidth()) {
+                                Column(Modifier.fillMaxWidth()) {
+                                    Text("${s.name} · ${skillCostText(s)}", fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                                    Text(s.description, fontSize = 12.sp)
+                                    if (why != null) Text(why, fontSize = 11.sp, color = MaterialTheme.colorScheme.error)
+                                }
+                            }
+                        }
+                        Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                            OutlinedButton(onClick = onGuard) { Text("Guard (half damage)", fontSize = 12.sp) }
+                            OutlinedButton(onClick = onWait) { Text("Wait", fontSize = 12.sp) }
+                            OutlinedButton(onClick = onCancel) { Text("Cancel", fontSize = 12.sp) }
+                        }
+                    }
+                }
+                is Step.Targeting -> {
+                    Text("${step.skill.name}: ${step.skill.description}", style = MaterialTheme.typography.bodySmall)
+                    Text("Tap a red enemy to see the forecast.", style = MaterialTheme.typography.bodySmall)
+                    OutlinedButton(onClick = onCancel) { Text("Cancel") }
+                }
+                is Step.Confirm -> {
+                    val t = battle.byId(step.target)
+                    val fc = step.forecast
+                    Text("${step.skill.name} → ${t.name} (HP ${t.hp.toInt()})", fontWeight = FontWeight.SemiBold)
+                    Text(step.skill.description, style = MaterialTheme.typography.bodySmall)
+                    Text(
+                        "Damage ${fc.damage}${if (fc.doubles) " ×2 (faster)" else ""} · Hit ${fc.hit}% · Crit ${fc.crit}%" +
+                                when (fc.advantage) { 1 -> " · ▲ advantage"; -1 -> " · ▼ they have advantage"; else -> "" } +
+                                (if (fc.kills) " · KO" else "") +
+                                (if (step.skill.area == Area.MULTI3) " · hits 3 random enemies"
+                                else if (fc.splashTargets > 0) " · also hits ${fc.splashTargets} more" else ""),
+                        style = MaterialTheme.typography.bodySmall
+                    )
+                    Text(
+                        if (fc.counter) "Counter: ${t.name} hits back for ${fc.counterDamage} (${fc.counterHit}%)" else "No counter",
+                        style = MaterialTheme.typography.bodySmall
+                    )
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Button(onClick = onConfirm) { Text("Confirm") }
+                        OutlinedButton(onClick = onCancel) { Text("Other actions") }
+                    }
+                    Text("Tap another red enemy to switch target.", style = MaterialTheme.typography.bodySmall)
+                }
+                else -> {}
+            }
+        }
+    }
+}
+
+@Composable
+@NonSkippableComposable
+private fun UnitDetails(battle: TacticsBattle, f: Fighter, onClose: () -> Unit) {
+    val intent = battle.intents.firstOrNull { it.enemyId == f.id }
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(10.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+            Text("${if (f.side == TacticsBattle.ENEMY) "Enemy: " else ""}${f.name}", fontWeight = FontWeight.SemiBold)
+            Text("${f.stage.label} · ${f.attr.label} · ${f.field?.label ?: "No Field"}", style = MaterialTheme.typography.bodySmall)
+            Text("HP ${f.hp.toInt()}/${f.maxHp.toInt()} · Energy ${f.energy}/${f.energyMax} · ATK ${f.atk.toInt()} · DEF ${f.def.toInt()} · SPD ${f.spd.toInt()} · " +
+                    "CRIT ${f.crit.toInt()}% · EVA ${f.eva.toInt()} · RES ${f.res.toInt()}" + (if (f.shield > 0) " · Firewall ${f.shield.toInt()}" else ""),
+                style = MaterialTheme.typography.bodySmall)
+            if (f.status.isNotEmpty()) Text("Status: " + f.status.entries.joinToString { (k, v) -> "${k.label} ($v)" }, style = MaterialTheme.typography.bodySmall)
+            BuffLines(f)
+            Text(Skills.fieldPassive(f.field), style = MaterialTheme.typography.bodySmall)
+            Text(Skills.attrTrait(f.attr), style = MaterialTheme.typography.bodySmall)
+            if (intent != null && f.alive) {
+                val target = intent.targetId?.let { battle.byId(it).name }
+                Text(if (target != null) "Next: ${intent.skill} on $target" else "Next: ${intent.skill}",
+                    color = Color(0xFFE53935), style = MaterialTheme.typography.bodySmall)
+            }
+            Text("Skills", style = MaterialTheme.typography.labelLarge)
+            f.skills.forEach { s ->
+                Text("${s.name} · ${skillCostText(s)}: ${s.description}", style = MaterialTheme.typography.bodySmall)
+            }
+            OutlinedButton(onClick = onClose) { Text("Close") }
+        }
+    }
+}
+
+@Composable
+@NonSkippableComposable
+private fun BuffLines(f: Fighter) {
+    val buffs = f.buffText()
+    if (buffs.isNotEmpty()) Text("▲ Buffs: " + buffs.joinToString(" · "), color = Color(0xFF81C784), style = MaterialTheme.typography.bodySmall)
+    f.aura?.takeIf { f.auraTurns > 0 }?.let {
+        Text("✦ ${it.name} (${f.auraTurns} turns): ${it.description}", color = Color(0xFFCE93D8), style = MaterialTheme.typography.bodySmall)
+    }
+}
+
+@Composable
+internal fun SpriteImage(bytes: ByteArray, width: Int, height: Int, modifier: Modifier, flip: Boolean) {
+    val context = LocalContext.current
+    val data = remember(bytes) { BitmapData(bytes, width, height).getImageBitmap(context, 1, false) }
+    Image(
+        bitmap = data.imageBitmap,
+        contentDescription = null,
+        filterQuality = FilterQuality.None,
+        contentScale = ContentScale.Fit,
+        modifier = modifier.graphicsLayer { scaleX = if (flip) -1f else 1f }
+    )
+}
diff --git a/app/src/main/java/com/github/nacabaro/vbhelper/source/CardLibrary.kt b/app/src/main/java/com/github/nacabaro/vbhelper/source/CardLibrary.kt
new file mode 100644
index 0000000..f237ae1
--- /dev/null
+++ b/app/src/main/java/com/github/nacabaro/vbhelper/source/CardLibrary.kt
@@ -0,0 +1,211 @@
+package com.github.nacabaro.vbhelper.source
+
+import android.content.Context
+import android.net.Uri
+import android.provider.DocumentsContract
+import androidx.activity.ComponentActivity
+import androidx.room.withTransaction
+import com.github.nacabaro.vbhelper.database.AppDatabase
+import com.github.nacabaro.vbhelper.domain.card.Card
+import com.github.nacabaro.vbhelper.domain.card.CardProgress
+import com.github.nacabaro.vbhelper.screens.scanScreen.converters.FromNfcConverter
+import com.github.nacabaro.vbhelper.screens.settingsScreen.controllers.CardImportController
+import com.github.nacabaro.vbhelper.utils.DebugLog
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+private const val TAG = "Cards"
+
+/**
+ * Card housekeeping: importing one card or a whole folder (skipping cards you
+ * already have), merging duplicate copies without losing Digimon, and
+ * restoring Lost & found Digimon once their card is imported.
+ */
+class CardLibrary(
+    private val activity: ComponentActivity,
+    private val db: AppDatabase
+) {
+    private val context: Context = activity.applicationContext
+    private val importer = CardImportController(db)
+
+    data class ImportSummary(
+        val imported: List<String> = emptyList(),
+        val skipped: List<String> = emptyList(),
+        val failed: List<String> = emptyList(),
+        val restored: Int = 0
+    )
+
+    data class MergeSummary(val copiesRemoved: Int, val digimonMoved: Int)
+
+    // ---------- Import ----------
+
+    suspend fun importFile(uri: Uri, label: String = uri.lastPathSegment ?: "card"): ImportSummary =
+        withContext(Dispatchers.IO) {
+            val result = importOne(uri, label)
+            result.copy(restored = restoreLostAndFound())
+        }
+
+    suspend fun importFolder(treeUri: Uri): ImportSummary = withContext(Dispatchers.IO) {
+        val files = findBinFiles(treeUri)
+        DebugLog.i(TAG, "Folder import: found ${files.size} .bin file(s)")
+        var summary = ImportSummary()
+        for ((uri, name) in files) {
+            val one = importOne(uri, name)
+            summary = summary.copy(
+                imported = summary.imported + one.imported,
+                skipped = summary.skipped + one.skipped,
+                failed = summary.failed + one.failed
+            )
+        }
+        summary.copy(restored = restoreLostAndFound())
+    }
+
+    private suspend fun importOne(uri: Uri, label: String): ImportSummary {
+        return try {
+            val card = context.contentResolver.openInputStream(uri).use { importer.readCard(it) }
+            val cardId = card.header.dimId
+            val logo = card.spriteData.sprites[0].pixelData
+            val name = card.spriteData.text
+
+            val copies = db.cardDao().getCardByCardId(cardId).filter { it.logo.contentEquals(logo) }
+            val alreadyHave = copies.isNotEmpty()
+            // Cards imported before backgrounds were saved get theirs now.
+            copies.forEach { importer.saveBackground(it.id, card) }
+            if (alreadyHave) {
+                DebugLog.i(TAG, "Skipped $label: card $cardId ($name) is already imported")
+                ImportSummary(skipped = listOf(name))
+            } else {
+                importer.importParsedCard(card)
+                DebugLog.i(TAG, "Imported $label as card $cardId ($name)")
+                ImportSummary(imported = listOf(name))
+            }
+        } catch (e: Throwable) {
+            DebugLog.e(TAG, "Could not import $label", e)
+            ImportSummary(failed = listOf(label))
+        }
+    }
+
+    /** Walks the picked folder (and subfolders) for .bin files. */
+    private fun findBinFiles(treeUri: Uri): List<Pair<Uri, String>> {
+        val found = mutableListOf<Pair<Uri, String>>()
+        val rootId = DocumentsContract.getTreeDocumentId(treeUri)
+        val toVisit = ArrayDeque(listOf(rootId))
+        val columns = arrayOf(
+            DocumentsContract.Document.COLUMN_DOCUMENT_ID,
+            DocumentsContract.Document.COLUMN_DISPLAY_NAME,
+            DocumentsContract.Document.COLUMN_MIME_TYPE
+        )
+        var visited = 0
+        while (toVisit.isNotEmpty() && visited < 500) {
+            val parentId = toVisit.removeFirst()
+            visited++
+            val childrenUri = DocumentsContract.buildChildDocumentsUriUsingTree(treeUri, parentId)
+            context.contentResolver.query(childrenUri, columns, null, null, null)?.use { cursor ->
+                while (cursor.moveToNext()) {
+                    val id = cursor.getString(0)
+                    val name = cursor.getString(1) ?: continue
+                    val mime = cursor.getString(2)
+                    if (mime == DocumentsContract.Document.MIME_TYPE_DIR) {
+                        toVisit.addLast(id)
+                    } else if (name.endsWith(".bin", ignoreCase = true)) {
+                        found += DocumentsContract.buildDocumentUriUsingTree(treeUri, id) to name
+                    }
+                }
+            }
+        }
+        return found.sortedBy { it.second.lowercase() }
+    }
+
+    // ---------- Lost & found ----------
+
+    fun lostAndFoundCount(): Int = LostAndFound(context).count()
+
+    /** Turns Lost & found Digimon back into stored Digimon when their card exists now. */
+    suspend fun restoreLostAndFound(): Int = withContext(Dispatchers.IO) {
+        val store = LostAndFound(context)
+        val converter = FromNfcConverter(activity)
+        var restored = 0
+        for (entry in store.entries()) {
+            val card = db.cardDao().getCardByCardId(entry.character.dimId.toInt()).firstOrNull() ?: continue
+            // Only try when the slot exists, otherwise the converter would file it again.
+            val slotExists = runCatching {
+                db.characterDao().getCharacterByMonIndex(entry.character.charIndex.toInt(), card.id)
+            }.getOrNull() != null
+            if (!slotExists) continue
+            try {
+                val message = converter.addCharacterUsingCard(entry.character, card.id)
+                DebugLog.i(TAG, "Lost & found: card ${card.name} slot ${entry.character.charIndex}: $message")
+                if (message == "Done reading character!") {
+                    store.remove(entry)
+                    restored++
+                }
+            } catch (e: Throwable) {
+                DebugLog.e(TAG, "Lost & found: could not restore a Digimon for ${card.name}", e)
+            }
+        }
+        restored
+    }
+
+    // ---------- Duplicates ----------
+
+    /** Groups of copies of the same card (same card id and logo), oldest copy first. */
+    suspend fun findDuplicates(): List<List<Card>> = withContext(Dispatchers.IO) {
+        db.cardDao().getAllCards()
+            .groupBy { it.cardId }
+            .values
+            .flatMap { sameId ->
+                val groups = mutableListOf<MutableList<Card>>()
+                for (card in sameId.sortedBy { it.id }) {
+                    groups.firstOrNull { it.first().logo.contentEquals(card.logo) }?.add(card)
+                        ?: groups.add(mutableListOf(card))
+                }
+                groups
+            }
+            .filter { it.size > 1 }
+    }
+
+    /**
+     * Keeps the oldest copy of each duplicated card, moves every stored Digimon,
+     * evolution history, Dex entry and adventure progress onto it, then deletes
+     * the extra copies.
+     */
+    suspend fun mergeDuplicates(): MergeSummary = withContext(Dispatchers.IO) {
+        val tools = db.toolsDao()
+        var removed = 0
+        var moved = 0
+        for (group in findDuplicates()) {
+            val keeper = group.first()
+            val keeperChars = tools.getCardCharacters(keeper.id).associateBy { it.charaIndex }
+            for (copy in group.drop(1)) {
+                db.withTransaction {
+                    moved += tools.countStoredDigimonForCard(copy.id)
+                    for (char in tools.getCardCharacters(copy.id)) {
+                        val target = keeperChars[char.charaIndex] ?: continue
+                        tools.moveStoredDigimon(char.id, target.id)
+                        tools.moveTransformationHistory(char.id, target.id)
+                        tools.copyDexEntry(char.id, target.id)
+                    }
+                    val a = tools.getCardProgress(keeper.id)
+                    val b = tools.getCardProgress(copy.id)
+                    if (b != null) {
+                        tools.saveCardProgress(
+                            CardProgress(
+                                cardId = keeper.id,
+                                currentStage = maxOf(a?.currentStage ?: 1, b.currentStage),
+                                unlocked = (a?.unlocked ?: false) || b.unlocked
+                            )
+                        )
+                    }
+                    db.cardDao().deleteCard(copy.id)
+                }
+                removed++
+                DebugLog.i(TAG, "Merged duplicate copy ${copy.id} of ${keeper.name} into ${keeper.id}")
+            }
+        }
+        MergeSummary(copiesRemoved = removed, digimonMoved = moved)
+    }
+
+    suspend fun storedDigimonOnCard(cardId: Long): Int = withContext(Dispatchers.IO) {
+        db.toolsDao().countStoredDigimonForCard(cardId)
+    }
+}
