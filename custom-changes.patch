+                "Merge failed: ${e.message ?: e.javaClass.simpleName}"
             }
+            Toast.makeText(context, result, Toast.LENGTH_LONG).show()
+            onDone()
+        }
+    }
+
+    override fun lostAndFoundCount(): Int = cardLibrary.lostAndFoundCount()
+
+    override fun restoreLostAndFound(onDone: () -> Unit) {
+        context.lifecycleScope.launch {
