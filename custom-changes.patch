+// ------------------------------------------------------------------------------------------ map
+
+@Composable
+@NonSkippableComposable
+@Suppress("UNUSED_PARAMETER")
+private fun MapView(run: RunState, version: Int, onPick: (MapNode) -> Unit) {
+    val nodes = run.map()
+    val choices = run.choices().map { it.id }.toSet()
+    val rowH = 58.dp
+    val rows = RunMap.ROWS
+    BoxWithConstraints(
+        Modifier
+            .fillMaxWidth()
+            .height(rowH * rows)
+            .clip(RoundedCornerShape(14.dp))
+            .background(Color(0xFF0E1424))
+            .border(1.dp, Color(0x559FB4FF), RoundedCornerShape(14.dp))
+    ) {
+        val w = maxWidth
+        val byId = nodes.associateBy { it.id }
+        Canvas(Modifier.fillMaxSize()) {
+            val rh = size.height / rows
+            fun c(n: MapNode) = Offset(size.width * (n.col + 0.5f) / n.width, (rows - 1 - n.row) * rh + rh / 2)
+            for (n in nodes) for (id in n.next) {
+                val m = byId[id] ?: continue
+                val walked = n.id in run.visited && m.id in run.visited
+                drawLine(
+                    color = if (walked) Color(0xFFFFC107) else Color(0x559FB4FF),
+                    start = c(n), end = c(m), strokeWidth = if (walked) 6f else 3f
+                )
+            }
+        }
+        for (n in nodes) {
+            val x = w * ((n.col + 0.5f) / n.width)
+            val y = rowH * (rows - 1 - n.row) + rowH / 2
+            val canPick = n.id in choices
+            val visited = n.id in run.visited
+            val d = if (n.type == NodeType.BOSS) 48.dp else 40.dp
+            Box(
+                Modifier
+                    .offset(x = x - d / 2, y = y - d / 2)
+                    .size(d)
+                    .clip(CircleShape)
+                    .background(
+                        when {
+                            canPick -> Color(0xFF2E7D32)
+                            visited -> Color(0xFF6D5B1E)
+                            n.type == NodeType.BOSS -> Color(0xFF5B1E2E)
+                            else -> Color(0xFF1F2A44)
+                        }
+                    )
+                    .border(2.dp, if (canPick) Color(0xFFB9F6CA) else Color(0x339FB4FF), CircleShape)
+                    .clickable(enabled = canPick) { onPick(n) },
+                contentAlignment = Alignment.Center
+            ) { Text(n.type.icon, fontSize = if (n.type == NodeType.BOSS) 22.sp else 18.sp) }
+        }
+    }
+}
