+package com.github.nacabaro.vbhelper.roguelike
+
+import kotlin.math.min
+import kotlin.math.roundToInt
+import kotlin.random.Random
+
+/**
+ * The run layer (Phase 4): 3 areas of branching stops, XP and level-ups, data chips, gear, befriending,
+ * Bits and the enemy evolution ladder. Pure Kotlin so it can be tested off-device; saving and the
+ * database live in RunRepository.
+ */
+
+// ------------------------------------------------------------------------------------------ map
+
+enum class NodeType(val label: String, val icon: String, val blurb: String) {
+    BATTLE("Battle", "⚔", "A standard fight. Small chance of gear."),
+    ELITE("Elite", "💀", "A harder fight: more XP, coins and a better gear chance."),
+    BOSS("Boss", "👑", "The area's boss. Guaranteed gear."),
+    REST("Rest", "⛺", "Heal the party, or train one Digimon."),
+    DOJO("Dojo", "🥋", "Two stat boosts for one Digimon."),
+    SHOP("Shop", "🛒", "Spend coins on items, chips and gear."),
+    TREASURE("Treasure", "💾", "Pick a data chip."),
+    BEFRIEND("Befriend", "🤝", "Win over a wild Digimon."),
+    SHRINE("Shrine", "⛩", "Trade something for a strong reward."),
+    MYSTERY("Mystery", "❓", "Could be anything.");
+
+    val isFight get() = this == BATTLE || this == ELITE || this == BOSS
+}
+
+data class MapNode(val id: Int, val row: Int, val col: Int, val width: Int, val type: NodeType, val next: List<Int>)
+
+object RunMap {
+    /** 7 rows of stops, then the boss: every path is 8 stops long. */
+    const val ROWS = 8
+
+    fun generate(seed: Long, area: Int): List<MapNode> {
+        val rng = Random(seed * 7919 + area * 104729L)
+        val widths = (0 until ROWS - 1).map { if (it == 0) 2 else 2 + rng.nextInt(2) } + 1
+        val types = widths.mapIndexed { row, w -> MutableList(w) { pickType(row, rng) } }
+        types[0].indices.forEach { types[0][it] = NodeType.BATTLE }
+        types[1][rng.nextInt(widths[1])] = NodeType.BATTLE
+        types[3][rng.nextInt(widths[3])] = NodeType.TREASURE
+        types[ROWS - 2][rng.nextInt(widths[ROWS - 2])] = NodeType.REST
+        types[ROWS - 1][0] = NodeType.BOSS
+
+        val ids = mutableListOf<IntArray>()
+        var nextId = 0
+        widths.forEach { w -> ids += IntArray(w) { nextId++ } }
+        val edges = widths.indices.map { r -> List(widths[r]) { mutableSetOf<Int>() } }
+        for (r in 0 until ROWS - 1) {
+            val a = widths[r]; val b = widths[r + 1]
+            for (i in 0 until a) {
+                val j = if (a == 1) 0 else ((i.toDouble() * (b - 1)) / (a - 1)).roundToInt()
+                edges[r][i] += j
+                if (b > 1 && rng.nextDouble() < 0.45) edges[r][i] += (j + if (rng.nextBoolean()) 1 else -1).coerceIn(0, b - 1)
+            }
+            for (j in 0 until b) if (edges[r].none { j in it }) {
+                val i = if (b == 1) 0 else ((j.toDouble() * (a - 1)) / (b - 1)).roundToInt()
+                edges[r][i] += j
+            }
+        }
+        return widths.indices.flatMap { r ->
+            (0 until widths[r]).map { c ->
+                MapNode(ids[r][c], r, c, widths[r], types[r][c],
+                    if (r + 1 < ROWS) edges[r][c].sorted().map { ids[r + 1][it] } else emptyList())
+            }
+        }
+    }
+
+    private fun pickType(row: Int, rng: Random): NodeType {
+        val weights = buildList {
+            add(NodeType.BATTLE to 40)
+            if (row >= 2) add(NodeType.ELITE to 14)
+            if (row >= 2) add(NodeType.REST to 8)
+            add(NodeType.DOJO to 6)
+            if (row >= 1) add(NodeType.SHOP to 8)
+            add(NodeType.TREASURE to 7)
+            add(NodeType.BEFRIEND to 7)
+            if (row >= 2) add(NodeType.SHRINE to 5)
+            add(NodeType.MYSTERY to 10)
+        }
+        var roll = rng.nextInt(weights.sumOf { it.second })
+        for ((t, w) in weights) { if (roll < w) return t; roll -= w }
+        return NodeType.BATTLE
+    }
+
+    /** What a Mystery stop turns out to be (fixed per node, so reopening the app can't reroll it). */
+    fun resolveMystery(seed: Long, area: Int, nodeId: Int): NodeType {
+        val r = Random(seed + area * 977L + nodeId * 31L).nextInt(100)
+        return when {
+            r < 35 -> NodeType.BATTLE
+            r < 55 -> NodeType.TREASURE
+            r < 70 -> NodeType.BEFRIEND
+            r < 85 -> NodeType.SHRINE
+            else -> NodeType.REST
+        }
+    }
+}
+
+// ------------------------------------------------------------------------------------------ chips
+
+data class Chip(val id: String, val name: String, val description: String, val apply: (Mods) -> Mods = { it })
+
+object Chips {
+    val ALL = listOf(
+        Chip("overclock", "Overclock Chip", "+25% ATK, −10% max HP") { it.copy(atkMul = it.atkMul * 1.25, hpMul = it.hpMul * 0.9) },
+        Chip("glass", "Glass Cannon", "+40% ATK, −25% DEF") { it.copy(atkMul = it.atkMul * 1.4, defMul = it.defMul * 0.75) },
+        Chip("firewall", "Firewall Chip", "Start every battle with a 10% Firewall") { it.copy(shieldStart = it.shieldStart + 0.10) },
+        Chip("amp", "Firewall Amp", "Firewall effects +50%") { it.copy(shieldMul = it.shieldMul * 1.5) },
+        Chip("antivirus", "Antivirus Chip", "+20% damage vs Virus") { it.copy(vsVirus = it.vsVirus + 0.20) },
+        Chip("debugger", "Debugger Chip", "+20 RES") { it.copy(res = it.res + 20) },
+        Chip("turbo", "Turbo Chip", "+5 SPD") { it.copy(spd = it.spd + 5) },
+        Chip("crit", "Crit Chip", "+10 CRIT") { it.copy(crit = it.crit + 10) },
+        Chip("scope", "Scope Chip", "+8 hit") { it.copy(hit = it.hit + 8) },
+        Chip("cache", "Cache Chip", "+1 starting Energy") { it.copy(energy = it.energy + 1) },
+        Chip("ram", "RAM Upgrade", "+1 max Energy, −5% ATK") { it.copy(energyMax = it.energyMax + 1, atkMul = it.atkMul * 0.95) },
+        Chip("leech", "Leech Chip", "Heal 8% of damage dealt") { it.copy(lifesteal = it.lifesteal + 0.08) },
+        Chip("toxin", "Toxin Chip", "Malware you apply gets +1 stack") { it.copy(extraPoison = it.extraPoison + 1) },
+        Chip("igniter", "Igniter Chip", "Basic attacks have a 20% chance to Overheat") { it.copy(basicBurn = it.basicBurn + 0.20) },
+        Chip("armor", "Armor Chip", "+12% DEF") { it.copy(defMul = it.defMul * 1.12) },
+        Chip("vital", "Vital Chip", "+12% max HP") { it.copy(hpMul = it.hpMul * 1.12) },
+        Chip("backup", "Backup Chip", "Heal an extra 10% after every battle"),
+        Chip("miner", "Coin Miner", "+50% coins from battles")
+    )
+
+    fun byId(id: String) = ALL.firstOrNull { it.id == id }
+}
+
+// ------------------------------------------------------------------------------------------ gear
+
+enum class GearSlot(val label: String) { PLUGIN("Plug-in"), CREST("Crest") }
+enum class Rarity(val label: String, val lines: Int, val power: Double) {
+    COMMON("Common", 1, 1.0), RARE("Rare", 2, 1.0), EPIC("Epic", 3, 1.15), LEGENDARY("Legendary", 3, 1.6)
+}
+
+/** One stat line on a Plug-in: "hp", "atk", "def" are fractions; "spd", "crit", "eva", "res" are flat. */
+data class GearLine(val stat: String, val value: Double)
+
+data class Gear(
+    val id: Long,
+    val slot: GearSlot,
+    val rarity: Rarity,
+    val lines: List<GearLine> = emptyList(),
+    val crest: Crest? = null
+) {
+    val name: String get() = if (crest != null) crest.label else "${rarity.label} Plug-in"
+    val description: String get() = crest?.description ?: lines.joinToString(", ") { Stats.lineText(it.stat, it.value) }
+}
+
+data class Equipped(val plugin: Gear? = null, val crest: Gear? = null)
+
+object GearRoll {
+    fun roll(rng: Random, luck: Double = 0.0): Gear {
+        val id = rng.nextLong(1, Long.MAX_VALUE)
+        if (rng.nextDouble() < 0.25) return Gear(id, GearSlot.CREST, Rarity.EPIC, crest = Crest.entries.random(rng))
+        val r = rng.nextDouble() - luck
+        val rarity = when {
+            r < 0.05 -> Rarity.LEGENDARY
+            r < 0.20 -> Rarity.EPIC
+            r < 0.50 -> Rarity.RARE
+            else -> Rarity.COMMON
+        }
+        val stats = Stats.ALL.shuffled(rng).take(rarity.lines)
+        return Gear(id, GearSlot.PLUGIN, rarity, stats.map { st ->
+            val base = if (st in Stats.PERCENT) 0.04 + rng.nextInt(3) * 0.01 else 2.0 + rng.nextInt(3)
+            GearLine(st, base * rarity.power)
+        })
+    }
+
+    /** Spare gear breaks down into run coins. */
+    fun scrapValue(g: Gear) = when (g.rarity) { Rarity.COMMON -> 10; Rarity.RARE -> 15; Rarity.EPIC -> 25; Rarity.LEGENDARY -> 40 }
+}
+
+object Stats {
+    val PERCENT = setOf("hp", "atk", "def")
+    val ALL = listOf("hp", "atk", "def", "spd", "crit", "eva", "res")
+    fun label(st: String) = when (st) { "hp" -> "HP"; "atk" -> "ATK"; "def" -> "DEF"; else -> st.uppercase() }
+    fun lineText(st: String, v: Double) =
+        if (st in PERCENT) "+${(v * 100).roundToInt()}% ${label(st)}" else "+${v.roundToInt()} ${label(st)}"
+
+    /** Adds a stat bonus to [m]. */
+    fun add(m: Mods, st: String, v: Double): Mods = when (st) {
+        "hp" -> m.copy(hpMul = m.hpMul * (1 + v))
+        "atk" -> m.copy(atkMul = m.atkMul * (1 + v))
+        "def" -> m.copy(defMul = m.defMul * (1 + v))
+        "spd" -> m.copy(spd = m.spd + v)
+        "crit" -> m.copy(crit = m.crit + v)
+        "eva" -> m.copy(eva = m.eva + v)
+        "res" -> m.copy(res = m.res + v)
+        else -> m
+    }
+}
+
+// ------------------------------------------------------------------------------------------ Bits upgrades
+
+object Upgrades {
+    const val MAX = 10
+    fun cost(level: Int) = 80 + 20 * level
+    fun perLevel(st: String) = if (st in Stats.PERCENT) 0.015 else 2.0
+    const val BITS_PER_AREA = 30
+    const val BITS_FOR_CLEAR = 10
+}
+
+// ------------------------------------------------------------------------------------------ level-ups
+
+sealed class Offer {
+    abstract val text: String
+    data class NewSkill(val skill: String) : Offer() {
+        override val text get() = "Learn $skill"
+    }
+    data class Upgrade(val skill: String, val toLevel: Int) : Offer() {
+        override val text get() = "Upgrade $skill to level $toLevel (+25%)"
+    }
+    data class Boost(val stat: String, val value: Double) : Offer() {
+        override val text get() = Stats.lineText(stat, value)
+    }
+}
+
+object Growth {
+    const val LEARNED_SLOTS = 2
+    const val MAX_SKILL_LEVEL = 3
+    fun xpFor(t: NodeType) = when (t) { NodeType.ELITE -> 25; NodeType.BOSS -> 40; else -> 10 }
+    fun xpToNext(level: Int) = 10 + 4 * level
+    fun coinsFor(t: NodeType) = when (t) { NodeType.ELITE -> 25; NodeType.BOSS -> 40; else -> 12 }
+
+    /** Skill tiers unlock by area: area 1 offers 0–1 Energy skills, area 2 adds 2 Energy, area 3 adds 3 Energy. */
+    fun maxCost(area: Int) = area + 1
+
+    fun boost(stat: String, double: Boolean = false): Offer.Boost {
+        val v = if (stat in Stats.PERCENT) 0.06 else 3.0
+        return Offer.Boost(stat, if (double) v * 2 else v)
+    }
+
+    fun skillPool(field: Field?, area: Int, known: Collection<String>): List<Skill> =
+        Skills.poolFor(field).filter { it.cost <= maxCost(area) && it.name !in known }
+
+    /** Three level-up offers: a new skill, an upgrade (or a second new skill), and a stat boost. */
+    fun offers(m: Member, field: Field?, area: Int, rng: Random): List<Offer> {
+        val out = mutableListOf<Offer>()
+        val fresh = skillPool(field, area, m.skills).shuffled(rng)
+        fresh.firstOrNull()?.let { out += Offer.NewSkill(it.name) }
+        val upgradable = m.skills.filter { (m.levels[it] ?: 1) < MAX_SKILL_LEVEL }
+        if (upgradable.isNotEmpty()) {
+            val s = upgradable.random(rng); out += Offer.Upgrade(s, (m.levels[s] ?: 1) + 1)
+        } else fresh.getOrNull(1)?.let { out += Offer.NewSkill(it.name) }
+        val stats = Stats.ALL.shuffled(rng)
+        var i = 0
+        while (out.size < 3) out += boost(stats[i++])
+        return out
+    }
+
+    fun startingOffers(field: Field?, rng: Random): List<String> =
+        skillPool(field, 0, emptyList()).shuffled(rng).take(3).map { it.name }
+
+    fun apply(m: Member, o: Offer, replace: String? = null) {
+        when (o) {
+            is Offer.NewSkill -> {
+                if (replace != null) { m.skills.remove(replace); m.levels.remove(replace) }
+                if (m.skills.size < LEARNED_SLOTS) m.skills += o.skill
+            }
+            is Offer.Upgrade -> m.levels[o.skill] = o.toLevel
+            is Offer.Boost -> m.boosts[o.stat] = (m.boosts[o.stat] ?: 0.0) + o.value
+        }
+    }
+}
+
+// ------------------------------------------------------------------------------------------ enemies
+
+/** One enemy slot in a fight: which card stage to use and how strong to make it. */
+data class EnemySlot(val cardStage: Int, val scale: Double, val boss: Boolean, val minion: Boolean, val atkExtra: Double = 1.0)
+
+object EnemyPlan {
+    /**
+     * The evolution ladder: enemies start as baby forms and evolve as the run goes on, whatever your party's
+     * stage. Card stages: 1 In-Training, 2 Child, 3 Adult, 4 Perfect, 5 Ultimate.
+     */
+    fun mainStage(area: Int, row: Int, type: NodeType): Int {
+        val boss = type == NodeType.BOSS
+        val elite = type == NodeType.ELITE
+        return when (area) {
+            0 -> if (boss) 3 else if (elite || row >= 3) 2 else 1
+            1 -> if (boss || elite || row >= 4) 4 else 3
+            else -> if (boss || elite || row >= 4) 5 else 4
+        }
+    }
+
+    /**
+     * Enemies keep their own stage's strength when they're below your party, so early baby forms are easy for
+     * strong parties; enemies above your party are scaled down to your level so every run stays winnable.
+     */
+    fun slots(area: Int, row: Int, type: NodeType, partyStage: Stage): List<EnemySlot> {
+        val kind = when (type) { NodeType.ELITE -> 1; NodeType.BOSS -> 2; else -> 0 }
+        val count = Tuning.COUNT[area][kind]
+        val ramp = (0.90 + 0.03 * row) * Tuning.RUN_THREAT * Tuning.RUN_AREA[area] * Tuning.runStage(partyStage)
+        val threat = Tuning.THREAT[area][kind] * ramp
+        val main = mainStage(area, row, type)
+        return (0 until count).map { i ->
+            val minion = i >= 3
+            val boss = type == NodeType.BOSS && i == 0
+            val st = if (minion || (type == NodeType.BOSS && !boss)) maxOf(1, main - 1) else main
+            // Weaker forms stay weak (babies vs your Ultimates are easy); stronger forms are toned down to your level.
+            var scale = threat * minOf(1.0, partyStage.tier / Stage.fromCard(st).tier)
+            var atk = 1.0
+            if (minion) scale *= Tuning.MINION
+            if (boss) { scale *= Tuning.BOSS_HP; atk = Tuning.BOSS_ATK / Tuning.BOSS_HP }
+            EnemySlot(st, scale, boss, minion, atk)
+        }
+    }
+
+    /** How many learned skills enemies get, and the most Energy those skills may cost. */
+    fun skillCount(area: Int, type: NodeType) = min(2, area + if (type == NodeType.BATTLE) 0 else 1)
+}
+
+// ------------------------------------------------------------------------------------------ run state
+
+class Member(
+    val key: Long,
+    var hp: Double = 1.0,
+    val skills: MutableList<String> = mutableListOf(),
+    val levels: MutableMap<String, Int> = mutableMapOf(),
+    val boosts: MutableMap<String, Double> = mutableMapOf()
+) {
+    val alive get() = hp > 0.0
+}
+
+/** What happens at the current stop before you can move on. */
+enum class Pending { NONE, START_SKILLS, FIGHT, LEVEL_UP, REWARD, STOP, GEAR }
+
+class RunState(
+    val seed: Long,
+    val cards: List<Long>,
+    val members: List<Member>
+) {
+    var area = 0
+    var node = -1
+    var nodeType: NodeType? = null      // the current stop's type (Mystery already resolved)
+    var pending = Pending.START_SKILLS
+    var xp = 0
+    var level = 1
+    val picks = mutableListOf<Long>()   // members still owed a level-up pick, in order
+    var counter = 0                      // advances every random offer so reopening can't reroll
+    var coins = 0
+    val chips = mutableListOf<String>()
+    val friends = mutableListOf<Long>()  // befriended card Digimon (CardCharacter ids), one assist each per battle
+    var badLuck = 0
+    var gearDrop: Gear? = null
+    val bought = mutableSetOf<Int>()     // shop items bought at the current stop
+    var stopUsed = false                 // rest/dojo/treasure/shrine/befriend choice made
+    val lineages = mutableMapOf<Int, List<List<Long>>>()   // area -> evolution chains (CardCharacter ids, lowest first)
+    val seen = mutableMapOf<Int, Long>()                    // chain index -> last form fought (this area)
+    var battlesWon = 0
+    var bossesBeaten = 0
+    var bitsEarned = 0
+    var bitsPaid = 0                      // Bits already added to the shared pool
+    var clearPaid = false                 // run-clear reward already sent home
+    var rewardWins = 0                    // per Digimon, for the summary
+    var rewardMinutes = 0                 // evolution timer cut per Digimon, for the summary
+    var gearFromStop = false              // gear bought at a shop/shrine returns to that stop
+    val visited = mutableListOf<Int>()    // stops visited in this area
+    var over = false
+    var cleared = false
+    val log = mutableListOf<String>()
+
+    fun map() = RunMap.generate(seed, area)
+    fun current(): MapNode? = map().firstOrNull { it.id == node }
+
+    /** Stops you can move to next. */
+    fun choices(): List<MapNode> {
+        val m = map()
+        return if (node < 0) m.filter { it.row == 0 } else m.first { it.id == node }.next.map { id -> m.first { it.id == id } }
+    }
+
+    fun rng(): Random = Random(seed xor (++counter * 0x9E3779B97F4A7C15uL.toLong()))
+
+    fun note(t: String) { log.add(0, t); while (log.size > 30) log.removeAt(log.size - 1) }
+
+    fun mods(m: Member, equipped: Equipped?, upgrades: Map<String, Int>): Mods {
+        var mods = Mods()
+        for (id in chips) Chips.byId(id)?.let { mods = it.apply(mods) }
+        for ((st, v) in m.boosts) mods = Stats.add(mods, st, v)
+        equipped?.plugin?.lines?.forEach { mods = Stats.add(mods, it.stat, it.value) }
+        for ((st, lv) in upgrades) mods = Stats.add(mods, st, lv * Upgrades.perLevel(st))
+        return mods
+    }
+
+    fun partyStage(stages: List<Int>): Stage =
+        Stage.fromCard(stages.maxOrNull()?.coerceIn(2, 5) ?: 2)
+
+    /** Moves to [n], resolving a Mystery, and returns the stop's real type. */
+    fun enter(n: MapNode): NodeType {
+        node = n.id
+        visited += n.id
+        val t = if (n.type == NodeType.MYSTERY) RunMap.resolveMystery(seed, area, n.id) else n.type
+        nodeType = t
+        bought.clear(); stopUsed = false; gearDrop = null
+        pending = if (t.isFight) Pending.FIGHT else Pending.STOP
+        return t
+    }
+
+    /** After a fight: HP, XP, coins, gear and level-ups. [hpLeft] is each member's HP fraction (0 = deleted). */
+    fun winFight(hpLeft: List<Double>, gearRoll: (Double) -> Gear?) {
+        val t = nodeType ?: NodeType.BATTLE
+        val heal = 0.15 + if ("backup" in chips) 0.10 else 0.0
+        members.forEachIndexed { i, m ->
+            val left = hpLeft.getOrElse(i) { m.hp }
+            m.hp = if (left <= 0) 0.25 else min(1.0, left + heal)
+        }
+        battlesWon++
+        val coinGain = (Growth.coinsFor(t) * if ("miner" in chips) 1.5 else 1.0).roundToInt()
+        coins += coinGain
+        val chance = when (t) { NodeType.BOSS -> 1.0; NodeType.ELITE -> 0.15; else -> 0.05 } + 0.03 * badLuck
+        val r = rng()
+        gearDrop = if (r.nextDouble() < chance) gearRoll(0.05 * badLuck) else null
+        badLuck = if (gearDrop != null) 0 else badLuck + 1
+        val gained = gainXp(Growth.xpFor(t))
+        note("Won the ${t.label.lowercase()}: +${Growth.xpFor(t)} XP, +$coinGain coins" + (if (gained > 0) ", level ${level}!" else ""))
+        if (t == NodeType.BOSS) {
+            bossesBeaten++
+            bitsEarned += Upgrades.BITS_PER_AREA * members.size
+        }
+        pending = when {
+            picks.isNotEmpty() -> Pending.LEVEL_UP
+            gearDrop != null -> Pending.GEAR
+            else -> Pending.NONE
+        }
+    }
+
+    fun gainXp(amount: Int): Int {
+        xp += amount
+        var gained = 0
+        while (xp >= Growth.xpToNext(level)) {
+            xp -= Growth.xpToNext(level); level++; gained++
+            members.forEach { picks += it.key }
+        }
+        return gained
+    }
+
+    /** Call when the current stop is finished. Moves to the next area after a boss. */
+    fun finishStop() {
+        pending = Pending.NONE
+        if (nodeType == NodeType.BOSS) {
+            if (area >= 2) {
+                cleared = true; over = true
+                bitsEarned += Upgrades.BITS_FOR_CLEAR * members.size
+                note("Run cleared!")
+            } else {
+                area++; node = -1; nodeType = null; seen.clear(); visited.clear()
+                members.forEach { it.hp = min(1.0, it.hp + 0.30) }
+                note("Area ${area + 1} begins. The party recovers 30%.")
+            }
+        }
+    }
+
+    fun loseFight() {
+        over = true; cleared = false
+        note("The party was deleted. Run over.")
+    }
+}
+
+// ------------------------------------------------------------------------------------------ shop
+
+data class ShopItem(val index: Int, val name: String, val description: String, val price: Int, val chip: String? = null, val kind: String)
+
+object Shop {
+    fun stock(run: RunState): List<ShopItem> {
+        val rng = Random(run.seed + run.area * 131L + run.node * 7L)
+        val chips = Chips.ALL.filter { it.id !in run.chips }.shuffled(rng).take(2)
+        return listOfNotNull(
+            ShopItem(0, "Recovery Floppy", "Heal the whole party 30%", 30, kind = "heal"),
+            ShopItem(1, "Skill Disk", "One Digimon picks a new skill", 45, kind = "skill"),
+            ShopItem(2, "Plug-in Crate", "A random piece of gear", 80, kind = "gear"),
+            chips.getOrNull(0)?.let { ShopItem(3, it.name, it.description, 60, it.id, "chip") },
+            chips.getOrNull(1)?.let { ShopItem(4, it.name, it.description, 60, it.id, "chip") }
+        )
+    }
+}
+
+// ------------------------------------------------------------------------------------------ shrine
+
+data class ShrineDeal(val id: Int, val text: String)
+
+object Shrine {
+    val DEALS = listOf(
+        ShrineDeal(0, "Offer 25% of every Digimon's HP for a random data chip"),
+        ShrineDeal(1, "Offer 40 coins for a piece of gear"),
+        ShrineDeal(2, "Offer 25% of every Digimon's HP: each one upgrades a skill"),
+        ShrineDeal(3, "Pray: 50% chance of a data chip, 50% chance to lose 20% HP")
+    )
+
+    fun deals(run: RunState): List<ShrineDeal> =
+        DEALS.shuffled(Random(run.seed + run.area * 53L + run.node * 11L)).take(2)
+}
