+/**
+ * Board tap handling, Fire Emblem style: tap your Digimon to select it, a blue tile to move,
+ * an enemy to attack it (it walks into range by itself), anything else to see its details.
+ */
+private fun onTap(battle: TacticsBattle, step: Step, pos: Pos): Step {
+    if (battle.enemyPhase) return step
+    val here = battle.at(pos)
+    val mineReady = here != null && here.side == TacticsBattle.PLAYER && !here.acted
+    val enemy = here?.takeIf { it.side == TacticsBattle.ENEMY }
+
+    // Attack the tapped enemy with the basic attack, from the current tile if it reaches, else the nearest tile that does.
+    fun attack(f: Fighter, from: Pos?, target: Fighter, current: Step): Step {
+        val s = Skills.BASIC
+        val tile = if (from != null && from.dist(target.pos) <= f.skillRange(s)) from
+        else battle.reachable(f).filter { it.dist(target.pos) <= f.skillRange(s) }.minByOrNull { it.dist(from ?: f.pos) }
+        return if (tile == null) Step.Inspect(target.id, current)   // out of reach: show its details instead
+        else Step.Confirm(f.id, tile, s, target.id, battle.forecast(f, tile, s, target))
+    }
+
+    return when (step) {
+        is Step.Inspect -> onTap(battle, step.back, pos)
+        is Step.Idle -> when {
+            mineReady -> Step.Selected(here!!.id)
+            here != null -> Step.Inspect(here.id, Step.Idle)
+            else -> Step.Idle
+        }
+        is Step.Selected -> {
+            val f = battle.byId(step.unit)
+            when {
+                enemy != null -> attack(f, null, enemy, step)
+                pos in battle.reachable(f) -> Step.Moved(f.id, pos)
+                mineReady -> Step.Selected(here!!.id)
+                here != null -> Step.Inspect(here.id, step)
+                else -> Step.Idle
+            }
+        }
+        is Step.Moved -> {
+            val f = battle.byId(step.unit)
+            when {
+                enemy != null -> attack(f, step.dest, enemy, step)
+                pos in battle.reachable(f) -> Step.Moved(f.id, pos)
+                mineReady && here!!.id != f.id -> Step.Selected(here.id)
+                else -> step
+            }
+        }
+        is Step.Targeting -> {
+            val f = battle.byId(step.unit)
+            val target = battle.targetsFrom(f, step.dest, step.skill).firstOrNull { it.pos == pos }
+            if (target != null) Step.Confirm(f.id, step.dest, step.skill, target.id, battle.forecast(f, step.dest, step.skill, target))
+            else Step.Moved(f.id, step.dest)
+        }
+        is Step.Confirm -> {
+            val f = battle.byId(step.unit)
+            when {
+                // tapping another enemy in range of the same skill switches the target
+                enemy != null && enemy.pos.dist(step.dest) <= f.skillRange(step.skill) ->
+                    Step.Confirm(f.id, step.dest, step.skill, enemy.id, battle.forecast(f, step.dest, step.skill, enemy))
+                enemy != null -> attack(f, step.dest, enemy, step)
+                pos in battle.reachable(f) -> Step.Moved(f.id, pos)
+                mineReady && here!!.id != f.id -> Step.Selected(here.id)
+                else -> Step.Moved(f.id, step.dest)
+            }
+        }
+    }
+}
