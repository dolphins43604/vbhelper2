+@Composable
+@NonSkippableComposable
+private fun FightIntro(run: RunState, repo: RunRepository, party: Map<Long, TacticsDtos.Fighter>, version: Int, onFight: (FightSetup) -> Unit) {
+    val node = run.current() ?: return
+    val type = run.nodeType ?: NodeType.BATTLE
+    val scope = rememberCoroutineScope()
+    var lineup by remember(run.node, run.area) { mutableStateOf<RunRepository.Lineup?>(null) }
+    var error by remember { mutableStateOf<String?>(null) }
+    LaunchedEffect(run.node, run.area) {
+        try { lineup = repo.enemies(run, node, type) } catch (e: Exception) {
+            DebugLog.e("Rogue", "Could not build enemies", e); error = "Could not build enemies: ${e.message}"
+        }
+    }
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(10.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text("${type.icon} ${type.label}", style = MaterialTheme.typography.titleMedium)
+            error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+            val l = lineup
+            if (l == null) Text("…") else {
+                l.messages.forEach { Text("✨ $it", color = Color(0xFFFFD54F), fontWeight = FontWeight.SemiBold) }
+                Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    l.enemies.forEach { (f, spec) ->
+                        Column(horizontalAlignment = Alignment.CenterHorizontally) {
+                            SpriteImage(f.idle1, f.width, f.height, Modifier.size(44.dp), flip = false)
+                            Text(spec.name, fontSize = 10.sp)
+                            Text(spec.stage.label, fontSize = 10.sp, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                        }
+                    }
+                }
+                Button(
+                    onClick = {
+                        scope.launch {
+                            try {
+                                val team = repo.party(run)
+                                if (team.size < run.members.size) { error = "A Digimon in this run is missing from storage."; return@launch }
+                                val enemySpecs = l.enemies.map { it.second }
+                                val frames = team.associate { (f, s) -> s.key to Frames(f) } +
+                                        l.enemies.associate { (f, s) -> s.key to Frames(f) }
+                                val bg = try { repo.tactics.background(run.cards[run.area]) } catch (e: Exception) { null }
+                                val battle = TacticsBattle(team.map { it.second }, enemySpecs, run.seed + run.counter * 31L + node.id,
+                                    assistSpecs = repo.assists(run))
+                                onFight(FightSetup(battle, frames, bg, type))
+                            } catch (e: Exception) {
+                                DebugLog.e("Rogue", "Could not start the fight", e); error = "Could not start: ${e.message}"
+                            }
+                        }
+                    },
+                    modifier = Modifier.fillMaxWidth()
+                ) { Text("Fight!") }
+            }
+        }
+    }
+}
+
+@Composable
+@NonSkippableComposable
+@Suppress("UNUSED_PARAMETER")
+private fun GearPanel(run: RunState, repo: RunRepository, party: Map<Long, TacticsDtos.Fighter>, version: Int, commit: () -> Unit) {
+    val g = run.gearDrop
+    fun finish() {
+        run.gearDrop = null
+        if (run.gearFromStop) { run.gearFromStop = false; run.pending = Pending.STOP } else run.finishStop()
+        commit()
+    }
+    if (g == null) {
+        LaunchedEffect(Unit) { finish() }
+        return
+    }
+    val equipped = remember(version) { repo.loadGear() }
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(10.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text("Gear found: ${g.name}", style = MaterialTheme.typography.titleMedium, color = rarityColor(g))
+            Text("${g.slot.label} · ${g.description}", style = MaterialTheme.typography.bodySmall)
+            Text("Gear stays on the Digimon that equips it, for future runs too (roguelike only).", style = MaterialTheme.typography.bodySmall)
+            run.members.forEach { m ->
+                val f = party[m.key] ?: return@forEach
+                val cur = equipped[m.key]?.let { if (g.slot == GearSlot.CREST) it.crest else it.plugin }
+                OutlinedButton(onClick = { repo.equip(m.key, g); run.note("${repo.tactics.name(f)} equipped ${g.name}"); finish() }, modifier = Modifier.fillMaxWidth()) {
+                    Text("Equip on ${repo.tactics.name(f)}" + (cur?.let { " (replaces ${it.name})" } ?: ""), fontSize = 13.sp)
+                }
+            }
+            OutlinedButton(onClick = { run.coins += GearRoll.scrapValue(g); finish() }) { Text("Scrap for ${GearRoll.scrapValue(g)} coins") }
+        }
+    }
+}
+
+private fun rarityColor(g: Gear) = when {
+    g.crest != null -> Color(0xFFCE93D8)
+    g.rarity.name == "LEGENDARY" -> Color(0xFFFFB74D)
+    g.rarity.name == "EPIC" -> Color(0xFFBA68C8)
+    g.rarity.name == "RARE" -> Color(0xFF64B5F6)
+    else -> Color.Unspecified
+}
+
+// ------------------------------------------------------------------------------------------ other stops
+
+@Composable
+@NonSkippableComposable
+@Suppress("UNUSED_PARAMETER")
+private fun StopPanel(run: RunState, repo: RunRepository, party: Map<Long, TacticsDtos.Fighter>, version: Int, commit: () -> Unit) {
+    val type = run.nodeType ?: return
+    val node = run.current() ?: return
+    var message by remember(run.node, run.area) { mutableStateOf<String?>(null) }
+    var chosen by remember(run.node, run.area) { mutableStateOf<Long?>(null) }   // a member picked for this stop
+    var skillChoice by remember(run.node, run.area) { mutableStateOf<String?>(null) }
+    var dojoLeft by remember(run.node, run.area) { mutableIntStateOf(2) }
+    val name = { key: Long -> party[key]?.let { repo.tactics.name(it) } ?: "Digimon" }
+
+    fun leave() { run.finishStop(); commit() }
+
+    @Composable
+    fun PickMember(prompt: String, onPick: (Member) -> Unit) {
+        Text(prompt, style = MaterialTheme.typography.bodySmall)
+        run.members.forEach { m -> OutlinedButton(onClick = { onPick(m) }, modifier = Modifier.fillMaxWidth()) { Text(name(m.key)) } }
+    }
+
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(10.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text("${type.icon} ${type.label}", style = MaterialTheme.typography.titleMedium)
+            Text(type.blurb, style = MaterialTheme.typography.bodySmall)
+            message?.let { Text(it, color = Color(0xFF81C784)) }
+
+            when (type) {
+                NodeType.REST -> if (!run.stopUsed) {
+                    Button(onClick = {
+                        run.members.forEach { it.hp = minOf(1.0, it.hp + 0.40) }
+                        run.stopUsed = true; message = "Everyone healed 40%."; commit()
+                    }, modifier = Modifier.fillMaxWidth()) { Text("Rest: heal everyone 40%") }
+                    PickMember("…or train one Digimon (a free level-up pick):") { m ->
+                        run.stopUsed = true; run.picks += m.key; run.pending = Pending.LEVEL_UP; commit()
+                    }
+                }
+
+                NodeType.DOJO -> if (!run.stopUsed) {
+                    val who = chosen
+                    if (who == null) PickMember("Choose who trains (2 double-strength stat boosts):") { chosen = it.key }
+                    else {
+                        val m = run.members.first { it.key == who }
+                        val opts = remember(run.node, dojoLeft) { Stats.ALL.shuffled(Random(run.seed + run.node * 13L + dojoLeft)).take(3) }
+                        Text("${name(who)}: pick a boost ($dojoLeft left)", style = MaterialTheme.typography.bodySmall)
+                        opts.forEach { st ->
+                            val b = Growth.boost(st, double = true)
+                            OutlinedButton(onClick = {
+                                Growth.apply(m, b); dojoLeft--
+                                if (dojoLeft <= 0) { run.stopUsed = true; message = "${name(who)} finished training." }
+                                commit()
+                            }, modifier = Modifier.fillMaxWidth()) { Text(b.text) }
+                        }
+                    }
+                }
+
+                NodeType.TREASURE -> if (!run.stopUsed) {
+                    val opts = remember(run.node, run.area) { Chips.ALL.filter { it.id !in run.chips }.shuffled(Random(run.seed + run.area * 17L + run.node)).take(3) }
+                    Text("Data chips last the whole run and affect all 3 Digimon.", style = MaterialTheme.typography.bodySmall)
+                    opts.forEach { c ->
+                        OutlinedButton(onClick = { run.chips += c.id; run.stopUsed = true; message = "Got ${c.name}."; commit() }, modifier = Modifier.fillMaxWidth()) {
+                            Column(Modifier.fillMaxWidth()) {
+                                Text(c.name, fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                                Text(c.description, fontSize = 12.sp)
+                            }
+                        }
+                    }
+                }
+
+                NodeType.SHOP -> {
+                    Text("Coins: ${run.coins}", fontWeight = FontWeight.SemiBold)
+                    val disk = skillChoice
+                    val who = chosen
+                    if (disk == "pick") {
+                        if (who == null) PickMember("Who uses the Skill Disk?") { chosen = it.key }
+                        else {
+                            val m = run.members.first { it.key == who }
+                            val f = party[who]
+                            val opts = remember(who, run.node) {
+                                Growth.skillPool(f?.let { repo.tactics.field(it) }, run.area, m.skills).shuffled(Random(run.seed + run.node * 5L + who)).take(3)
+                            }
+                            var learn by remember(who) { mutableStateOf<String?>(null) }
+                            val l = learn
+                            if (l != null) LearnSkill(m, l, onDone = {
+                                run.coins -= 45; run.bought += 1; skillChoice = null; chosen = null; message = "${name(who)} learned $l."; commit()
+                            }, onCancel = { learn = null })
+                            else opts.forEach { s ->
+                                OutlinedButton(onClick = { learn = s.name }, modifier = Modifier.fillMaxWidth()) {
+                                    Column(Modifier.fillMaxWidth()) {
+                                        Text("${s.name} · ${if (s.cost == 0) "free" else "${s.cost} Energy"}", fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                                        Text(s.description, fontSize = 12.sp)
+                                    }
+                                }
+                            }
+                        }
+                        OutlinedButton(onClick = { skillChoice = null; chosen = null }) { Text("Back") }
+                    } else Shop.stock(run).forEach { item ->
+                        val sold = item.index in run.bought
+                        OutlinedButton(
+                            onClick = {
+                                when (item.kind) {
+                                    "heal" -> { run.coins -= item.price; run.bought += item.index; run.members.forEach { it.hp = minOf(1.0, it.hp + 0.30) }; message = "Party healed 30%." }
+                                    "chip" -> { run.coins -= item.price; run.bought += item.index; item.chip?.let { run.chips += it }; message = "Got ${item.name}." }
+                                    "gear" -> {
+                                        run.coins -= item.price; run.bought += item.index
+                                        run.gearDrop = GearRoll.roll(run.rng()); run.gearFromStop = true; run.pending = Pending.GEAR
+                                    }
+                                    "skill" -> skillChoice = "pick"
+                                }
+                                commit()
+                            },
+                            enabled = !sold && run.coins >= item.price,
+                            modifier = Modifier.fillMaxWidth()
+                        ) {
+                            Column(Modifier.fillMaxWidth()) {
+                                Text("${item.name} · ${if (sold) "sold" else "${item.price} coins"}", fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                                Text(item.description, fontSize = 12.sp)
+                            }
+                        }
+                    }
+                }
+
+                NodeType.BEFRIEND -> if (!run.stopUsed) {
+                    var wild by remember(run.node, run.area) { mutableStateOf<TacticsDtos.Fighter?>(null) }
+                    LaunchedEffect(run.node, run.area) { wild = repo.wild(run, node) }
+                    val w = wild
+                    if (w == null) Text("…") else {
+                        val field = repo.tactics.field(w)
+                        Row(verticalAlignment = Alignment.CenterVertically) {
+                            SpriteImage(w.idle1, w.width, w.height, Modifier.size(48.dp), flip = false)
+                            Spacer(Modifier.width(8.dp))
+                            Text("A wild ${repo.tactics.name(w)} (${field?.label ?: "No Field"}) wants to help.", fontSize = 13.sp)
+                        }
+                        val who = chosen
+                        if (who == null) {
+                            Button(onClick = {
+                                run.friends += w.unitKey; run.stopUsed = true; message = "${repo.tactics.name(w)} will assist once per battle."; commit()
+                            }, modifier = Modifier.fillMaxWidth()) { Text("Assist: it jumps in for one attack each battle") }
+                            PickMember("…or Teach: one of your Digimon learns a skill from its Field:") { chosen = it.key }
+                        } else {
+                            val m = run.members.first { it.key == who }
+                            val opts = remember(who, run.node) {
+                                Growth.skillPool(field, run.area, m.skills).filter { !it.generic }.shuffled(Random(run.seed + run.node + who)).take(2)
+                            }
+                            var learn by remember(who) { mutableStateOf<String?>(null) }
+                            val l = learn
+                            if (l != null) LearnSkill(m, l, onDone = { run.stopUsed = true; message = "${name(who)} learned $l."; commit() }, onCancel = { learn = null })
+                            else {
+                                if (opts.isEmpty()) Text("Nothing new to teach.", style = MaterialTheme.typography.bodySmall)
+                                opts.forEach { s ->
+                                    OutlinedButton(onClick = { learn = s.name }, modifier = Modifier.fillMaxWidth()) {
+                                        Column(Modifier.fillMaxWidth()) {
+                                            Text("${s.name} · ${if (s.cost == 0) "free" else "${s.cost} Energy"}", fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                                            Text(s.description, fontSize = 12.sp)
+                                        }
+                                    }
+                                }
+                                OutlinedButton(onClick = { chosen = null }) { Text("Back") }
+                            }
+                        }
+                    }
+                }
+
+                NodeType.SHRINE -> if (!run.stopUsed) {
+                    Shrine.deals(run).forEach { d ->
+                        val enabled = d.id != 1 || run.coins >= 40
+                        OutlinedButton(onClick = {
+                            val rng = run.rng()
+                            fun chip(): String? = Chips.ALL.filter { it.id !in run.chips }.randomOrNull(rng)?.also { run.chips += it.id }?.name
+                            run.stopUsed = true
+                            when (d.id) {
+                                0 -> { run.members.forEach { it.hp = maxOf(0.05, it.hp - 0.25) }; message = chip()?.let { "The shrine grants $it." } ?: "Nothing left to give." }
+                                1 -> { run.coins -= 40; run.gearDrop = GearRoll.roll(rng, 0.1); run.pending = Pending.GEAR }
+                                2 -> {
+                                    run.members.forEach { it.hp = maxOf(0.05, it.hp - 0.25) }
+                                    run.members.forEach { m ->
+                                        m.skills.filter { (m.levels[it] ?: 1) < Growth.MAX_SKILL_LEVEL }.randomOrNull(rng)?.let { s -> m.levels[s] = (m.levels[s] ?: 1) + 1 }
+                                    }
+                                    message = "Every Digimon's skills grow stronger."
+                                }
+                                else -> if (rng.nextBoolean()) message = chip()?.let { "Blessed: $it." } ?: "Blessed, but nothing left to give."
+                                else { run.members.forEach { it.hp = maxOf(0.05, it.hp - 0.20) }; message = "Cursed: everyone lost 20% HP." }
+                            }
+                            commit()
+                        }, enabled = enabled, modifier = Modifier.fillMaxWidth()) { Text(d.text, fontSize = 13.sp) }
+                    }
+                }
+
+                else -> {}
+            }
+
+            Button(onClick = { leave() }, modifier = Modifier.fillMaxWidth()) {
+                Text(if (run.stopUsed || type == NodeType.SHOP) "Continue" else "Skip and continue")
+            }
+        }
+    }
+}
+
+// ------------------------------------------------------------------------------------------ end of run
+
+@Composable
+@NonSkippableComposable
+@Suppress("UNUSED_PARAMETER")
+private fun RunOver(run: RunState, version: Int, onFinished: () -> Unit) {
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(12.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text(if (run.cleared) "Run cleared! 🏆" else "Run over", style = MaterialTheme.typography.titleLarge)
+            Text("Reached area ${run.area + 1} · level ${run.level} · ${run.battlesWon} battles won · ${run.bossesBeaten} bosses beaten")
+            Text("Bits earned: ${run.bitsEarned} (spend them on permanent roguelike upgrades)")
+            Text("Sent home to each Digimon: +${run.rewardWins} wins, −${run.rewardMinutes} min evolution timer" +
+                    if (run.bossesBeaten > 0) ", +${run.bossesBeaten} trophies" else "", style = MaterialTheme.typography.bodySmall)
+            Button(onClick = onFinished, modifier = Modifier.fillMaxWidth()) { Text("Done") }
+        }
+    }
+}
+
+// ------------------------------------------------------------------------------------------ Bits upgrades
+
+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun UpgradesPanel(repo: RunRepository, onClose: () -> Unit) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val storage = remember { StorageRepository(application.container.db) }
+    var everyone by remember { mutableStateOf<List<CharacterDtos.CharacterWithSprites>>(emptyList()) }
+    var state by remember { mutableStateOf(repo.loadUpgrades()) }
+    var who by remember { mutableStateOf<Long?>(null) }
+    LaunchedEffect(Unit) { everyone = storage.getAllCharacters().first().filter { it.stage >= 2 } }
+
+    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text("Bits upgrades", style = MaterialTheme.typography.titleLarge, modifier = Modifier.padding(top = 8.dp))
+        Text("${state.bits} Bits. Each level: +1.5% HP, ATK or DEF, or +2 SPD, CRIT, EVA or RES, up to 10 levels. " +
+                "Roguelike only: nothing changes on the bracelet.", style = MaterialTheme.typography.bodySmall)
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            everyone.forEach { c ->
+                FilterChip(selected = who == c.id, onClick = { who = c.id },
+                    label = { SpriteImage(c.spriteIdle, c.spriteWidth, c.spriteHeight, Modifier.size(36.dp), flip = true) })
+            }
+        }
+        val k = who
+        if (k == null) Text("Pick a Digimon above.", style = MaterialTheme.typography.bodySmall)
+        else Stats.ALL.forEach { st ->
+            val lv = state.levels[k]?.get(st) ?: 0
+            val cost = Upgrades.cost(lv)
+            Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.fillMaxWidth()) {
+                Text("${Stats.label(st)} Lv $lv/${Upgrades.MAX} (${Stats.lineText(st, lv * Upgrades.perLevel(st))})", modifier = Modifier.weight(1f), fontSize = 13.sp)
+                OutlinedButton(onClick = { if (repo.buyUpgrade(k, st)) state = repo.loadUpgrades() },
+                    enabled = lv < Upgrades.MAX && state.bits >= cost) { Text(if (lv >= Upgrades.MAX) "Max" else "$cost Bits", fontSize = 12.sp) }
+            }
+        }
+        OutlinedButton(onClick = onClose, modifier = Modifier.fillMaxWidth()) { Text("Back") }
+        Spacer(Modifier.height(24.dp))
+    }
+}
