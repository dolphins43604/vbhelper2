+package com.github.nacabaro.vbhelper.dtos
+
+import com.github.cfogrady.vbnfc.data.NfcCharacter
+
+object ForgeDtos {
+    /**
+     * One Digimon that exists on an imported card, with its idle sprite,
+     * used by the Create Digimon picker.
+     */
+    data class CardCharacterOption(
+        val id: Long,
+        val charaIndex: Int,
+        val stage: Int,
+        val attribute: NfcCharacter.Attribute,
+        val spriteIdle: ByteArray,
+        val spriteWidth: Int,
+        val spriteHeight: Int,
+        val nameSprite: ByteArray,
+        val nameWidth: Int,
+        val nameHeight: Int
+    ) {
+        override fun equals(other: Any?): Boolean {
+            if (this === other) return true
+            if (javaClass != other?.javaClass) return false
+            other as CardCharacterOption
+            return id == other.id
+        }
+
+        override fun hashCode(): Int = id.hashCode()
+    }
+}
