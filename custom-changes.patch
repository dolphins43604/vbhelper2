@@ -0,0 +1,123 @@
+package com.github.nacabaro.vbhelper.source
+
+import android.content.Context
+import com.github.cfogrady.vbnfc.data.NfcCharacter
+import com.github.nacabaro.vbhelper.database.AppDatabase
+import com.github.nacabaro.vbhelper.dtos.TacticsDtos
+import com.github.nacabaro.vbhelper.roguelike.Attr
+import com.github.nacabaro.vbhelper.roguelike.Field
+import com.github.nacabaro.vbhelper.roguelike.FighterSpec
+import com.github.nacabaro.vbhelper.roguelike.Skill
+import com.github.nacabaro.vbhelper.roguelike.Skills
+import com.github.nacabaro.vbhelper.roguelike.Stage
+import com.github.nacabaro.vbhelper.roguelike.Tuning
+import com.github.nacabaro.vbhelper.utils.DebugLog
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+import kotlin.math.abs
+import kotlin.random.Random
+
+/**
+ * Builds tactics-battle fighters from stored Digimon and imported cards. Names and Fields come from the
+ * metadata pack (assets/rogue_metadata.json), keyed by DIM id and card slot.
+ */
+class TacticsRepository(context: Context, db: AppDatabase) {
+    private val dao = db.tacticsDao()
+    private val meta: Map<String, Pair<String, String>> = loadMeta(context)
+
+    enum class StopKind(val label: String) { BATTLE("Battle"), ELITE("Elite"), BOSS("Boss") }
+
+    private fun loadMeta(context: Context): Map<String, Pair<String, String>> = try {
+        val text = context.applicationContext.assets.open("rogue_metadata.json").bufferedReader().use { it.readText() }
+        val json = JSONObject(text)
+        json.keys().asSequence().associateWith { k ->
+            val arr = json.getJSONArray(k)
+            arr.getString(0) to arr.getString(1)
+        }
+    } catch (e: Exception) {
+        DebugLog.e("Tactics", "Could not read the metadata pack: ${e.message}")
+        emptyMap()
+    }
+
+    fun name(f: TacticsDtos.Fighter): String =
+        (if (!f.isBem) meta["${f.dimId}:${f.charaIndex}"]?.first else null) ?: "Digimon #${f.charaIndex}"
+
+    fun field(f: TacticsDtos.Fighter): Field? =
+        if (f.isBem) null else Field.fromCode(meta["${f.dimId}:${f.charaIndex}"]?.second)
+
+    fun attr(a: NfcCharacter.Attribute): Attr = when (a) {
+        NfcCharacter.Attribute.Vaccine -> Attr.VACCINE
+        NfcCharacter.Attribute.Data -> Attr.DATA
+        NfcCharacter.Attribute.Virus -> Attr.VIRUS
+        else -> Attr.FREE
+    }
+
+    suspend fun stored(id: Long): TacticsDtos.Fighter? = withContext(Dispatchers.IO) { dao.getStored(id) }
+
+    suspend fun cards(): List<TacticsDtos.CardOption> = withContext(Dispatchers.IO) { dao.getCards() }
+
+    suspend fun background(cardId: Long) = withContext(Dispatchers.IO) { dao.getBackground(cardId) }
+
+    fun spec(f: TacticsDtos.Fighter, skills: List<Skill>, hpScale: Double = 1.0, atkScale: Double = 1.0): FighterSpec {
+        val battles = f.wins + f.losses
+        return FighterSpec(
+            key = f.unitKey,
+            name = name(f),
+            stage = Stage.fromCard(f.stage),
+            attr = attr(f.attribute),
+            field = field(f),
+            hp = f.hp, ap = f.ap, dp = f.dp,
+            battles = battles,
+            winRatio = if (battles > 0) f.wins.toDouble() / battles else 0.5,
+            vitals = f.vitals,
+            skills = skills,
+            hpScale = hpScale,
+            atkScale = atkScale
+        )
+    }
+
+    /**
+     * Enemy lineup for one stop, the same rules as the simulator: area 1 mixes your stage and one below,
+     * every enemy past the third is a weaker minion, and bosses get extra HP and ATK.
+     */
+    suspend fun enemies(
+        cardId: Long,
+        partyStage: Stage,
+        area: Int,
+        kind: StopKind,
+        random: Random
+    ): List<Pair<TacticsDtos.Fighter, FighterSpec>> = withContext(Dispatchers.IO) {
+        val pool = dao.getCardUnits(cardId)
+        if (pool.isEmpty()) return@withContext emptyList()
+        val si = partyStage.ordinal
+        val threat = Tuning.THREAT[area][kind.ordinal]
+        val stageThreat = if (partyStage == Stage.ULTIMATE) 1.04 else if (partyStage == Stage.ADULT) 0.97 else 1.0
+        val count = Tuning.COUNT[area][kind.ordinal]
+        (0 until count).map { i ->
+            var s = si
+            var hpScale = threat * stageThreat
+            var atkScale = threat * stageThreat
+            if (area == 0 && i % 2 == 0) s = maxOf(0, si - 1)
+            if (i >= 3) {
+                s = maxOf(0, si - 1); hpScale *= Tuning.MINION; atkScale *= Tuning.MINION
+            }
+            if (kind == StopKind.BOSS && i == 0) {
+                s = minOf(3, si + if (area == 2) 1 else 0)
+                hpScale *= Tuning.BOSS_HP; atkScale *= Tuning.BOSS_ATK
+                if (area == 2 && si == 3) { hpScale *= 1.3; atkScale *= 1.3 }
+            }
+            val pick = pickAtStage(pool, s, random)
+            val skillCount = minOf(2, area + if (kind != StopKind.BATTLE) 1 else 0)
+            val skills = Skills.poolFor(field(pick)).filter { !it.generic }.shuffled(random).take(skillCount)
+            pick to spec(pick, skills, hpScale, atkScale)
+        }
+    }
+
+    /** A card Digimon at the wanted stage, or the closest stage the card has. */
+    private fun pickAtStage(pool: List<TacticsDtos.Fighter>, stageIndex: Int, random: Random): TacticsDtos.Fighter {
+        val byStage = pool.groupBy { Stage.fromCard(it.stage).ordinal }
+        val best = byStage.keys.minBy { abs(it - stageIndex) }
+        return byStage.getValue(best).random(random)
+    }
+}
