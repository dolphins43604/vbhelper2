+                        val team = members.map { f -> repo.spec(f, (picks[f.unitKey] ?: emptyList()).mapNotNull { Skills.byName(it) }) }
+                        val foes = repo.enemies(cardId!!, stage, area, kind, Random(System.nanoTime()))
