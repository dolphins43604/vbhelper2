@@ -0,0 +1,95 @@
+package com.github.nacabaro.vbhelper.screens.offlineBattle
+
+import com.github.cfogrady.vbnfc.data.NfcCharacter
+import com.github.nacabaro.vbhelper.dtos.OfflineBattleDtos
+import kotlin.math.abs
+import kotlin.random.Random
+
+/**
+ * Offline battle rules. These are this app's own rules, not the bracelet's
+ * exact formula: stats are compared as ratios between the two fighters, so a
+ * fight is fair whatever scale a card uses for its numbers.
+ *
+ *  - HP decides how many hits a fighter can take.
+ *  - AP decides how hard it hits.
+ *  - BP (DP on DIM cards) decides how often it hits and dodges.
+ *  - Your timing on the power meter can turn a hit into a critical (x1.6).
+ */
+data class FighterStats(
+    val name: String,
+    val hp: Int,
+    val ap: Int,
+    val bp: Int,
+    val sprites: Sprites
+) {
+    data class Sprites(
+        val idle1: ByteArray,
+        val idle2: ByteArray,
+        val attack: ByteArray,
+        val dodge: ByteArray,
+        val width: Int,
+        val height: Int
+    )
+}
+
+object BattleEngine {
+    const val CRIT_MULTIPLIER = 1.6
+
+    /** Your Digimon's battle stats: card stats + BE training + small vitals/mood effects. */
+    fun fromMine(f: OfflineBattleDtos.MyFighter): FighterStats {
+        val vitalsBonus = 1.0 + (f.vitalPoints / 500).coerceAtMost(20) / 100.0   // up to +20% AP
+        val moodFactor = 0.9 + (f.mood.coerceIn(0, 100) / 100.0) * 0.2            // 0.9 .. 1.1
+        val injured = f.injuryStatus != NfcCharacter.InjuryStatus.None
+        val injuryFactor = if (injured) 0.85 else 1.0
+        return FighterStats(
+            name = "You",
+            hp = ((f.baseHp + f.trainingHp).coerceAtLeast(1) * injuryFactor).toInt().coerceAtLeast(1),
+            ap = ((f.baseAp + f.trainingAp).coerceAtLeast(1) * vitalsBonus * moodFactor).toInt().coerceAtLeast(1),
+            bp = (f.baseBp + f.trainingBp).coerceAtLeast(1),
+            sprites = FighterStats.Sprites(f.idle1, f.idle2, f.attack, f.dodge, f.width, f.height)
+        )
+    }
+
+    fun fromCpu(c: OfflineBattleDtos.CpuFighter, multiplier: Double = 1.0, hpMultiplier: Double = 1.0) =
+        FighterStats(
+            name = c.cardName,
+            hp = (c.hp.coerceAtLeast(1) * multiplier * hpMultiplier).toInt().coerceAtLeast(1),
+            ap = (c.ap.coerceAtLeast(1) * multiplier).toInt().coerceAtLeast(1),
+            bp = (c.bp.coerceAtLeast(1) * multiplier).toInt().coerceAtLeast(1),
+            sprites = FighterStats.Sprites(c.idle1, c.idle2, c.attack, c.dodge, c.width, c.height)
+        )
+
+    /** Rough strength, used to order arena opponents from easiest to hardest. */
+    fun power(hp: Int, ap: Int, bp: Int): Double = hp * 1.0 + ap * 1.5 + bp * 1.2
+
+    /** Battle HP bars: both sides average 100 HP, scaled by their HP stat. */
+    fun battleHp(mine: FighterStats, other: FighterStats): Pair<Int, Int> {
+        val avg = (mine.hp + other.hp) / 2.0
+        return (100 * mine.hp / avg).toInt().coerceAtLeast(20) to (100 * other.hp / avg).toInt().coerceAtLeast(20)
+    }
+
+    data class Hit(val landed: Boolean, val damage: Int, val critical: Boolean)
+
+    /**
+     * One attack. [timing] is 0..1 from the power meter (1 = perfect),
+     * or null for the computer, which gets an average swing.
+     */
+    fun attack(attacker: FighterStats, defender: FighterStats, timing: Double?, random: Random = Random): Hit {
+        val bpShare = attacker.bp.toDouble() / (attacker.bp + defender.bp)
+        val hitChance = (0.45 + 0.45 * bpShare + (timing?.let { (it - 0.5) * 0.2 } ?: 0.0)).coerceIn(0.3, 0.92)
+        if (random.nextDouble() > hitChance) return Hit(false, 0, false)
+
+        val apShare = attacker.ap.toDouble() / ((attacker.ap + defender.ap) / 2.0)   // ~1.0 when even
+        val critical = when (timing) {
+            null -> random.nextDouble() < 0.08
+            else -> timing >= 0.85
+        }
+        var damage = 16.0 * apShare * (0.85 + random.nextDouble() * 0.3)
+        if (timing != null) damage *= 0.85 + timing * 0.3
+        if (critical) damage *= CRIT_MULTIPLIER
+        return Hit(true, damage.toInt().coerceAtLeast(1), critical)
+    }
+
+    /** Converts the meter position (0..1, sweeping back and forth) into timing quality. */
+    fun timingQuality(meterPosition: Float): Double = 1.0 - abs(meterPosition - 0.5) * 2.0
+}
