+package com.github.nacabaro.vbhelper.daos
+
+import androidx.room.Dao
+import androidx.room.Insert
+import androidx.room.Query
+import com.github.nacabaro.vbhelper.domain.card.Background
+import com.github.nacabaro.vbhelper.dtos.TacticsDtos
+
+@Dao
+interface TacticsDao {
+    /** A stored Digimon with its card slot, stats, bracelet history and battle sprites. */
+    @Query(
+        """
+        SELECT
+            uc.id AS unitKey,
+            c.cardId AS dimId,
+            cc.charaIndex AS charaIndex,
+            cc.stage AS stage,
+            cc.attribute AS attribute,
+            cc.baseHp AS hp,
+            cc.baseAp AS ap,
+            cc.baseBp AS dp,
+            uc.vitalPoints AS vitals,
+            uc.totalBattlesWon AS wins,
+            uc.totalBattlesLost AS losses,
+            c.isBEm AS isBem,
+            s.spriteIdle1 AS idle1,
+            s.spriteIdle2 AS idle2,
+            s.spriteWalk1 AS walk1,
+            s.spriteWalk2 AS walk2,
+            s.spriteAttack AS attack,
+            s.spriteDodge AS dodge,
+            s.spriteHappy AS happy,
+            s.spriteSleep AS sleep,
+            s.width AS width,
+            s.height AS height
+        FROM UserCharacter uc
+        JOIN CardCharacter cc ON uc.charId = cc.id
+        JOIN Card c ON c.id = cc.cardId
+        JOIN Sprite s ON s.id = cc.spriteId
+        WHERE uc.id = :userCharacterId
+    """
+    )
+    suspend fun getStored(userCharacterId: Long): TacticsDtos.Fighter?
+
+    /** Every battle-stage Digimon on one imported card, used as enemies. */
+    @Query(
+        """
+        SELECT
+            cc.id AS unitKey,
+            c.cardId AS dimId,
+            cc.charaIndex AS charaIndex,
+            cc.stage AS stage,
+            cc.attribute AS attribute,
+            cc.baseHp AS hp,
+            cc.baseAp AS ap,
+            cc.baseBp AS dp,
+            0 AS vitals,
+            0 AS wins,
+            0 AS losses,
+            c.isBEm AS isBem,
+            s.spriteIdle1 AS idle1,
+            s.spriteIdle2 AS idle2,
+            s.spriteWalk1 AS walk1,
+            s.spriteWalk2 AS walk2,
+            s.spriteAttack AS attack,
+            s.spriteDodge AS dodge,
+            s.spriteHappy AS happy,
+            s.spriteSleep AS sleep,
+            s.width AS width,
+            s.height AS height
+        FROM CardCharacter cc
+        JOIN Card c ON c.id = cc.cardId
+        JOIN Sprite s ON s.id = cc.spriteId
+        WHERE cc.cardId = :cardId AND cc.stage >= 2 AND cc.baseHp > 0
+    """
+    )
+    suspend fun getCardUnits(cardId: Long): List<TacticsDtos.Fighter>
+
+    /** Imported cards that have battle-stage Digimon. */
+    @Query(
+        """
+        SELECT c.id AS id, c.name AS name, c.isBEm AS isBem, COUNT(cc.id) AS fighters
+        FROM Card c
+        JOIN CardCharacter cc ON cc.cardId = c.id
+        WHERE cc.stage >= 2 AND cc.baseHp > 0
+        GROUP BY c.id
+        ORDER BY c.name
+    """
+    )
+    suspend fun getCards(): List<TacticsDtos.CardOption>
+
+    /** Every Digimon on a card, baby forms included (the run's evolution ladder). */
+    @Query(
+        """
+        SELECT
+            cc.id AS unitKey,
+            c.cardId AS dimId,
+            cc.charaIndex AS charaIndex,
+            cc.stage AS stage,
+            cc.attribute AS attribute,
+            cc.baseHp AS hp,
+            cc.baseAp AS ap,
+            cc.baseBp AS dp,
+            0 AS vitals,
+            0 AS wins,
+            0 AS losses,
+            c.isBEm AS isBem,
+            s.spriteIdle1 AS idle1,
+            s.spriteIdle2 AS idle2,
+            s.spriteWalk1 AS walk1,
+            s.spriteWalk2 AS walk2,
+            s.spriteAttack AS attack,
+            s.spriteDodge AS dodge,
+            s.spriteHappy AS happy,
+            s.spriteSleep AS sleep,
+            s.width AS width,
+            s.height AS height
+        FROM CardCharacter cc
+        JOIN Card c ON c.id = cc.cardId
+        JOIN Sprite s ON s.id = cc.spriteId
+        WHERE cc.cardId = :cardId AND cc.stage >= 1
+    """
+    )
+    suspend fun getCardAll(cardId: Long): List<TacticsDtos.Fighter>
+
+    /** Evolutions between Digimon on one card. */
+    @Query(
+        """
+        SELECT pt.charaId AS fromId, pt.toCharaId AS toId
+        FROM PossibleTransformations pt
+        JOIN CardCharacter cc ON cc.id = pt.charaId
+        WHERE cc.cardId = :cardId AND pt.toCharaId IS NOT NULL
+    """
+    )
+    suspend fun getEvolutions(cardId: Long): List<TacticsDtos.Evo>
+
+    // ---- run rewards that go home to the real Digimon
+
+    @Query(
+        """
+        UPDATE UserCharacter SET
+            currentPhaseBattlesWon = MIN(currentPhaseBattlesWon + 1, 999),
+            totalBattlesWon = MIN(totalBattlesWon + 1, 999)
+        WHERE id = :userCharacterId
+    """
+    )
+    suspend fun addWin(userCharacterId: Long)
+
+    @Query("UPDATE UserCharacter SET trophies = MIN(trophies + 1, 999) WHERE id = :userCharacterId")
+    suspend fun addTrophy(userCharacterId: Long)
+
+    /** Cuts the evolution timer, never below 1 minute on a VB (0 on a BE), and never raises it. */
+    @Query(
+        """
+        UPDATE UserCharacter SET transformationCountdown =
+            CASE
+                WHEN transformationCountdown - :minutes < (CASE WHEN characterType = 'BEDevice' THEN 0 ELSE 1 END)
+                THEN MIN(transformationCountdown, CASE WHEN characterType = 'BEDevice' THEN 0 ELSE 1 END)
+                ELSE transformationCountdown - :minutes
+            END
+        WHERE id = :userCharacterId
+    """
+    )
+    suspend fun cutTimer(userCharacterId: Long, minutes: Int)
+
+    /** The card's own background art (saved on import), drawn behind the tactics board. */
+    @Query("SELECT * FROM Background WHERE cardId = :cardId ORDER BY id LIMIT 1")
+    suspend fun getBackground(cardId: Long): Background?
+
+    @Query("SELECT COUNT(*) FROM Background WHERE cardId = :cardId")
+    suspend fun countBackgrounds(cardId: Long): Int
+
+    @Insert
+    suspend fun insertBackground(background: Background)
+}
