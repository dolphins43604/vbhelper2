+@Composable
+private fun Board(
+    battle: TacticsBattle,
+    frames: Map<Long, Frames>,
+    step: Step,
+    poses: Map<Int, Pose>,
+    popups: Map<Int, String>,
+    frame: Int,
+    tick: Int,
+    onTap: (Pos) -> Unit
+) {
+    val selected: Fighter? = when (step) {
+        is Step.Selected -> battle.byId(step.unit)
+        is Step.Moved -> battle.byId(step.unit)
+        is Step.Targeting -> battle.byId(step.unit)
+        is Step.Confirm -> battle.byId(step.unit)
+        else -> null
+    }
+    val moveTiles: Set<Pos> = if (step is Step.Selected || step is Step.Moved) selected?.let { battle.reachable(it) } ?: emptySet() else emptySet()
+    val dest: Pos? = when (step) {
+        is Step.Moved -> step.dest
+        is Step.Targeting -> step.dest
+        is Step.Confirm -> step.dest
+        else -> null
+    }
+    val attackTiles: Set<Pos> = when {
+        step is Step.Targeting && selected != null -> battle.targetsFrom(selected, step.dest, step.skill).map { it.pos }.toSet()
+        step is Step.Confirm -> setOf(battle.byId(step.target).pos)
+        // enemies the selected Digimon can reach with its basic attack this turn
+        (step is Step.Selected || step is Step.Moved) && selected != null -> {
+            val reach = battle.reachable(selected)
+            battle.side(TacticsBattle.ENEMY).filter { e -> reach.any { it.dist(e.pos) <= selected.skillRange(Skills.BASIC) } }
+                .map { it.pos }.toSet()
+        }
+        else -> emptySet()
+    }
+    val intended: Set<Int> = battle.intents.mapNotNull { it.targetId }.toSet()
+    val letters = battle.fighters.filter { it.side == TacticsBattle.PLAYER }.mapIndexed { i, f -> f.id to "ABC"[i % 3] }.toMap()
+
+    BoxWithConstraints(Modifier.fillMaxWidth()) {
+        val cell = maxWidth / TacticsBattle.W
+        Column {
+            for (y in 0 until TacticsBattle.H) {
+                Row {
+                    for (x in 0 until TacticsBattle.W) {
+                        val p = Pos(x, y)
+                        // A unit being moved is drawn on its destination tile.
+                        val unit = if (selected != null && dest == p) selected
+                        else battle.at(p)?.takeIf { !(it === selected && dest != null && dest != p) }
+                        val bg = when {
+                            p in attackTiles -> Color(0x55E53935)
+                            p == dest -> Color(0x5542A5F5)
+                            p in moveTiles -> Color(0x3342A5F5)
+                            (x + y) % 2 == 0 -> MaterialTheme.colorScheme.surfaceVariant
+                            else -> MaterialTheme.colorScheme.surface
+                        }
+                        Box(
+                            Modifier
+                                .size(cell)
+                                .background(bg)
+                                .border(BorderStroke(if (unit != null && unit === selected) 2.dp else 0.5.dp,
+                                    if (unit != null && unit === selected) Color(0xFFFFC107) else Color(0x22000000)))
+                                .clickable { onTap(p) },
+                            contentAlignment = Alignment.Center
+                        ) {
+                            if (unit != null) UnitCell(unit, frames[unit.spec.key], poses[unit.id], popups[unit.id], frame,
+                                letter = letters[unit.id], targeted = unit.id in intended, intent = battle.intents.firstOrNull { it.enemyId == unit.id }?.let { i ->
+                                    val tl = i.targetId?.let { letters[it] }
+                                    when {
+                                        tl == null -> "🛡"
+                                        i.skill == "Signature" -> "★$tl"
+                                        else -> "⚔$tl"
+                                    }
+                                })
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun UnitCell(
+    f: Fighter,
+    frames: Frames?,
+    pose: Pose?,
+    popup: String?,
+    frame: Int,
+    letter: Char?,
+    targeted: Boolean,
+    intent: String?
+) {
+    Box(Modifier.fillMaxSize()) {
+        if (frames != null) {
+            val d = frames.f
+            val bytes = when {
+                !f.alive -> d.sleep
+                pose == Pose.ATTACK -> d.attack
+                pose == Pose.DODGE -> d.dodge
+                pose == Pose.HAPPY -> d.happy
+                pose == Pose.WALK -> if (frame % 2 == 0) d.walk1 else d.walk2
+                else -> if (frame % 2 == 0) d.idle1 else d.idle2
+            }
+            SpriteImage(bytes, d.width, d.height, Modifier.fillMaxSize().padding(4.dp), flip = f.side == TacticsBattle.PLAYER)
+        }
+        // HP bar along the bottom, green for your side, red for enemies
+        LinearProgressIndicator(
+            progress = { (f.hp / f.maxHp).toFloat().coerceIn(0f, 1f) },
+            color = if (f.side == TacticsBattle.PLAYER) Color(0xFF43A047) else Color(0xFFE53935),
+            modifier = Modifier
+                .align(Alignment.BottomCenter)
+                .fillMaxWidth()
+                .height(4.dp)
+        )
+        if (f.shield > 0) Text("◆", color = Color(0xFF42A5F5), fontSize = 10.sp, modifier = Modifier.align(Alignment.BottomEnd).padding(bottom = 4.dp))
+        val tags = buildString {
+            if (letter != null) append(letter)
+            if (targeted) append("!")
+            if (f.acted && f.side == TacticsBattle.PLAYER && f.alive) append("✓")
+        }
+        if (tags.isNotEmpty()) Text(tags, fontSize = 10.sp, fontWeight = FontWeight.Bold,
+            color = if (targeted) Color(0xFFE53935) else MaterialTheme.colorScheme.onSurface, modifier = Modifier.align(Alignment.TopStart).padding(2.dp))
+        if (intent != null && f.alive) Text(intent, fontSize = 10.sp, color = Color(0xFFE53935), modifier = Modifier.align(Alignment.TopEnd).padding(2.dp))
+        if (f.status.isNotEmpty()) Text(f.status.keys.joinToString("") { statusIcon(it) }, fontSize = 9.sp,
+            modifier = Modifier.align(Alignment.BottomStart).padding(bottom = 4.dp, start = 2.dp))
+        if (popup != null) Text(popup, fontSize = 12.sp, fontWeight = FontWeight.Bold, color = Color(0xFFFFC107),
+            modifier = Modifier.align(Alignment.Center).background(Color(0x99000000)).padding(horizontal = 2.dp))
+    }
+}
+
+private fun statusIcon(s: Status) = when (s) {
+    Status.BURN -> "🔥"; Status.POISON -> "☠"; Status.SLOW -> "🐌"; Status.STUN -> "💫"
+    Status.WEAKEN -> "⬇"; Status.CURSE -> "✖"; Status.REGEN -> "✚"
+}
+
+@Composable
+private fun IntentList(battle: TacticsBattle) {
+    if (battle.intents.isEmpty() || battle.winner != null) return
+    val letters = battle.fighters.filter { it.side == TacticsBattle.PLAYER }.mapIndexed { i, f -> f.id to "ABC"[i % 3] }.toMap()
+    Card(colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant), modifier = Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(8.dp)) {
+            Text("Enemy intents", style = MaterialTheme.typography.labelLarge)
+            battle.intents.forEach { i ->
+                val e = battle.byId(i.enemyId)
+                if (!e.alive) return@forEach
+                val target = i.targetId?.let { battle.byId(it) }
+                Text(
+                    if (target == null) "${e.name}: ${i.skill}"
+                    else "${e.name} → ${letters[target.id]} ${target.name} with ${i.skill}",
+                    style = MaterialTheme.typography.bodySmall
+                )
+            }
+        }
+    }
+}
