+enum class SkillKind { ATTACK, SELF, ALLY, TEAM, FOES, REVIVE, AURA }
+
+/**
+ * Who an attack hits. SPLASH: target + enemies next to it. LINE: every enemy in a straight line (row or column).
+ * CLEAVE: target + every enemy next to the attacker. NOVA: every enemy within range of the attacker.
+ */
+enum class Area { SINGLE, SPLASH, MULTI3, HITS4, LINE, CLEAVE, NOVA }
+
+/** Melee auras: last a few turns and affect everyone within the skill's range (usually 1) of the holder. */
+enum class AuraKind(val ally: Boolean) {
+    MIGHT(true),    // allies deal +value damage
+    WARD(true),     // allies take −value damage
+    GALE(true),     // allies get +value EVA
+    MEND(true),     // allies heal value × max HP each turn
+    FLAME(false),   // enemies take value × max HP at the start of their turn
+    FROST(false),   // enemies get Slowed at the start of their turn
+    MIASMA(false),  // enemies get +1 Poison at the start of their turn
+    DREAD(false)    // enemies deal −value damage
+}
