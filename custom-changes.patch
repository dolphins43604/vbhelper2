+@Composable
+private fun UnitDetails(battle: TacticsBattle, f: Fighter, onClose: () -> Unit) {
+    val intent = battle.intents.firstOrNull { it.enemyId == f.id }
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(10.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+            Text("${if (f.side == TacticsBattle.ENEMY) "Enemy: " else ""}${f.name}", fontWeight = FontWeight.SemiBold)
+            Text("${f.stage.label} · ${f.attr.label} · ${f.field?.label ?: "No Field"}", style = MaterialTheme.typography.bodySmall)
+            Text("HP ${f.hp.toInt()}/${f.maxHp.toInt()} · Energy ${f.energy}/3 · ATK ${f.atk.toInt()} · DEF ${f.def.toInt()} · SPD ${f.spd.toInt()} · " +
+                    "CRIT ${f.crit.toInt()}% · EVA ${f.eva.toInt()} · RES ${f.res.toInt()}" + (if (f.shield > 0) " · Shield ${f.shield.toInt()}" else ""),
+                style = MaterialTheme.typography.bodySmall)
+            if (f.status.isNotEmpty()) Text("Status: " + f.status.entries.joinToString { (k, v) -> "${k.label} ($v)" }, style = MaterialTheme.typography.bodySmall)
+            Text(Skills.fieldPassive(f.field), style = MaterialTheme.typography.bodySmall)
+            Text(Skills.attrTrait(f.attr), style = MaterialTheme.typography.bodySmall)
+            if (intent != null && f.alive) {
+                val target = intent.targetId?.let { battle.byId(it).name }
+                Text(if (target != null) "Next: ${intent.skill} on $target" else "Next: ${intent.skill}",
+                    color = Color(0xFFE53935), style = MaterialTheme.typography.bodySmall)
+            }
+            Text("Skills", style = MaterialTheme.typography.labelLarge)
+            f.skills.forEach { s ->
+                Text("${s.name} · ${skillCostText(s)}: ${s.description}", style = MaterialTheme.typography.bodySmall)
+            }
+            OutlinedButton(onClick = onClose) { Text("Close") }
+        }
+    }
+}
+
+@Composable
+private fun SpriteImage(bytes: ByteArray, width: Int, height: Int, modifier: Modifier, flip: Boolean) {
+    val context = LocalContext.current
+    val data = remember(bytes) { BitmapData(bytes, width, height).getImageBitmap(context, 1, false) }
+    Image(
+        bitmap = data.imageBitmap,
+        contentDescription = null,
+        filterQuality = FilterQuality.None,
+        contentScale = ContentScale.Fit,
+        modifier = modifier.graphicsLayer { scaleX = if (flip) -1f else 1f }
+    )
+}
