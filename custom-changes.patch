+data class Pos(val x: Int, val y: Int) {
+    fun dist(o: Pos): Int = abs(x - o.x) + abs(y - o.y)
+}
+
+/** Raw numbers for one Digimon going into battle. */
+data class FighterSpec(
+    val key: Long,               // links back to the stored Digimon or card Digimon (sprites)
+    val name: String,
+    val stage: Stage,
+    val attr: Attr,
+    val field: Field?,
+    val hp: Int, val ap: Int, val dp: Int,   // card stats (DP = BP)
+    val battles: Int = 0,
+    val winRatio: Double = 0.5,
+    val vitals: Int = 0,
+    val skills: List<Skill> = emptyList(),
+    val hpScale: Double = 1.0,
+    val atkScale: Double = 1.0,
+    /** Run layer: HP carried between fights (fraction), skill upgrade levels, chips/gear/upgrades, Crest. */
+    val startHp: Double = 1.0,
+    val skillLevels: Map<String, Int> = emptyMap(),
+    val mods: Mods = Mods(),
+    val crest: Crest? = null
+)
+
+/** Run-long bonuses from data chips, Plug-ins, Bits upgrades and level-up stat boosts. */
+data class Mods(
+    val hpMul: Double = 1.0, val atkMul: Double = 1.0, val defMul: Double = 1.0,
+    val spd: Double = 0.0, val crit: Double = 0.0, val eva: Double = 0.0, val res: Double = 0.0, val hit: Double = 0.0,
+    val energy: Int = 0, val energyMax: Int = 0,
+    val shieldStart: Double = 0.0, val shieldMul: Double = 1.0,
+    val lifesteal: Double = 0.0, val vsVirus: Double = 0.0,
+    val extraPoison: Int = 0, val basicBurn: Double = 0.0
+)
+
+/** Crests: one rule-changing gear effect each. */
+enum class Crest(val label: String, val description: String) {
+    COURAGE("Crest of Courage", "Below half HP: +25 CRIT"),
+    FRIENDSHIP("Crest of Friendship", "Every hit heals an adjacent ally for 10% of the damage"),
+    LOVE("Crest of Love", "When an ally is deleted: +30% ATK for the rest of the battle"),
+    KNOWLEDGE("Crest of Knowledge", "+10 hit and +10 RES"),
+    SINCERITY("Crest of Sincerity", "While guarding, reflects 50% of the damage taken"),
+    RELIABILITY("Crest of Reliability", "Ignores the first negative status each battle"),
+    HOPE("Crest of Hope", "Once per battle, survives a deletion at 1 HP"),
+    LIGHT("Crest of Light", "Heals all allies 5% at the start of each turn"),
+    KINDNESS("Crest of Kindness", "Enemies that hit it get Throttled"),
+    MIRACLES("Crest of Miracles", "10% chance a basic Attack becomes a free Special Move"),
+    DESTINY("Crest of Destiny", "Special Move costs 2 Energy instead of 3")
+}
+
+class Buff(
+    val source: String = "",
+    val dmg: Double = 0.0, val def: Double = 0.0, val eva: Double = 0.0, val move: Int = 0,
+    val spd: Double = 0.0, val crit: Double = 0.0, val res: Double = 0.0, val thorns: Double = 0.0,
+    var turns: Int
+)
+
+class Fighter(val id: Int, val side: Int, val spec: FighterSpec, var pos: Pos) {
+    val name get() = spec.name
+    val stage get() = spec.stage
+    val attr get() = spec.attr
+    val field get() = spec.field
+    val skills: List<Skill> = listOf(Skills.BASIC, Skills.SIGNATURE) + spec.skills
+
+    private fun rel(v: Int, med: Double): Double {
+        val r = if (med > 0) v / med else 1.0
+        return (1 + (r - 1) * Tuning.SPREAD).coerceIn(0.5, 2.0)
+    }
+
+    private val mods get() = spec.mods
+    val crest get() = spec.crest
+    val maxHp: Double = Tuning.HP_BASE * rel(spec.hp, stage.medHp) * stage.tier * spec.hpScale *
+            (1 + if (spec.field == Field.NSP) Tuning.NSP_HP else 0.0) * spec.mods.hpMul
+    val baseAtk: Double = Tuning.ATK_BASE * rel(spec.ap, stage.medAp) * stage.tier * spec.atkScale * spec.mods.atkMul
+    val baseDef: Double = Tuning.DEF_BASE * rel(spec.dp, stage.medDp) * spec.mods.defMul
+    val acc: Double = Tuning.DEF_BASE * rel(spec.dp, stage.medDp) + spec.mods.hit / Tuning.HIT_PER_ACC +
+            if (spec.crest == Crest.KNOWLEDGE) 10 / Tuning.HIT_PER_ACC else 0.0
+    val baseSpd: Double = 10.0 + min(10, spec.battles / 10) + spec.mods.spd
+    val baseCrit: Double = 5.0 + Math.round(10 * spec.winRatio) + spec.mods.crit
+    val baseEva: Double = 5.0 + spec.mods.eva
+    val baseRes: Double = 10.0 + min(15, spec.vitals / 1000) + spec.mods.res + if (spec.crest == Crest.KNOWLEDGE) 10.0 else 0.0
+    private val energyBonus = (if (spec.vitals >= 10000) 1 else 0) + spec.mods.energy
+    val energyMax: Int = Tuning.ENERGY_MAX + spec.mods.energyMax
+
+    var hp: Double = maxHp * spec.startHp.coerceIn(0.01, 1.0)
+    var energy: Int = min(Tuning.ENERGY_START + energyBonus, Tuning.ENERGY_MAX + spec.mods.energyMax)
+    var loveActive = false
+    var hopeUsed = false
+    var reliabilityUsed = false
+    val status = mutableMapOf<Status, Int>()   // turns left, or stacks for Poison
+    var shield = 0.0
+    var shieldTurns = 0
+    val buffs = mutableListOf<Buff>()
+    var overclock = 0
+    var analyzeTarget: Int = -1
+    var analyzeStacks = 0
+    var adaptReady = attr == Attr.FREE
+    var guarding = false
+    var stunImmune = 0
+    var revived = false
+    var sureHit = false
+    var acted = false
+    var aura: Skill? = null
+    var auraTurns = 0
+
+    val alive get() = hp > 0
+    /**
+     * Buffs don't stack: for each stat only the strongest bonus and the worst penalty count.
+     * (Casting the same skill again just refreshes it.)
+     */
+    fun buffSum(sel: (Buff) -> Double): Double {
+        val v = buffs.map(sel)
+        return (v.filter { it > 0 }.maxOrNull() ?: 0.0) + (v.filter { it < 0 }.minOrNull() ?: 0.0)
+    }
+    val atk get() = baseAtk * if (loveActive) 1.3 else 1.0
+    val def get() = baseDef * (1 + buffSum { it.def })
+    val spd get() = baseSpd + buffSum { it.spd } - if (Status.SLOW in status) Tuning.SLOW_SPD.toDouble() else 0.0
+    val eva get() = baseEva + buffSum { it.eva } + if (spec.field == Field.WG) Tuning.WG_EVA * stage.passive else 0.0
+    val crit get() = baseCrit + buffSum { it.crit } + if (crest == Crest.COURAGE && hp < maxHp / 2) 25.0 else 0.0
+    val res get() = baseRes + buffSum { it.res }
+    val move: Int
+        get() {
+            val m = stage.move + (if (spec.field == Field.WG) 1 else 0) + buffSum { it.move.toDouble() }.toInt()
+            return max(1, m - if (Status.SLOW in status) Tuning.SLOW_MOVE else 0)
+        }
+
+    /** Short text for active buffs, e.g. "+25% dmg (2)". */
+    fun buffText(): List<String> = buffs.map { b ->
+        listOfNotNull(
+            b.dmg.takeIf { it != 0.0 }?.let { "${if (it > 0) "+" else ""}${Math.round(it * 100)}% dmg" },
+            b.def.takeIf { it != 0.0 }?.let { "${if (it > 0) "+" else ""}${Math.round(it * 100)}% DEF" },
+            b.eva.takeIf { it != 0.0 }?.let { "+${it.toInt()} EVA" },
+            b.move.takeIf { it != 0 }?.let { "+$it move" },
+            b.spd.takeIf { it != 0.0 }?.let { "+${it.toInt()} SPD" },
+            b.crit.takeIf { it != 0.0 }?.let { "+${it.toInt()} CRIT" },
+            b.res.takeIf { it != 0.0 }?.let { "+${it.toInt()} RES" },
+            b.thorns.takeIf { it != 0.0 }?.let { "thorns" }
+        ).joinToString(", ") + " (${b.turns})"
+    }
+
+    fun skillRange(s: Skill): Int = s.range + if (field == Field.WG && s.range >= 2) 1 else 0
+
+    fun addShield(v: Double) {
+        shield = max(shield, v * mods.shieldMul); shieldTurns = Tuning.SHIELD_T
+    }
+
+    fun heal(v: Double): Double {
+        val amount = if (Status.CURSE in status) v * (1 - Tuning.CURSE) else v
+        val before = hp
+        hp = min(maxHp, hp + amount)
+        return hp - before
+    }
+}
+
+sealed class BattleEvent {
+    data class Moved(val id: Int, val from: Pos, val to: Pos) : BattleEvent()
+    data class Hit(val attacker: Int, val target: Int, val skill: String, val damage: Int, val crit: Boolean, val ko: Boolean) : BattleEvent()
+    data class Miss(val attacker: Int, val target: Int, val skill: String) : BattleEvent()
+    data class Support(val user: Int, val skill: String) : BattleEvent()
+    data class Line(val text: String) : BattleEvent()
+}
+
+data class Forecast(
+    val damage: Int, val hit: Int, val crit: Int, val advantage: Int,   // advantage: 1 yes, -1 target has it, 0 none
+    val doubles: Boolean, val kills: Boolean,
+    val counter: Boolean, val counterDamage: Int, val counterHit: Int,
+    val splashTargets: Int
+)
+
+data class Intent(val enemyId: Int, val targetId: Int?, val skill: String, val dest: Pos)
+
+data class Choice(val skill: Skill, val target: Fighter?, val dest: Pos)
+
+/**
+ * One tactics battle on a 6×6 grid: your side moves first each round, then every enemy follows its shown intent.
+ */
+class TacticsBattle(
+    team: List<FighterSpec>,
+    foes: List<FighterSpec>,
+    seed: Long = System.nanoTime(),
+    assistSpecs: List<FighterSpec> = emptyList()
+) {
+    companion object {
+        const val W = 6
+        const val H = 6
+        const val PLAYER = 0
+        const val ENEMY = 1
+    }
+
+    private val rng = Random(seed)
+    val fighters: List<Fighter>
+    var round = 1
+        private set
+    var winner: Int? = null
+        private set
+    val log = ArrayDeque<String>()
+    private var vbHealedSide = mutableMapOf<Int, Int>()
+    var intents: List<Intent> = emptyList()
+        private set
+
+    init {
+        val cols = listOf(1, 2, 3, 4, 0, 5)
+        var id = 0
+        fighters = team.mapIndexed { i, s -> Fighter(id++, PLAYER, s, Pos(cols[i % 6], 5)) } +
+                foes.mapIndexed { i, s -> Fighter(id++, ENEMY, s, Pos(cols[i % 6], if (i < 3) 0 else 1)) }
+        for (f in fighters) {
+            if (f.field == Field.ME) f.addShield(Tuning.ME_SHIELD * f.stage.passive * f.maxHp)
+            if (f.attr == Attr.VACCINE) f.addShield(Tuning.FIREWALL * f.maxHp)
+            if (f.spec.mods.shieldStart > 0) f.addShield(f.spec.mods.shieldStart * f.maxHp)
+        }
+        startPhase(PLAYER)
+    }
+
+    /** Befriended Digimon: each can jump in for one attack per battle from off the board. */
+    val assists: List<Fighter> = assistSpecs.mapIndexed { i, s -> Fighter(100 + i, PLAYER, s, Pos(-9, -9)) }
+    val assistUsed = mutableSetOf<Int>()
+
+    fun useAssist(index: Int, target: Fighter): List<BattleEvent> {
+        val events = mutableListOf<BattleEvent>()
+        val a = assists.getOrNull(index) ?: return events
+        if (index in assistUsed || winner != null || enemyPhase || !target.alive || target.side != ENEMY) return events
+        assistUsed += index
+        say("${a.name} jumps in to help!")
+        strike(a, target, Skills.SIGNATURE, events, counterOk = false, powerScale = 1.0 / Skills.SIGNATURE.power)
+        checkWinner()
+        return events
+    }
+
+    fun costOf(f: Fighter, s: Skill): Int = if (s === Skills.SIGNATURE && f.crest == Crest.DESTINY) 2 else s.cost
+
+    fun side(s: Int) = fighters.filter { it.side == s && it.alive }
+    fun at(p: Pos) = fighters.firstOrNull { it.alive && it.pos == p }
+    fun byId(id: Int) = fighters.first { it.id == id }
+    private fun say(t: String) {
+        log.addFirst(t); while (log.size > 40) log.removeLast()
+    }
+
+    // ---------------------------------------------------------------- movement and range
+
+    fun reachable(f: Fighter): Set<Pos> {
+        val blocked = fighters.filter { it.alive && it !== f }.map { it.pos }.toSet()
+        val seen = mutableMapOf(f.pos to 0)
+        var frontier = listOf(f.pos)
+        repeat(f.move) { step ->
+            val next = mutableListOf<Pos>()
+            for (p in frontier) for ((dx, dy) in listOf(1 to 0, -1 to 0, 0 to 1, 0 to -1)) {
+                val q = Pos(p.x + dx, p.y + dy)
+                if (q.x in 0 until W && q.y in 0 until H && q !in blocked && q !in seen) {
+                    seen[q] = step + 1; next += q
+                }
+            }
+            frontier = next
+        }
+        return seen.keys
+    }
+
+    fun canUse(f: Fighter, s: Skill): Boolean =
+        costOf(f, s) <= f.energy && !(s.heal > 0 && s.kind == SkillKind.SELF && f.hp / f.maxHp > s.healBelow) &&
+                !(s.kind == SkillKind.REVIVE && fighters.none { it.side == f.side && !it.alive && !it.revived })
+
+    /** Enemies the skill can reach when used from [from]. */
+    fun targetsFrom(f: Fighter, from: Pos, s: Skill): List<Fighter> =
+        side(1 - f.side).filter {
+            it.pos.dist(from) <= f.skillRange(s) && it.pos != from &&
+                    (s.area != Area.LINE || it.pos.x == from.x || it.pos.y == from.y)
+        }
+
+    /**
+     * Every enemy an area attack hits when [f] uses [s] from [from] on [t] (the target first).
+     * MULTI3 picks at random when it lands, so this returns just the target for it.
+     */
+    fun areaTargets(f: Fighter, from: Pos, s: Skill, t: Fighter): List<Fighter> {
+        val foes = side(1 - f.side)
+        val r = f.skillRange(s)
+        val extra = when (s.area) {
+            Area.SPLASH -> foes.filter { it !== t && it.pos.dist(t.pos) == 1 }
+            Area.CLEAVE -> foes.filter { it !== t && it.pos.dist(from) == 1 }
+            Area.NOVA -> foes.filter { it !== t && it.pos.dist(from) <= r }
+            Area.LINE -> {
+                val dx = Integer.signum(t.pos.x - from.x)
+                val dy = Integer.signum(t.pos.y - from.y)
+                (1..r).mapNotNull { i -> at(Pos(from.x + dx * i, from.y + dy * i)) }
+                    .filter { it.side != f.side && it !== t }
+            }
+            else -> emptyList()
+        }
+        return listOf(t) + extra
+    }
+
+    /** Tiles an area attack covers (for highlighting). */
+    fun areaTiles(f: Fighter, from: Pos, s: Skill, t: Fighter): Set<Pos> {
+        val r = f.skillRange(s)
+        val all = (0 until W).flatMap { x -> (0 until H).map { y -> Pos(x, y) } }
+        return when (s.area) {
+            Area.SPLASH -> all.filter { it.dist(t.pos) <= 1 }.toSet()
+            Area.CLEAVE -> all.filter { it.dist(from) == 1 }.toSet() + t.pos
+            Area.NOVA -> all.filter { it.dist(from) in 1..r }.toSet()
+            Area.LINE -> {
+                val dx = Integer.signum(t.pos.x - from.x)
+                val dy = Integer.signum(t.pos.y - from.y)
+                (1..r).map { i -> Pos(from.x + dx * i, from.y + dy * i) }.filter { it.x in 0 until W && it.y in 0 until H }.toSet()
+            }
+            else -> setOf(t.pos)
+        }
+    }
+
+    // ---------------------------------------------------------------- auras
+
+    /** The strongest aura of [kind] from side [owner] that reaches [f], and who holds it. */
+    private fun auraSource(f: Fighter, owner: Int, kind: AuraKind): Fighter? =
+        side(owner).filter { h -> h.auraTurns > 0 && h.aura?.aura == kind && h.pos.dist(f.pos) <= h.aura!!.range }
+            .maxByOrNull { it.aura!!.auraValue }
+
+    private fun auraValue(f: Fighter, owner: Int, kind: AuraKind): Double =
+        auraSource(f, owner, kind)?.aura?.auraValue ?: 0.0
+
+    /** Tiles covered by active auras: true for helpful (your side's) auras, false for harmful ones. */
+    fun auraTiles(): Map<Pos, Int> {
+        val out = mutableMapOf<Pos, Int>()
+        for (h in fighters.filter { it.alive && it.auraTurns > 0 && it.aura != null }) {
+            val r = h.aura!!.range
+            for (x in 0 until W) for (y in 0 until H) {
+                val p = Pos(x, y)
+                if (p.dist(h.pos) <= r) out[p] = h.side
+            }
+        }
+        return out
+    }
+
+    // ---------------------------------------------------------------- damage maths
+
+    private fun hitChance(a: Fighter, d: Fighter): Double {
+        var h = Tuning.HIT_BASE + Tuning.HIT_PER_ACC * (a.acc - d.acc) - d.eva
+        if (a.attr == Attr.DATA && a.analyzeTarget == d.id) h += Tuning.ANALYZE * a.analyzeStacks
+        h -= auraValue(d, d.side, AuraKind.GALE)
+        return h.coerceIn(Tuning.HIT_MIN, Tuning.HIT_MAX) / 100
+    }
+
+    private fun alliesNear(target: Fighter, side: Int, except: Fighter?, range: Int) =
+        side(side).count { it !== except && it.pos.dist(target.pos) <= range }
+
+    private fun multiplier(a: Fighter, d: Fighter, s: Skill, adapt: Boolean, from: Pos = a.pos): Double {
+        var m = 1.0
+        if (a.attr.beats(d.attr) || adapt) m *= Tuning.TRIANGLE
+        if (a.attr == Attr.DATA && a.analyzeTarget == d.id) m *= 1 + 0.01 * Tuning.ANALYZE * a.analyzeStacks
+        val pm = a.stage.passive
+        when (a.field) {
+            Field.DR -> m *= 1 + Tuning.DR_RAGE * pm * (1 - a.hp / a.maxHp)
+            Field.NSP -> m *= 1 + Tuning.NSP_PACK * pm * min(2, alliesNear(d, a.side, a, 2))
+            Field.DS -> if (Status.SLOW in d.status) m *= 1 + Tuning.DS_VS_SLOW * pm
+            Field.ME -> m *= 1 + Tuning.ME_STACK * pm * a.overclock
+            Field.VB -> if (d.attr == Attr.VIRUS) m *= 1 + Tuning.VB_VS_VIRUS * pm
+            Field.JT -> if ((d.status[Status.POISON] ?: 0) > 0) m *= 1 + Tuning.JT_VS_POISON * pm
+            else -> {}
+        }
+        if (Status.WEAKEN in a.status) m *= 1 - Tuning.WEAKEN
+        m *= 1 + a.buffSum { it.dmg }
+        m *= 1 + auraValue(a, a.side, AuraKind.MIGHT)
+        m *= 1 - auraValue(a, 1 - a.side, AuraKind.DREAD)
+        if (s.vsSlow > 0 && Status.SLOW in d.status) m *= 1 + s.vsSlow
+        if (s.vsCurse > 0 && Status.CURSE in d.status) m *= 1 + s.vsCurse
+        if (s.vsVirus > 0 && d.attr == Attr.VIRUS) m *= 1 + s.vsVirus
+        if (a.spec.mods.vsVirus > 0 && d.attr == Attr.VIRUS) m *= 1 + a.spec.mods.vsVirus
+        if (s.allyAdj > 0) m *= 1 + s.allyAdj * side(a.side).count { it !== a && it.pos.dist(d.pos) == 1 }
+        if (s.missingHp > 0) m *= 1 + s.missingHp * (1 - a.hp / a.maxHp)
+        if (s.execute > 0 && d.hp / d.maxHp < s.execute) m *= 2
+        return m
+    }
+
+    /** Skill upgrades from the run: +25% per level above 1 (up to level 3). */
+    fun level(a: Fighter, s: Skill): Double = 1 + Tuning.UPGRADE * ((a.spec.skillLevels[s.name] ?: 1) - 1)
+
+    private fun rawDamage(a: Fighter, d: Fighter, s: Skill, power: Double, adapt: Boolean): Double {
+        val de = d.def * (1 - if (a.attr == Attr.VIRUS) Tuning.CORRUPT else 0.0) * (1 - s.pierce)
+        var dmg = power * a.atk * 20 / (20 + de) * multiplier(a, d, s, adapt)
+        if (d.guarding) dmg *= Tuning.GUARD
+        dmg *= 1 - auraValue(d, d.side, AuraKind.WARD)
+        return dmg
+    }
+
+    /** What the forecast panel shows for an attack from [from] on [d]. */
+    fun forecast(a: Fighter, from: Pos, s: Skill, d: Fighter): Forecast {
+        val saved = a.pos
+        a.pos = from
+        val adapt = a.adaptReady && s.power > 0 && !a.attr.beats(d.attr)
+        val dmg = if (s.power > 0) rawDamage(a, d, s, s.power * level(a, s), adapt) else 0.0
+        val hit = if (a.sureHit || s.sureHit || s.power <= 0) 1.0 else hitChance(a, d)
+        val doubles = s === Skills.BASIC && a.spd >= d.spd + Tuning.DOUBLE_SPD
+        val total = dmg + if (doubles) dmg * Tuning.DOUBLE_POWER else 0.0
+        val shielded = max(0.0, total - d.shield)
+        val canCounter = s.power > 0 && !s.noCounter && from.dist(d.pos) <= 1 && Status.STUN !in d.status &&
+                (s.area == Area.SINGLE || s.area == Area.HITS4)
+        val cDmg = if (canCounter) rawDamage(d, a, Skills.BASIC, Tuning.COUNTER_POWER, false) else 0.0
+        val cHit = if (canCounter) hitChance(d, a) else 0.0
+        val splash = when (s.area) {
+            Area.MULTI3 -> 2
+            else -> areaTargets(a, from, s, d).size - 1
+        }
+        a.pos = saved
+        return Forecast(
+            damage = Math.round(dmg).toInt(),
+            hit = Math.round(hit * 100).toInt(),
+            crit = if (s.power > 0) Math.round(a.crit).toInt() else 0,
+            advantage = when {
+                a.attr.beats(d.attr) || adapt -> 1
+                d.attr.beats(a.attr) -> -1
+                else -> 0
+            },
+            doubles = doubles,
+            kills = shielded >= d.hp && hit >= 0.99,
+            counter = canCounter,
+            counterDamage = Math.round(cDmg).toInt(),
+            counterHit = Math.round(cHit * 100).toInt(),
+            splashTargets = splash
+        )
+    }
+
+    private fun applyDamage(a: Fighter, d: Fighter, amount: Double): Double {
+        var dmg = amount
+        if (d.shield > 0) {
+            val ab = min(d.shield, dmg); d.shield -= ab; dmg -= ab
+        }
+        if (d.hp - dmg <= 0 && d.crest == Crest.HOPE && !d.hopeUsed && d.hp > 1) {
+            d.hopeUsed = true; dmg = d.hp - 1; say("${d.name} hangs on through Hope!")
+        }
+        d.hp = max(0.0, d.hp - dmg)
+        if (!d.alive) side(d.side).filter { it.crest == Crest.LOVE }.forEach { it.loveActive = true }
+        return dmg
+    }
+
+    private fun tryStatus(a: Fighter, d: Fighter, st: Status, chance: Double = 1.0, stacks: Int = 1) {
+        if (!d.alive) return
+        if (d.side != a.side && rng.nextDouble() < d.res / 100) return
+        if (rng.nextDouble() > chance) return
+        if (st.negative && d.side != a.side && d.crest == Crest.RELIABILITY && !d.reliabilityUsed) {
+            d.reliabilityUsed = true; return
+        }
+        when (st) {
+            Status.POISON -> d.status[st] = min(Tuning.POISON_MAX, (d.status[st] ?: 0) + stacks + a.spec.mods.extraPoison)
+            Status.STUN -> if (d.stunImmune == 0) d.status[st] = 1
+            Status.BURN -> d.status[st] = Tuning.BURN_T
+            Status.SLOW -> d.status[st] = Tuning.SLOW_T
+            Status.WEAKEN -> d.status[st] = Tuning.WEAKEN_T
+            Status.CURSE -> d.status[st] = Tuning.CURSE_T
+            Status.REGEN -> d.status[st] = Tuning.REGEN_T
+        }
+    }
+
+    private fun strike(a: Fighter, d: Fighter, s: Skill, events: MutableList<BattleEvent>, counterOk: Boolean = true, powerScale: Double = 1.0) {
+        if (!a.alive || !d.alive) return
+        val adapt = a.adaptReady && s.power > 0 && !a.attr.beats(d.attr)
+        if (adapt) a.adaptReady = false
+        val power = s.power * powerScale * level(a, s)
+        val hc = if (a.sureHit || s.sureHit) 1.0 else hitChance(a, d)
+        val hit = power <= 0 || (rng.nextDouble() + rng.nextDouble()) / 2 < hc
+        if (a.sureHit && power > 0) a.sureHit = false
+        if (!hit) {
+            a.analyzeTarget = d.id; a.analyzeStacks = 0
+            events += BattleEvent.Miss(a.id, d.id, s.name)
+            say("${a.name}'s ${s.name} missed ${d.name}")
+            return
+        }
+        if (power > 0) {
+            var dmg = rawDamage(a, d, s, power, adapt) * (1 + (rng.nextDouble() * 2 - 1) * Tuning.VARIANCE)
+            val crit = rng.nextDouble() < a.crit / 100
+            if (crit) dmg *= Tuning.CRIT_DMG
+            if (s.consumePoison > 0) dmg += s.consumePoison * d.maxHp * (d.status.remove(Status.POISON) ?: 0)
+            if (s.breakShield) d.shield = 0.0
+            val dealt = applyDamage(a, d, dmg)
+            if (a.analyzeTarget == d.id) a.analyzeStacks = min(3, a.analyzeStacks + 1) else {
+                a.analyzeTarget = d.id; a.analyzeStacks = 1
+            }
+            val drain = s.lifesteal + a.spec.mods.lifesteal + if (a.field == Field.NSO) Tuning.NSO_DRAIN * a.stage.passive else 0.0
+            if (drain > 0) a.heal(drain * dealt)
+            d.buffs.filter { it.thorns > 0 }.forEach {
+                applyDamage(d, a, it.thorns * dealt); tryStatus(d, a, Status.POISON)
+            }
+            if (a.crest == Crest.FRIENDSHIP) side(a.side).filter { it !== a && it.pos.dist(a.pos) == 1 }
+                .minByOrNull { it.hp / it.maxHp }?.heal(0.10 * dealt)
+            if (d.guarding && d.crest == Crest.SINCERITY && a.alive) applyDamage(d, a, 0.5 * dealt)
+            if (d.crest == Crest.KINDNESS && d.alive) tryStatus(d, a, Status.WEAKEN)
+            events += BattleEvent.Hit(a.id, d.id, s.name, Math.round(dealt).toInt(), crit, !d.alive)
+            say("${a.name} ${s.name} → ${d.name}: ${Math.round(dealt)}${if (crit) " CRIT" else ""}${if (!d.alive) ", deleted" else ""}")
+        }
+        if (s.burn > 0) tryStatus(a, d, Status.BURN, s.burn)
+        if (s.slow > 0) tryStatus(a, d, Status.SLOW, s.slow)
+        if (s.weaken > 0) tryStatus(a, d, Status.WEAKEN, s.weaken)
+        if (s.curse > 0) tryStatus(a, d, Status.CURSE, s.curse)
+        if (s.stun > 0) tryStatus(a, d, Status.STUN, s.stun + if (Status.SLOW in d.status) s.stunIfSlow else 0.0)
+        if (s.poison > 0) tryStatus(a, d, Status.POISON, 1.0, s.poison)
+        if (s.poisonChance > 0) tryStatus(a, d, Status.POISON, s.poisonChance)
+        if (s === Skills.BASIC) {
+            if (a.spec.mods.basicBurn > 0) tryStatus(a, d, Status.BURN, a.spec.mods.basicBurn)
+            if (a.field == Field.NSO) tryStatus(a, d, Status.CURSE, Tuning.NSO_CURSE)
+            if (a.field == Field.JT) tryStatus(a, d, Status.POISON, 1.0,
+                Tuning.JT_POISON + if (a.stage == Stage.PERFECT || a.stage == Stage.ULTIMATE) 1 else 0)
+        }
+        if (s.push > 0 || s.pull > 0) shove(a, d, s.push - s.pull)
+        if (s.selfSlow) a.status[Status.SLOW] = 1
+        if (counterOk && d.alive && !s.noCounter && a.pos.dist(d.pos) <= 1 && Status.STUN !in d.status && power > 0) {
+            strike(d, a, Skills.BASIC, events, counterOk = false, powerScale = Tuning.COUNTER_POWER)
+        }
+    }
+
+    private fun shove(a: Fighter, d: Fighter, n: Int) {
+        if (!d.alive || n == 0) return
+        var dx = Integer.signum(d.pos.x - a.pos.x)
+        var dy = Integer.signum(d.pos.y - a.pos.y)
+        var steps = n
+        if (n < 0) { dx = -dx; dy = -dy; steps = -n }
+        repeat(steps) {
+            val q = Pos(d.pos.x + dx, d.pos.y + dy)
+            if (q.x in 0 until W && q.y in 0 until H && at(q) == null) d.pos = q
+        }
+    }
+
+    // ---------------------------------------------------------------- actions
+
+    /** Moves [f] to [dest] and uses [s] (on [target] for attacks). Pass s = null to just wait, guard = true to guard. */
+    fun act(f: Fighter, dest: Pos, s: Skill?, target: Fighter?, guard: Boolean = false): List<BattleEvent> {
+        val events = mutableListOf<BattleEvent>()
+        if (!f.alive || f.acted || winner != null) return events
+        if (dest != f.pos && dest in reachable(f)) {
+            events += BattleEvent.Moved(f.id, f.pos, dest); f.pos = dest
+        }
+        if (guard) {
+            f.guarding = true; say("${f.name} guards")
+        } else if (s != null && canUse(f, s)) {
+            f.energy -= costOf(f, s)
+            var used = s
+            if (s === Skills.BASIC && f.crest == Crest.MIRACLES && rng.nextDouble() < 0.10) {
+                used = Skills.SIGNATURE; say("Miracle! ${f.name}'s Attack becomes a Special Move")
+            }
+            if (used.kind == SkillKind.ATTACK && target != null) attack(f, used, target, events)
+            else support(f, used, events)
+        }
+        f.acted = true
+        checkWinner()
+        return events
+    }
+
+    private fun attack(f: Fighter, s: Skill, t: Fighter, events: MutableList<BattleEvent>) {
+        val foes = side(1 - f.side)
+        when (s.area) {
+            // Area attacks never draw counters (the forecast says so too).
+            Area.SPLASH, Area.LINE, Area.CLEAVE, Area.NOVA ->
+                areaTargets(f, f.pos, s, t).forEach { strike(f, it, s, events, counterOk = false) }
+            Area.MULTI3 -> foes.shuffled(rng).take(3).forEach { strike(f, it, s, events, counterOk = false) }
+            Area.HITS4 -> repeat(4) { if (t.alive) strike(f, t, s, events, counterOk = false) }
+            Area.SINGLE -> {
+                strike(f, t, s, events)
+                if (s === Skills.BASIC && t.alive && f.alive && f.spd >= t.spd + Tuning.DOUBLE_SPD) {
+                    strike(f, t, s, events, counterOk = false, powerScale = Tuning.DOUBLE_POWER)
+                }
+            }
+        }
+        if (s.retreat > 0 && f.alive) {
+            val foesLeft = side(1 - f.side)
+            reachable(f).maxByOrNull { p -> foesLeft.minOfOrNull { it.pos.dist(p) } ?: 0 }?.let {
+                if (it != f.pos) { events += BattleEvent.Moved(f.id, f.pos, it); f.pos = it }
+            }
+        }
+    }
+
+    private fun support(f: Fighter, s: Skill, events: MutableList<BattleEvent>) {
+        val allies = side(f.side)
+        val targets: List<Fighter> = when (s.kind) {
+            SkillKind.SELF -> listOf(f)
+            SkillKind.ALLY -> listOf(allies.filter { it.pos.dist(f.pos) <= s.range }.minByOrNull { it.hp / it.maxHp } ?: f)
+            SkillKind.TEAM -> allies.filter { it.pos.dist(f.pos) <= s.range }
+            SkillKind.FOES -> {
+                side(1 - f.side).filter { it.pos.dist(f.pos) <= s.range }.forEach { e ->
+                    if (s.weaken > 0) tryStatus(f, e, Status.WEAKEN)
+                    if (s.poison > 0) tryStatus(f, e, Status.POISON, 1.0, s.poison)
+                    if (s.push > 0) shove(f, e, s.push)
+                }
+                events += BattleEvent.Support(f.id, s.name); say("${f.name} uses ${s.name}")
+                return
+            }
+            SkillKind.REVIVE -> {
+                fighters.firstOrNull { it.side == f.side && !it.alive && !it.revived }?.let { d ->
+                    d.hp = s.revive * d.maxHp; d.revived = true; d.status.clear()
+                    val free = (0 until W).flatMap { x -> (0 until H).map { y -> Pos(x, y) } }
+                        .filter { at(it) == null }.minByOrNull { it.dist(f.pos) }
+                    if (free != null) d.pos = free
+                    say("${f.name} revives ${d.name}")
+                }
+                events += BattleEvent.Support(f.id, s.name)
+                return
+            }
+            SkillKind.AURA -> {
+                f.aura = s; f.auraTurns = s.buffTurns
+                events += BattleEvent.Support(f.id, s.name); say("${f.name} raises ${s.name}")
+                return
+            }
+            SkillKind.ATTACK -> emptyList()
+        }
+        val lv = level(f, s)
+        for (t in targets) {
+            if (s.heal > 0) t.heal(s.heal * lv * t.maxHp)
+            if (s.shield > 0) t.addShield(s.shield * lv * t.maxHp)
+            if (s.regen) t.status[Status.REGEN] = Tuning.REGEN_T
+            if (s.cleanse) Status.entries.filter { it.negative }.forEach { t.status.remove(it) }
+            if (s.buffDmg != 0.0 || s.selfDef != 0.0 || s.buffEva != 0.0 || s.buffMove != 0 || s.buffSpd != 0.0 ||
+                s.buffCrit != 0.0 || s.buffRes != 0.0 || s.thorns != 0.0
+            ) {
+                t.buffs.removeAll { it.source == s.name }
+                t.buffs += Buff(s.name, s.buffDmg, s.selfDef, s.buffEva, s.buffMove, s.buffSpd, s.buffCrit, s.buffRes, s.thorns,
+                    turns = s.buffTurns + if (t === f) 1 else 0)
+            }
+        }
+        if (s.overclock > 0) f.overclock = min(5, f.overclock + s.overclock)
+        if (s.energy > 0) f.energy = min(f.energyMax + 1, f.energy + s.energy)
+        if (s.sureHit) f.sureHit = true
+        events += BattleEvent.Support(f.id, s.name)
+        say("${f.name} uses ${s.name}")
+    }
+
+    private fun checkWinner() {
+        if (side(ENEMY).isEmpty()) winner = PLAYER
+        else if (side(PLAYER).isEmpty()) winner = ENEMY
+    }
+
+    // ---------------------------------------------------------------- phases
+
+    private fun startPhase(s: Int) {
+        for (f in side(s)) {
+            f.guarding = false
+            f.acted = false
+            if (f.energy <= f.energyMax) f.energy = min(f.energyMax, f.energy + 1)
+            val pm = f.stage.passive
+            if (f.field == Field.ME) f.overclock = min(5, f.overclock + 1)
+            if (f.field == Field.DS) f.heal(Tuning.DS_REGEN * pm * f.maxHp)
+            if (Status.REGEN in f.status) f.heal(Tuning.REGEN * f.maxHp)
+            if (side(s).any { it.crest == Crest.LIGHT }) f.heal(0.05 * f.maxHp)
+            auraValue(f, s, AuraKind.MEND).takeIf { it > 0 }?.let { f.heal(it * f.maxHp) }
+            auraSource(f, 1 - s, AuraKind.FLAME)?.let { h ->
+                f.hp = max(0.0, f.hp - h.aura!!.auraValue * f.maxHp); say("${f.name} is scorched by ${h.name}'s ${h.aura!!.name}")
+            }
+            auraSource(f, 1 - s, AuraKind.FROST)?.let { h -> tryStatus(h, f, Status.SLOW) }
+            auraSource(f, 1 - s, AuraKind.MIASMA)?.let { h -> tryStatus(h, f, Status.POISON, 1.0, 1) }
+            if (Status.BURN in f.status) f.hp = max(0.0, f.hp - Tuning.BURN * f.maxHp)
+            val p = f.status[Status.POISON] ?: 0
+            if (p > 0) f.hp = max(0.0, f.hp - Tuning.POISON * f.maxHp * p)
+            if (!f.alive) say("${f.name} was deleted by damage over time")
+            if (Status.STUN in f.status) {
+                f.acted = true; say("${f.name} crashed and skips its turn")
+            }
+        }
+        checkWinner()
+        if (s == PLAYER && winner == null) intents = planIntents()
+    }
+
+    private fun endPhase(s: Int) {
+        val vb = side(s).firstOrNull { it.field == Field.VB }
+        if (vb != null) {
+            side(s).filter { it.pos.dist(vb.pos) <= 2 }.minByOrNull { it.hp / it.maxHp }
+                ?.let { it.heal(Tuning.VB_HEAL * vb.stage.passive * it.maxHp) }
+        }
+        for (f in side(s)) {
+            if (Status.STUN in f.status) { f.status.remove(Status.STUN); f.stunImmune = 1 } else if (f.stunImmune > 0) f.stunImmune--
+            for (k in f.status.keys.toList()) {
+                if (k == Status.STUN) continue
+                if (k == Status.POISON) {
+                    if (round % 2 == 0) f.status[k] = (f.status[k] ?: 1) - 1
+                } else f.status[k] = (f.status[k] ?: 1) - 1
+                if ((f.status[k] ?: 0) <= 0) f.status.remove(k)
+            }
+            f.buffs.forEach { it.turns-- }
+            f.buffs.removeAll { it.turns <= 0 }
+            if (f.auraTurns > 0) {
+                f.auraTurns--
+                if (f.auraTurns == 0) f.aura = null
+            }
+            if (f.shield > 0) {
+                f.shieldTurns--
+                if (f.shieldTurns <= 0) f.shield = 0.0
+            }
+        }
+    }
+
+    private var enemyQueue: ArrayDeque<Fighter> = ArrayDeque()
+    private var enemyPlan: Map<Int, Intent> = emptyMap()
+    var enemyPhase = false
+        private set
+
+    /** Ends your phase. Call [enemyStep] until it returns null to play the enemies one at a time. */
+    fun beginEnemyPhase() {
+        if (winner != null || enemyPhase) return
+        endPhase(PLAYER)
+        startPhase(ENEMY)
+        enemyPlan = intents.associateBy { it.enemyId }
+        enemyQueue = ArrayDeque(side(ENEMY).sortedByDescending { it.spd })
+        enemyPhase = true
+    }
+
+    /** Plays the next enemy's turn and returns what happened, or null when the enemy phase is over. */
+    fun enemyStep(): List<BattleEvent>? {
+        if (!enemyPhase) return null
+        while (enemyQueue.isNotEmpty() && winner == null) {
+            val e = enemyQueue.removeFirst()
+            if (!e.alive || e.acted) continue
+            val choice = followIntent(e, enemyPlan[e.id]) ?: choose(e)
+            return if (choice == null) {
+                val foes = side(PLAYER)
+                val dest = reachable(e).minByOrNull { p -> foes.minOfOrNull { it.pos.dist(p) } ?: 0 } ?: e.pos
+                act(e, dest, null, null, guard = true)
+            } else {
+                act(e, choice.dest, choice.skill, choice.target)
+            }
+        }
+        endPhase(ENEMY)
+        enemyPhase = false
+        if (winner == null) {
+            round++
+            startPhase(PLAYER)
+        }
+        return null
+    }
+
+    /** Plays the whole enemy phase at once. */
+    fun endPlayerPhase(): List<BattleEvent> {
+        val events = mutableListOf<BattleEvent>()
+        beginEnemyPhase()
+        while (true) events += enemyStep() ?: break
+        return events
+    }
+
+    // ---------------------------------------------------------------- AI (both enemy intents and auto-play)
+
+    private fun planIntents(): List<Intent> = side(ENEMY).mapNotNull { e ->
+        val c = choose(e) ?: return@mapNotNull null
+        Intent(e.id, c.target?.id, c.skill.name, c.dest)
+    }
+
+    private fun followIntent(e: Fighter, intent: Intent?): Choice? {
+        if (intent == null) return null
+        val skill = e.skills.firstOrNull { it.name == intent.skill } ?: return null
+        if (!canUse(e, skill)) return null
+        if (intent.targetId == null) return Choice(skill, null, reachable(e).let { if (intent.dest in it) intent.dest else e.pos })
+        val t = byId(intent.targetId)
+        if (!t.alive) return null
+        val tiles = reachable(e).filter { p -> p != t.pos && p.dist(t.pos) <= e.skillRange(skill) &&
+                (skill.area != Area.LINE || p.x == t.pos.x || p.y == t.pos.y) }
+        if (tiles.isEmpty()) return null
+        return Choice(skill, t, if (intent.dest in tiles) intent.dest else bestTile(e, skill, t, tiles))
+    }
+
+    private fun bestTile(u: Fighter, s: Skill, t: Fighter, tiles: List<Pos>): Pos {
+        val foes = side(1 - u.side)
+        val allies = side(u.side)
+        return if (u.skillRange(s) >= 2) tiles.maxWith(compareBy<Pos>({ p -> foes.minOf { it.pos.dist(p) } }, { -it.dist(u.pos) }))
+        else tiles.maxWith(compareBy<Pos>({ allies.count { a -> a !== u && a.pos.dist(t.pos) == 1 } }, { -it.dist(u.pos) }))
+    }
+
+    private fun expected(a: Fighter, d: Fighter, s: Skill): Double {
+        if (s.power <= 0) return 0.0
+        val hc = if (a.sureHit || s.sureHit) 1.0 else hitChance(a, d)
+        val th = if (hc < 1) hc * hc * (3 - 2 * hc) else 1.0
+        return rawDamage(a, d, s, s.power * level(a, s), false) * th * (1 + a.crit / 100 * (Tuning.CRIT_DMG - 1))
+    }
+
+    private fun scoreAttack(u: Fighter, s: Skill, t: Fighter, from: Pos = u.pos): Double {
+        val foes = side(1 - u.side)
+        val hit = when (s.area) {
+            Area.MULTI3 -> foes.take(3)
+            Area.HITS4 -> List(4) { t }
+            Area.SINGLE -> listOf(t)
+            else -> areaTargets(u, from, s, t)
+        }
+        var v = 0.0
+        for (h in hit) {
+            val e = expected(u, h, s)
+            v += min(e, h.hp) / h.maxHp + if (e >= h.hp) 0.6 else 0.0
+        }
+        if (s.burn > 0 && Status.BURN !in t.status) v += 0.10 * s.burn
+        if (s.slow > 0 && Status.SLOW !in t.status) v += 0.06 * s.slow
+        if (s.weaken > 0 && Status.WEAKEN !in t.status) v += 0.08 * s.weaken
+        if (s.curse > 0 && Status.CURSE !in t.status) v += 0.04 * s.curse
+        if (s.stun > 0 && Status.STUN !in t.status) v += 0.25 * s.stun
+        if (s.poison > 0) v += 0.05 * s.poison
+        if (s.consumePoison > 0) v += s.consumePoison * (t.status[Status.POISON] ?: 0)
+        if (s.lifesteal > 0) v += 0.3 * (1 - u.hp / u.maxHp)
+        return v
+    }
+
+    private fun scoreSupport(u: Fighter, s: Skill): Double {
+        val allies = side(u.side)
+        val foes = side(1 - u.side)
+        val lowest = allies.minBy { it.hp / it.maxHp }
+        val missing = 1 - lowest.hp / lowest.maxHp
+        var v = 0.0
+        when (s.kind) {
+            SkillKind.SELF -> {
+                if (s.heal > 0) v += min(s.heal, 1 - u.hp / u.maxHp) * 1.5
+                if (s.shield > 0 && u.shield <= 0) v += s.shield * 0.8
+                if (s.buffDmg > 0 && u.buffs.none { it.dmg > 0 }) v += 0.18
+                if (s.buffEva > 0) v += 0.10
+                if (s.overclock > 0 && u.overclock < 4) v += 0.12
+                if (s.energy > 0 && u.energy <= 1) v += 0.08
+                if (s.sureHit && !u.sureHit) v += 0.10
+                if (s.thorns > 0 && u.buffs.none { it.thorns > 0 } && foes.any { it.pos.dist(u.pos) <= 2 }) v += 0.10
+                val foeNear = foes.any { it.pos.dist(u.pos) <= 1 + it.move }
+                if (s.selfDef > 0 && u.buffs.none { it.def > 0 } && foeNear) v += 0.10
+                if (s.buffCrit > 0 && !s.sureHit && u.buffs.none { it.crit > 0 }) v += 0.08
+                if ((s.buffMove > 0 || s.buffSpd > 0) && u.buffs.none { it.move > 0 }) v += 0.05
+            }
+            SkillKind.ALLY -> {
+                if (s.heal > 0) v += min(s.heal, missing) * 1.5
+                if (s.shield > 0 && lowest.shield <= 0) v += s.shield * 0.8 * (0.5 + missing)
+                if (s.cleanse) v += 0.15 * lowest.status.keys.count { it.negative }
+            }
+            SkillKind.TEAM -> {
+                if (s.shield > 0) v += s.shield * 0.6 * allies.count { it.shield <= 0 }
+                if (s.regen) v += 0.18 * allies.sumOf { 1 - it.hp / it.maxHp }
+                if (s.buffDmg > 0 && u.buffs.none { it.dmg > 0 }) v += 0.07 * allies.size
+                if (s.buffMove > 0) v += 0.03 * allies.size
+                if (s.buffSpd > 0 && s.buffMove == 0) v += 0.02 * allies.count { it.pos.dist(u.pos) <= s.range }
+            }
+            SkillKind.FOES -> {
+                val near = foes.filter { it.pos.dist(u.pos) <= s.range + u.move }
+                if (s.weaken > 0) v += 0.06 * near.count { Status.WEAKEN !in it.status }
+                if (s.poison > 0) v += 0.05 * s.poison * foes.size
+            }
+            SkillKind.REVIVE -> if (fighters.any { it.side == u.side && !it.alive && !it.revived }) v += 0.6
+            SkillKind.AURA -> if (u.auraTurns <= 1) {
+                val k = s.aura!!
+                if (k.ally) {
+                    val near = allies.count { it.pos.dist(u.pos) <= 2 }
+                    v += when (k) {
+                        AuraKind.MEND -> 0.12 * allies.filter { it.pos.dist(u.pos) <= 2 }.sumOf { 1 - it.hp / it.maxHp } + 0.04
+                        else -> 0.06 + 0.05 * near
+                    }
+                } else {
+                    val near = foes.count { it.pos.dist(u.pos) <= 1 + u.move }
+                    if (near > 0) v += 0.06 + 0.07 * min(near, 3)
+                }
+            }
+            SkillKind.ATTACK -> {}
+        }
+        return v
+    }
+
+    /** The greedy choice the simulator uses: best expected value over reachable tiles. */
+    fun choose(u: Fighter): Choice? {
+        val foes = side(1 - u.side)
+        val allies = side(u.side)
+        if (foes.isEmpty()) return null
+        val tiles = reachable(u).toList()
+        var best = 0.02
+        var choice: Choice? = null
+        for (s in u.skills) {
+            if (!canUse(u, s)) continue
+            if (s.kind == SkillKind.ATTACK) {
+                for (t in foes) {
+                    val cand = tiles.filter { p -> p != t.pos && p.dist(t.pos) <= u.skillRange(s) &&
+                            (s.area != Area.LINE || p.x == t.pos.x || p.y == t.pos.y) }
+                    if (cand.isEmpty()) continue
+                    if (s.area == Area.LINE || s.area == Area.CLEAVE || s.area == Area.NOVA) {
+                        // the tile decides who else gets hit, so score every tile
+                        val saved = u.pos
+                        var bestP: Pos? = null; var bestSc = -1.0
+                        for (p in cand) {
+                            u.pos = p
+                            val sc = scoreAttack(u, s, t, p)
+                            if (sc > bestSc) { bestSc = sc; bestP = p }
+                        }
+                        u.pos = saved
+                        val sc = bestSc - 0.04 * s.cost
+                        if (sc > best && bestP != null) { best = sc; choice = Choice(s, t, bestP) }
+                    } else {
+                        val sc = scoreAttack(u, s, t) - 0.04 * s.cost
+                        if (sc > best) { best = sc; choice = Choice(s, t, bestTile(u, s, t, cand)) }
+                    }
+                }
+            } else {
+                val sc = scoreSupport(u, s) - 0.04 * s.cost
+                if (sc > best) {
+                    val dest = if (s.kind == SkillKind.FOES || (s.kind == SkillKind.AURA && s.aura?.ally == false)) {
+                        val p = tiles.maxBy { p -> foes.count { it.pos.dist(p) <= s.range } }
+                        if (foes.none { it.pos.dist(p) <= s.range }) continue
+                        p
+                    } else {
+                        val cx = allies.sumOf { it.pos.x }.toDouble() / allies.size
+                        val cy = allies.sumOf { it.pos.y }.toDouble() / allies.size
+                        tiles.minBy { p -> abs(p.x - cx) + abs(p.y - cy) - 0.3 * foes.minOf { it.pos.dist(p) } }
+                    }
+                    best = sc; choice = Choice(s, null, dest)
+                }
+            }
+        }
+        return choice
+    }
+}
