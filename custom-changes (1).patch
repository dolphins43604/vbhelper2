+import com.github.nacabaro.vbhelper.utils.DeviceType
+
+/**
+ * Number boxes for every editable stat. Values outside a field's range are
+ * pulled back into it as you type, and the allowed range is shown underneath.
+ */
+@Composable
+fun StatsForm(
+    stats: ForgeStats,
+    deviceType: DeviceType,
+    onChange: (ForgeStats) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val isBe = deviceType == DeviceType.BEDevice
+
+    Column(
+        verticalArrangement = Arrangement.spacedBy(8.dp),
+        modifier = modifier.fillMaxWidth()
+    ) {
+        SectionTitle(stringResource(R.string.forge_section_basics))
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            StatField(stringResource(R.string.forge_vitals), stats.vitalPoints, ForgeLimits.VITALS, Modifier.weight(1f)) {
+                onChange(stats.copy(vitalPoints = it))
+            }
+            StatField(
+                if (isBe) stringResource(R.string.forge_training_pp) else stringResource(R.string.forge_trophies),
+                stats.trophies, ForgeLimits.TROPHIES, Modifier.weight(1f)
+            ) { onChange(stats.copy(trophies = it)) }
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            StatField(stringResource(R.string.forge_mood), stats.mood, ForgeLimits.MOOD, Modifier.weight(1f)) {
+                onChange(stats.copy(mood = it))
+            }
+            StatField(stringResource(R.string.forge_age), stats.ageInDays, ForgeLimits.AGE, Modifier.weight(1f)) {
+                onChange(stats.copy(ageInDays = it))
+            }
+        }
+        StatField(stringResource(R.string.forge_evo_timer), stats.transformationCountdown, ForgeLimits.TIMER_MINUTES) {
+            onChange(stats.copy(transformationCountdown = it))
+        }
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Checkbox(checked = stats.injured, onCheckedChange = { onChange(stats.copy(injured = it)) })
+            Text(stringResource(R.string.forge_injured))
+        }
+
+        SectionTitle(stringResource(R.string.forge_section_battles))
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            StatField(stringResource(R.string.forge_stage_wins), stats.currentPhaseBattlesWon, ForgeLimits.BATTLES, Modifier.weight(1f)) {
+                onChange(stats.copy(currentPhaseBattlesWon = it))
+            }
+            StatField(stringResource(R.string.forge_stage_losses), stats.currentPhaseBattlesLost, ForgeLimits.BATTLES, Modifier.weight(1f)) {
+                onChange(stats.copy(currentPhaseBattlesLost = it))
+            }
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            StatField(stringResource(R.string.forge_total_wins), stats.totalBattlesWon, ForgeLimits.BATTLES, Modifier.weight(1f)) {
+                onChange(stats.copy(totalBattlesWon = it))
+            }
+            StatField(stringResource(R.string.forge_total_losses), stats.totalBattlesLost, ForgeLimits.BATTLES, Modifier.weight(1f)) {
+                onChange(stats.copy(totalBattlesLost = it))
+            }
+        }
+
+        if (isBe) {
+            SectionTitle(stringResource(R.string.forge_section_be))
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                StatField("HP", stats.trainingHp, ForgeLimits.BE_TRAINING, Modifier.weight(1f)) {
+                    onChange(stats.copy(trainingHp = it))
+                }
+                StatField("AP", stats.trainingAp, ForgeLimits.BE_TRAINING, Modifier.weight(1f)) {
+                    onChange(stats.copy(trainingAp = it))
+                }
+                StatField("BP", stats.trainingBp, ForgeLimits.BE_TRAINING, Modifier.weight(1f)) {
+                    onChange(stats.copy(trainingBp = it))
+                }
+            }
+            StatField(stringResource(R.string.forge_training_time), stats.remainingTrainingTimeInMinutes, ForgeLimits.TIMER_MINUTES) {
+                onChange(stats.copy(remainingTrainingTimeInMinutes = it))
+            }
+            Text(stringResource(R.string.forge_ability_rarity), style = MaterialTheme.typography.labelLarge)
+            Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                NfcCharacter.AbilityRarity.entries.take(3).forEach { rarity ->
+                    FilterChip(
+                        selected = stats.abilityRarity == rarity,
+                        onClick = { onChange(stats.copy(abilityRarity = rarity)) },
+                        label = { Text(rarity.name) }
+                    )
+                }
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                NfcCharacter.AbilityRarity.entries.drop(3).forEach { rarity ->
+                    FilterChip(
+                        selected = stats.abilityRarity == rarity,
+                        onClick = { onChange(stats.copy(abilityRarity = rarity)) },
+                        label = { Text(rarity.name) }
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun SectionTitle(text: String) {
+    Text(
+        text = text,
+        style = MaterialTheme.typography.titleMedium,
+        modifier = Modifier.padding(top = 8.dp)
+    )
+}
+
+@Composable
+private fun StatField(
+    label: String,
+    value: Int,
+    range: IntRange,
+    modifier: Modifier = Modifier.fillMaxWidth(),
+    onValue: (Int) -> Unit
+) {
+    // Keep the raw text so the box can be emptied while typing.
+    var text by remember(value) { mutableStateOf(value.toString()) }
+
+    OutlinedTextField(
+        value = text,
+        onValueChange = { input ->
+            val digits = input.filter { it.isDigit() }.take(5)
+            text = digits
+            if (digits.isNotEmpty()) {
+                val clamped = digits.toInt().coerceIn(range)
+                if (clamped.toString() != digits) text = clamped.toString()
+                onValue(clamped)
+            }
+        },
+        label = { Text(label) },
+        supportingText = { Text("${range.first}–${range.last}") },
+        singleLine = true,
+        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number),
+        modifier = modifier
+    )
+}
