+/** Offline battles for one stored Digimon: arena ladder and raid bosses. */
+@Composable
+fun OfflineBattleScreen(
+    navController: NavController,
+    characterId: Long
+) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val repo = remember {
+        OfflineBattleRepository(application, application.container.db, application.container.currencyRepository)
+    }
+    val scope = rememberCoroutineScope()
+
+    var me by remember { mutableStateOf<OfflineBattleDtos.MyFighter?>(null) }
+    var ladder by remember { mutableStateOf<List<OfflineBattleRepository.LadderOpponent>>(emptyList()) }
+    var bosses by remember { mutableStateOf<List<OfflineBattleDtos.CpuFighter>>(emptyList()) }
+    var rung by remember { mutableIntStateOf(0) }
+    var mode by remember { mutableStateOf<BattleMode>(BattleMode.Hub) }
+    var reload by remember { mutableIntStateOf(0) }
+
+    LaunchedEffect(characterId, reload) {
+        val f = repo.fighter(characterId)
+        me = f
+        if (f != null) {
+            ladder = repo.ladder(f)
+            bosses = repo.raidBosses()
+            rung = repo.ladderRung(characterId)
+        }
+    }
+
+    Scaffold(
+        topBar = {
+            TopBanner(
+                text = stringResource(R.string.offline_battle_title),
+                onBackClick = {
+                    if (mode is BattleMode.Hub) navController.popBackStack() else mode = BattleMode.Hub
+                }
+            )
+        }
+    ) { contentPadding ->
+        Box(
+            Modifier
+                .fillMaxSize()
+                .padding(top = contentPadding.calculateTopPadding())
+                .padding(horizontal = 16.dp)
+        ) {
+            val mine = me
+            if (mine == null) {
+                Text(stringResource(R.string.forge_loading), Modifier.padding(24.dp))
+                return@Box
+            }
+            when (val m = mode) {
+                is BattleMode.Hub -> Hub(
+                    me = mine,
+                    ladder = ladder,
+                    rung = rung,
+                    bosses = bosses,
+                    onArena = { opp -> mode = BattleMode.Arena(opp) },
+                    onRaid = { boss -> mode = BattleMode.RaidSetup(boss) }
+                )
+
+                is BattleMode.Arena -> Fight(
+                    team = listOf(characterId to BattleEngine.fromMine(mine)),
+                    opponent = m.opponent.stats,
+                    title = stringResource(R.string.offline_arena_fight, m.opponent.rung + 1),
+                    onFinished = { won, _ ->
+                        scope.launch {
+                            val credits = repo.finishArenaFight(characterId, m.opponent.rung, won)
+                            val cleared = won && m.opponent.rung + 1 >= OfflineBattleRepository.LADDER_SIZE
+                            mode = BattleMode.Result(
+                                won, credits,
+                                application.getString(
+                                    when {
+                                        cleared -> R.string.offline_result_ladder_cleared
+                                        won -> R.string.offline_result_win
+                                        else -> R.string.offline_result_loss_arena
+                                    }
+                                )
+                            )
+                            reload++
+                        }
+                    }
+                )
+
+                is BattleMode.RaidSetup -> RaidSetup(
+                    boss = m.boss,
+                    leaderId = characterId,
+                    onStart = { teamIds ->
+                        scope.launch {
+                            val team = teamIds.mapNotNull { id -> repo.fighter(id)?.let { id to BattleEngine.fromMine(it) } }
+                            if (team.isNotEmpty()) mode = BattleMode.Raid(m.boss, team)
+                        }
+                    }
+                )
+
+                is BattleMode.Raid -> Fight(
+                    team = m.team,
+                    opponent = BattleEngine.fromCpu(m.boss, hpMultiplier = OfflineBattleRepository.RAID_HP_MULTIPLIER),
+                    title = stringResource(R.string.offline_raid_fight, m.boss.cardName),
+                    onFinished = { won, fought ->
+                        scope.launch {
+                            val credits = repo.finishRaid(fought, m.boss.stage, won)
+                            mode = BattleMode.Result(
+                                won, credits,
+                                application.getString(if (won) R.string.offline_result_raid_win else R.string.offline_result_loss_raid)
+                            )
+                            reload++
+                        }
+                    }
+                )
+
+                is BattleMode.Result -> ResultView(m) { mode = BattleMode.Hub }
+            }
+        }
+    }
+}
