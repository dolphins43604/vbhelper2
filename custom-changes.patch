+package com.github.nacabaro.vbhelper.roguelike
+
+/**
+ * Roguelike combat content: stats, Field passives, attribute traits, status effects and the 60-skill pool.
+ * Every number matches the Phase 2 simulator (rogue_content.py), which tuned them on real card data.
+ */
+enum class Field(val label: String) {
+    DR("Dragon's Roar"),
+    NSP("Nature Spirits"),
+    DS("Deep Savers"),
+    WG("Wind Guardians"),
+    ME("Metal Empire"),
+    NSO("Nightmare Soldiers"),
+    VB("Virus Busters"),
+    JT("Jungle Troopers");
+
+    companion object {
+        fun fromCode(code: String?): Field? = when (code) {
+            "DR" -> DR; "NSp" -> NSP; "DS" -> DS; "WG" -> WG
+            "ME" -> ME; "NSo" -> NSO; "VB" -> VB; "JT" -> JT
+            else -> null
+        }
+    }
+}
+
+enum class Attr(val label: String) {
+    VACCINE("Vaccine"), DATA("Data"), VIRUS("Virus"), FREE("Free");
+
+    /** Vaccine beats Virus, Virus beats Data, Data beats Vaccine. */
+    fun beats(other: Attr): Boolean =
+        (this == VACCINE && other == VIRUS) || (this == VIRUS && other == DATA) || (this == DATA && other == VACCINE)
+}
+
+enum class Stage(val label: String, val tier: Double, val move: Int, val passive: Double,
+                 val medHp: Double, val medAp: Double, val medDp: Double) {
+    CHILD("Child", 1.0, 4, 1.0, 3.0, 2.0, 10.0),
+    ADULT("Adult", 1.25, 3, 1.25, 5.0, 3.0, 20.0),
+    PERFECT("Perfect", 1.55, 3, 1.5, 10.0, 4.0, 35.0),
+    ULTIMATE("Ultimate", 1.9, 2, 1.75, 14.0, 7.0, 50.0),
+    /** Baby forms (card stage 0–1). Last so the ordinals of the battle stages stay 0–3. */
+    BABY("In-Training", 0.8, 4, 1.0, 2.0, 1.0, 6.0);
+
+    companion object {
+        /** Card stage index: 0–1 baby, 2 Child, 3 Adult, 4 Perfect, 5+ Ultimate. */
+        fun fromCard(stage: Int): Stage = when {
+            stage <= 1 -> BABY
+            stage == 2 -> CHILD
+            stage == 3 -> ADULT
+            stage == 4 -> PERFECT
+            else -> ULTIMATE
+        }
+    }
+}
+
+enum class Status(val label: String, val negative: Boolean) {
+    BURN("Overheat", true), POISON("Malware", true), SLOW("Lag", true), STUN("Crash", true),
+    WEAKEN("Throttle", true), CURSE("Glitch", true), REGEN("Repair", false)
+}
+
+object Tuning {
