+@Composable
+@NonSkippableComposable
+@Suppress("UNUSED_PARAMETER")
+private fun StartSkills(run: RunState, repo: RunRepository, party: Map<Long, TacticsDtos.Fighter>, version: Int, commit: () -> Unit) {
+    val next = run.members.firstOrNull { it.skills.isEmpty() }
+    if (next == null) {
+        LaunchedEffect(Unit) { run.pending = Pending.NONE; commit() }
+        return
+    }
+    val f = party[next.key] ?: return
+    val field = repo.tactics.field(f)
+    val offers = remember(next.key) { Growth.startingOffers(field, Random(run.seed + next.key)) }
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(10.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text("Starting skill for ${repo.tactics.name(f)}", fontWeight = FontWeight.SemiBold)
+            Text("Area 1 only offers 0–1 Energy skills. Stronger ones unlock in areas 2 and 3.", style = MaterialTheme.typography.bodySmall)
+            offers.forEach { name ->
+                val s = Skills.byName(name) ?: return@forEach
+                OutlinedButton(onClick = { next.skills += name; commit() }, modifier = Modifier.fillMaxWidth()) {
+                    Column(Modifier.fillMaxWidth()) {
+                        Text("${s.name} · ${if (s.cost == 0) "free" else "${s.cost} Energy"}", fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                        Text(s.description, fontSize = 12.sp)
+                    }
+                }
+            }
+        }
+    }
+}
+
+/** After picks are done: show any gear drop, else the stop is finished. */
+private fun afterPicks(run: RunState) {
+    if (run.gearDrop != null) run.pending = Pending.GEAR else run.finishStop()
+}
+
+@Composable
+@NonSkippableComposable
+@Suppress("UNUSED_PARAMETER")
+private fun LevelUp(run: RunState, repo: RunRepository, party: Map<Long, TacticsDtos.Fighter>, version: Int, commit: () -> Unit) {
+    val key = run.picks.firstOrNull()
+    val m = run.members.firstOrNull { it.key == key }
+    if (key == null || m == null) {
+        LaunchedEffect(Unit) { run.picks.clear(); afterPicks(run); commit() }
+        return
+    }
+    val f = party[key] ?: return
+    val offers = remember(run.counter, key) { Growth.offers(m, repo.tactics.field(f), run.area, Random(run.seed + run.counter * 7919L + key)) }
+    var learning by remember(run.counter, key) { mutableStateOf<Offer.NewSkill?>(null) }
+
+    fun done(o: Offer, replace: String? = null) {
+        Growth.apply(m, o, replace)
+        run.picks.removeAt(0); run.counter++
+        if (run.picks.isEmpty()) afterPicks(run)
+        commit()
+    }
+
+    Card(Modifier.fillMaxWidth()) {
+        Column(Modifier.padding(10.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            Text("Level up! ${repo.tactics.name(f)} picks one:", fontWeight = FontWeight.SemiBold)
+            val l = learning
+            if (l != null) {
+                Text("${l.skill} needs a slot. Replace which skill?", style = MaterialTheme.typography.bodySmall)
+                m.skills.forEach { old -> OutlinedButton(onClick = { done(l, old) }, modifier = Modifier.fillMaxWidth()) { Text("Replace $old") } }
+                OutlinedButton(onClick = { learning = null }) { Text("Back") }
+            } else offers.forEach { o ->
+                OutlinedButton(
+                    onClick = {
+                        if (o is Offer.NewSkill && m.skills.size >= Growth.LEARNED_SLOTS) learning = o else done(o)
+                    },
+                    modifier = Modifier.fillMaxWidth()
+                ) {
+                    Column(Modifier.fillMaxWidth()) {
+                        Text(o.text, fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                        val skill = when (o) { is Offer.NewSkill -> o.skill; is Offer.Upgrade -> o.skill; else -> null }?.let { Skills.byName(it) }
+                        if (skill != null) Text("${if (skill.cost == 0) "free" else "${skill.cost} Energy"} · ${skill.description}", fontSize = 12.sp)
+                    }
+                }
+            }
+            Text("${run.picks.size} pick${if (run.picks.size == 1) "" else "s"} left", style = MaterialTheme.typography.bodySmall)
+        }
+    }
+}
+
+/** Learns [skill] on [m], asking which skill to replace when both slots are full. */
+@Composable
+@NonSkippableComposable
+private fun LearnSkill(m: Member, skill: String, onDone: () -> Unit, onCancel: () -> Unit) {
+    if (m.skills.size < Growth.LEARNED_SLOTS) {
+        LaunchedEffect(skill) { m.skills += skill; onDone() }
+        return
+    }
+    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+        Text("$skill needs a slot. Replace which skill?", style = MaterialTheme.typography.bodySmall)
+        m.skills.toList().forEach { old ->
+            OutlinedButton(onClick = { m.skills.remove(old); m.levels.remove(old); m.skills += skill; onDone() }, modifier = Modifier.fillMaxWidth()) {
+                Text("Replace $old")
+            }
+        }
+        OutlinedButton(onClick = onCancel) { Text("Cancel") }
+    }
+}
