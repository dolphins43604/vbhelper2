+package com.github.nacabaro.vbhelper.daos
+
+import androidx.room.Dao
+import androidx.room.Query
+import com.github.nacabaro.vbhelper.dtos.OfflineBattleDtos
+
+@Dao
+interface OfflineBattleDao {
+    /** One of your stored Digimon with everything a battle needs. */
+    @Query(
+        """
+        SELECT
+            uc.id AS userCharacterId,
+            uc.vitalPoints AS vitalPoints,
+            uc.mood AS mood,
+            uc.injuryStatus AS injuryStatus,
+            uc.currentPhaseBattlesWon AS phaseWins,
+            uc.currentPhaseBattlesLost AS phaseLosses,
+            uc.totalBattlesWon AS totalWins,
+            uc.totalBattlesLost AS totalLosses,
+            cc.stage AS stage,
+            cc.baseHp AS baseHp,
+            cc.baseAp AS baseAp,
+            cc.baseBp AS baseBp,
+            c.isBEm AS isBem,
+            COALESCE(be.trainingHp, 0) AS trainingHp,
+            COALESCE(be.trainingAp, 0) AS trainingAp,
+            COALESCE(be.trainingBp, 0) AS trainingBp,
+            s.spriteIdle1 AS idle1,
+            s.spriteIdle2 AS idle2,
+            s.spriteAttack AS attack,
+            s.spriteDodge AS dodge,
+            s.width AS width,
+            s.height AS height
+        FROM UserCharacter uc
+        JOIN CardCharacter cc ON uc.charId = cc.id
+        JOIN Card c ON c.id = cc.cardId
+        JOIN Sprite s ON s.id = cc.spriteId
+        LEFT JOIN BECharacterData be ON be.id = uc.id
+        WHERE uc.id = :userCharacterId
+    """
+    )
+    suspend fun getFighter(userCharacterId: Long): OfflineBattleDtos.MyFighter?
+
+    /** Every card Digimon at a stage, used as arena opponents. */
+    @Query(
+        """
+        SELECT
+            cc.id AS id,
+            c.name AS cardName,
+            cc.stage AS stage,
+            cc.baseHp AS hp,
+            cc.baseAp AS ap,
+            cc.baseBp AS bp,
+            s.spriteIdle1 AS idle1,
+            s.spriteIdle2 AS idle2,
+            s.spriteAttack AS attack,
+            s.spriteDodge AS dodge,
+            s.width AS width,
+            s.height AS height
+        FROM CardCharacter cc
+        JOIN Card c ON c.id = cc.cardId
+        JOIN Sprite s ON s.id = cc.spriteId
+        WHERE cc.stage = :stage AND c.isBEm = :isBem
+    """
+    )
+    suspend fun getOpponentsAtStage(stage: Int, isBem: Boolean): List<OfflineBattleDtos.CpuFighter>
+
+    /** Adventure bosses from every imported card, used as raid bosses. */
+    @Query(
+        """
+        SELECT
+            cc.id AS id,
+            c.name AS cardName,
+            cc.stage AS stage,
+            ca.bossHp AS hp,
+            ca.bossAp AS ap,
+            COALESCE(ca.bossBp, ca.bossDp) AS bp,
+            s.spriteIdle1 AS idle1,
+            s.spriteIdle2 AS idle2,
+            s.spriteAttack AS attack,
+            s.spriteDodge AS dodge,
+            s.width AS width,
+            s.height AS height
+        FROM CardAdventure ca
+        JOIN CardCharacter cc ON cc.id = ca.characterId
+        JOIN Card c ON c.id = ca.cardId
+        JOIN Sprite s ON s.id = cc.spriteId
+        ORDER BY c.name, ca.id
+    """
+    )
+    suspend fun getRaidBosses(): List<OfflineBattleDtos.CpuFighter>
+
+    @Query(
+        """
+        UPDATE UserCharacter SET
+            currentPhaseBattlesWon = MIN(currentPhaseBattlesWon + 1, 999),
+            totalBattlesWon = MIN(totalBattlesWon + 1, 999)
+        WHERE id = :userCharacterId
+    """
+    )
+    suspend fun addWin(userCharacterId: Long)
+
+    @Query(
+        """
+        UPDATE UserCharacter SET
+            currentPhaseBattlesLost = MIN(currentPhaseBattlesLost + 1, 999),
+            totalBattlesLost = MIN(totalBattlesLost + 1, 999)
+        WHERE id = :userCharacterId
+    """
+    )
+    suspend fun addLoss(userCharacterId: Long)
+}
