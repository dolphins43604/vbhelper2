+@Composable
+private fun RaidSetup(
+    boss: OfflineBattleDtos.CpuFighter,
+    leaderId: Long,
+    onStart: (List<Long>) -> Unit
+) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val storage = remember { StorageRepository(application.container.db) }
+    var everyone by remember { mutableStateOf<List<CharacterDtos.CharacterWithSprites>>(emptyList()) }
+    val helpers = remember { mutableStateListOf<Long>() }
+    LaunchedEffect(Unit) { everyone = storage.getAllCharacters().first() }
+
+    LazyColumn(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        item {
+            Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.padding(top = 8.dp)) {
+                Sprite(boss.idle1, boss.width, boss.height, flip = false, multiplier = 4)
+                Spacer(Modifier.width(12.dp))
+                Column {
+                    Text(boss.cardName, style = MaterialTheme.typography.titleLarge)
+                    Text(stringResource(R.string.offline_raid_setup_desc), style = MaterialTheme.typography.bodySmall)
+                }
+            }
+        }
+        val candidates = everyone.filter { it.id != leaderId && !it.isInAdventure }
+        if (candidates.isEmpty()) {
+            item { Text(stringResource(R.string.offline_no_helpers), style = MaterialTheme.typography.bodySmall) }
+        }
+        items(candidates.chunked(4)) { row ->
+            Row(horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                row.forEach { c ->
+                    val selected = c.id in helpers
+                    FilterChip(
+                        selected = selected,
+                        onClick = {
+                            if (selected) helpers.remove(c.id) else if (helpers.size < 2) helpers.add(c.id)
+                        },
+                        label = { Sprite(c.spriteIdle, c.spriteWidth, c.spriteHeight, flip = true, multiplier = 2) },
+                        modifier = Modifier.weight(1f)
+                    )
+                }
+                repeat(4 - row.size) { Spacer(Modifier.weight(1f)) }
+            }
+        }
+        item {
+            Button(
+                onClick = { onStart(listOf(leaderId) + helpers) },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(vertical = 16.dp)
+            ) { Text(stringResource(R.string.offline_raid_start, helpers.size + 1)) }
+        }
+    }
+}
+
+private enum class Pose { Idle, Attack, Dodge }
+
+@Composable
+private fun Fight(
+    team: List<Pair<Long, FighterStats>>,
+    opponent: FighterStats,
+    title: String,
+    onFinished: (won: Boolean, fought: List<Long>) -> Unit
+) {
+    val scope = rememberCoroutineScope()
+    var active by remember { mutableIntStateOf(0) }
+    val fought = remember { mutableStateListOf(team.first().first) }
+    val myMaxHp = remember { team.map { BattleEngine.battleHp(it.second, opponent).first } }
+    val myHp = remember { mutableStateListOf(*myMaxHp.toTypedArray()) }
+    val oppMaxHp = remember { BattleEngine.battleHp(team.first().second, opponent).second }
+    var oppHp by remember { mutableIntStateOf(oppMaxHp) }
+    var myPose by remember { mutableStateOf(Pose.Idle) }
+    var oppPose by remember { mutableStateOf(Pose.Idle) }
+    var busy by remember { mutableStateOf(false) }
+    var over by remember { mutableStateOf(false) }
+    val log = remember { mutableStateListOf<String>() }
+    var frame by remember { mutableIntStateOf(0) }
+
+    LaunchedEffect(Unit) {
+        while (true) { delay(500); frame++ }
+    }
+
+    val meter = rememberInfiniteTransition(label = "meter").animateFloat(
+        initialValue = 0f,
+        targetValue = 1f,
+        animationSpec = infiniteRepeatable(tween(900, easing = LinearEasing), RepeatMode.Reverse),
+        label = "meterPos"
+    )
+
+    val me = team[active].second
+
+    fun say(line: String) {
+        log.add(0, line)
+        if (log.size > 6) log.removeAt(log.lastIndex)
+    }
+
+    fun playRound(timing: Double) {
+        busy = true
+        scope.launch {
+            // Your attack
+            myPose = Pose.Attack
+            delay(300)
+            val hit = BattleEngine.attack(me, opponent, timing)
+            if (hit.landed) {
+                oppHp = (oppHp - hit.damage).coerceAtLeast(0)
+                say(if (hit.critical) "Critical! You dealt ${hit.damage}" else "You dealt ${hit.damage}")
+            } else {
+                oppPose = Pose.Dodge
+                say("Your attack missed")
+            }
+            delay(450)
+            myPose = Pose.Idle; oppPose = Pose.Idle
+            if (oppHp <= 0) {
+                over = true
+                say("You won!")
+                delay(700)
+                onFinished(true, fought.toList())
+                return@launch
+            }
+
+            // Opponent's attack
+            delay(250)
+            oppPose = Pose.Attack
+            delay(300)
+            val back = BattleEngine.attack(opponent, me, null)
+            if (back.landed) {
+                myHp[active] = (myHp[active] - back.damage).coerceAtLeast(0)
+                say(if (back.critical) "Critical! You took ${back.damage}" else "You took ${back.damage}")
+            } else {
+                myPose = Pose.Dodge
+                say("You dodged!")
+            }
+            delay(450)
+            myPose = Pose.Idle; oppPose = Pose.Idle
+
+            if (myHp[active] <= 0) {
+                if (active + 1 < team.size) {
+                    active++
+                    fought.add(team[active].first)
+                    say("Your next Digimon jumps in!")
+                } else {
+                    over = true
+                    say("You lost…")
+                    delay(700)
+                    onFinished(false, fought.toList())
+                    return@launch
+                }
+            }
+            busy = false
+        }
+    }
+
+    Column(
+        horizontalAlignment = Alignment.CenterHorizontally,
+        modifier = Modifier.fillMaxSize()
+    ) {
+        Text(title, style = MaterialTheme.typography.titleMedium, modifier = Modifier.padding(vertical = 8.dp))
+
+        HpBar(stringResource(R.string.offline_opponent), oppHp, oppMaxHp)
+        Row(
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.Bottom,
+            modifier = Modifier
+                .fillMaxWidth()
+                .height(170.dp)
+                .padding(vertical = 8.dp)
+        ) {
+            PoseSprite(me.sprites, myPose, frame, flip = true, lunge = 24)
+            PoseSprite(opponent.sprites, oppPose, frame, flip = false, lunge = -24)
+        }
+        HpBar(
+            stringResource(R.string.offline_you, active + 1, team.size),
+            myHp[active], myMaxHp[active]
+        )
+
+        Spacer(Modifier.height(12.dp))
+        PowerMeter(position = if (busy || over) 0.5f else meter.value)
+        Text(
+            stringResource(R.string.offline_meter_hint),
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.outline
+        )
+        Button(
+            enabled = !busy && !over,
+            onClick = { playRound(BattleEngine.timingQuality(meter.value)) },
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(vertical = 8.dp)
+                .height(56.dp)
+        ) { Text(stringResource(R.string.offline_attack), style = MaterialTheme.typography.titleLarge) }
+
+        log.forEach { Text(it, style = MaterialTheme.typography.bodySmall) }
+    }
+}
+
+@Composable
+private fun HpBar(label: String, hp: Int, max: Int) {
+    Column(Modifier.fillMaxWidth()) {
+        Text("$label  $hp / $max", style = MaterialTheme.typography.labelMedium)
+        LinearProgressIndicator(
+            progress = { if (max == 0) 0f else hp.toFloat() / max },
+            color = if (hp * 4 < max) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.primary,
+            modifier = Modifier
+                .fillMaxWidth()
+                .height(10.dp)
+                .clip(RoundedCornerShape(5.dp))
+        )
+    }
+}
+
+/** Sweeping marker; the green middle zone gives the best hit, the very centre a critical. */
+@Composable
+private fun PowerMeter(position: Float) {
+    Box(
+        Modifier
+            .fillMaxWidth()
+            .height(22.dp)
+            .clip(RoundedCornerShape(11.dp))
+            .background(MaterialTheme.colorScheme.surfaceContainerHighest)
+    ) {
+        Box(
+            Modifier
+                .fillMaxHeight()
+                .fillMaxWidth(0.3f)
+                .align(Alignment.Center)
+                .background(MaterialTheme.colorScheme.primaryContainer)
+        )
+        Box(
+            Modifier
+                .fillMaxHeight()
+                .fillMaxWidth(0.075f)
+                .align(Alignment.Center)
+                .background(MaterialTheme.colorScheme.primary)
+        )
+        Box(Modifier.fillMaxSize()) {
+            Box(
+                Modifier
+                    .fillMaxHeight()
+                    .fillMaxWidth(position.coerceIn(0.01f, 1f))
+            ) {
+                Box(
+                    Modifier
+                        .align(Alignment.CenterEnd)
+                        .width(4.dp)
+                        .fillMaxHeight()
+                        .background(MaterialTheme.colorScheme.onSurface)
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun PoseSprite(sprites: FighterStats.Sprites, pose: Pose, frame: Int, flip: Boolean, lunge: Int) {
+    val bytes = when (pose) {
+        Pose.Attack -> sprites.attack
+        Pose.Dodge -> sprites.dodge
+        Pose.Idle -> if (frame % 2 == 0) sprites.idle1 else sprites.idle2
+    }
+    Box(Modifier.offset(x = if (pose == Pose.Attack) lunge.dp else 0.dp)) {
+        Sprite(bytes, sprites.width, sprites.height, flip = flip, multiplier = 6)
+    }
+}
+
+@Composable
+private fun Sprite(bytes: ByteArray, width: Int, height: Int, flip: Boolean, multiplier: Int) {
+    val context = LocalContext.current
+    val data = remember(bytes) {
+        BitmapData(bytes, width, height).getImageBitmap(context, multiplier, false)
+    }
+    Image(
+        bitmap = data.imageBitmap,
+        contentDescription = null,
+        filterQuality = FilterQuality.None,
+        modifier = Modifier
+            .size(data.dpWidth, data.dpHeight)
+            .scale(if (flip) -1f else 1f, 1f)
+    )
+}
+
+@Composable
+private fun ResultView(result: BattleMode.Result, onDone: () -> Unit) {
+    Column(
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.Center,
+        modifier = Modifier.fillMaxSize()
+    ) {
+        Text(
+            text = stringResource(if (result.won) R.string.offline_victory else R.string.offline_defeat),
+            style = MaterialTheme.typography.headlineLarge,
+            color = if (result.won) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.error
+        )
+        Text(result.message, textAlign = TextAlign.Center, modifier = Modifier.padding(16.dp))
+        if (result.credits > 0) {
+            Text(stringResource(R.string.offline_credits_earned, result.credits), fontWeight = FontWeight.Bold)
+        }
+        OutlinedButton(onClick = onDone, modifier = Modifier.padding(top = 24.dp)) {
+            Text(stringResource(R.string.offline_back_to_hub))
+        }
+    }
+}
