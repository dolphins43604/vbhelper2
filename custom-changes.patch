+@OptIn(ExperimentalLayoutApi::class)
+@Composable
+private fun RunSetup(repo: RunRepository, leaderId: Long, onUpgrades: () -> Unit, onStart: (List<Long>, List<Long>) -> Unit) {
+    val application = LocalContext.current.applicationContext as VBHelper
+    val storage = remember { StorageRepository(application.container.db) }
+    var everyone by remember { mutableStateOf<List<CharacterDtos.CharacterWithSprites>>(emptyList()) }
+    var cards by remember { mutableStateOf<List<TacticsDtos.CardOption>>(emptyList()) }
+    val party = remember { mutableStateListOf<Long>().apply { if (leaderId > 0) add(leaderId) } }
+    var areas by remember { mutableStateOf<List<TacticsDtos.CardOption>>(emptyList()) }
+    var bits by remember { mutableIntStateOf(0) }
+
+    fun reroll() {
+        val pool = cards.filter { !it.isBem }.ifEmpty { cards }
+        areas = if (pool.size >= 3) pool.shuffled().take(3) else List(3) { pool.random() }
+    }
+
+    LaunchedEffect(Unit) {
+        everyone = storage.getAllCharacters().first()
+        cards = repo.tactics.cards()
+        bits = repo.loadUpgrades().bits
+        if (cards.isNotEmpty()) reroll()
+    }
+
+    Column(Modifier.fillMaxSize().verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+        Text("New run", style = MaterialTheme.typography.titleLarge, modifier = Modifier.padding(top = 8.dp))
+        Text("Cross 3 areas of 8 stops each. Enemies start as baby forms and evolve as you go. Each battle won sends " +
+                "+1 win and −30 min of evolution timer home to your Digimon (bosses: +1 trophy, −1 hour more; clearing the run: −2 hours).",
+            style = MaterialTheme.typography.bodySmall)
+        Text("Your team (${party.size}/3)", style = MaterialTheme.typography.titleMedium)
+        FlowRow(horizontalArrangement = Arrangement.spacedBy(6.dp), verticalArrangement = Arrangement.spacedBy(6.dp)) {
+            everyone.filter { !it.isInAdventure && it.stage >= 2 }.forEach { c ->
+                val selected = c.id in party
+                FilterChip(
+                    selected = selected,
+                    onClick = {
+                        if (c.id == leaderId) return@FilterChip
+                        if (selected) party.remove(c.id) else if (party.size < 3) party.add(c.id)
+                    },
+                    label = { SpriteImage(c.spriteIdle, c.spriteWidth, c.spriteHeight, Modifier.size(36.dp), flip = true) }
+                )
+            }
+        }
+        Text("Areas", style = MaterialTheme.typography.titleMedium)
+        if (cards.isEmpty()) Text("Import some cards first (Settings → Import card folder).", color = MaterialTheme.colorScheme.error)
+        areas.forEachIndexed { i, c -> Text("Area ${i + 1}: ${c.name}") }
+        OutlinedButton(onClick = { reroll() }, enabled = cards.isNotEmpty()) { Text("Reroll areas") }
+        OutlinedButton(onClick = onUpgrades, modifier = Modifier.fillMaxWidth()) { Text("Bits upgrades ($bits Bits)") }
+        Button(
+            onClick = { onStart(party.toList(), areas.map { it.id }) },
+            enabled = party.size == 3 && areas.size == 3,
+            modifier = Modifier.fillMaxWidth().padding(vertical = 12.dp)
+        ) { Text(if (party.size < 3) "Pick ${3 - party.size} more Digimon" else "Start run") }
+    }
+}
