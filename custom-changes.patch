+package com.github.nacabaro.vbhelper.dtos
+
+import com.github.cfogrady.vbnfc.data.NfcCharacter
+
+object ToolsDtos {
+    /** One possible Jogress result: needs a partner with [partnerAttribute]. */
+    data class JogressOption(
+        val toCharaId: Long,
+        val partnerAttribute: NfcCharacter.Attribute,
+        val charaIndex: Int,
+        val cardId: Long,
+        val stage: Int,
+        val spriteIdle: ByteArray,
+        val spriteWidth: Int,
+        val spriteHeight: Int
+    ) {
+        override fun equals(other: Any?): Boolean =
+            other is JogressOption && other.toCharaId == toCharaId && other.partnerAttribute == partnerAttribute
+
+        override fun hashCode(): Int = 31 * toCharaId.hashCode() + partnerAttribute.hashCode()
