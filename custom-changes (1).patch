+package com.github.nacabaro.vbhelper.source
+
+import android.content.Context
+import com.github.cfogrady.vbnfc.be.BENfcCharacter
+import com.github.cfogrady.vbnfc.be.FirmwareVersion
+import com.github.cfogrady.vbnfc.data.NfcCharacter
+import com.github.cfogrady.vbnfc.vb.SpecialMission
+import com.github.cfogrady.vbnfc.vb.VBNfcCharacter
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/**
+ * Keeps Digimon that were scanned off the bracelet while their card wasn't
+ * imported yet. Before this, such a Digimon was simply lost: the bracelet had
+ * already let it go and the app refused to save it.
+ *
+ * Each one is saved as a small JSON file. When its card is imported later,
+ * [CardLibrary] turns it back into a normal stored Digimon.
+ */
+class LostAndFound(context: Context) {
+    private val dir = File(context.applicationContext.filesDir, "lost-and-found").apply { mkdirs() }
+
+    data class Entry(val file: File, val character: NfcCharacter)
+
+    fun save(character: NfcCharacter): File {
+        val file = File(dir, "digimon-${System.currentTimeMillis()}.json")
+        file.writeText(toJson(character).toString())
+        return file
+    }
+
+    fun entries(): List<Entry> =
+        (dir.listFiles { f -> f.extension == "json" } ?: emptyArray())
+            .sortedBy { it.name }
+            .mapNotNull { f -> runCatching { Entry(f, fromJson(JSONObject(f.readText()))) }.getOrNull() }
+
+    fun count(): Int = dir.listFiles { f -> f.extension == "json" }?.size ?: 0
+
+    fun remove(entry: Entry) {
+        entry.file.delete()
+    }
+
+    // ---- JSON conversion ----
+
+    private fun toJson(c: NfcCharacter): JSONObject {
+        val o = JSONObject()
+        o.put("type", if (c is BENfcCharacter) "BE" else "VB")
+        o.put("dimId", c.dimId.toInt())
+        o.put("charIndex", c.charIndex.toInt())
+        o.put("stage", c.stage.toInt())
+        o.put("attribute", c.attribute.name)
+        o.put("ageInDays", c.ageInDays.toInt())
+        o.put("nextAdventureMissionStage", c.nextAdventureMissionStage.toInt())
+        o.put("mood", c.mood.toInt())
+        o.put("vitalPoints", c.vitalPoints.toInt())
+        o.put("itemEffectMentalStateValue", c.itemEffectMentalStateValue.toInt())
+        o.put("itemEffectMentalStateMinutesRemaining", c.itemEffectMentalStateMinutesRemaining.toInt())
+        o.put("itemEffectActivityLevelValue", c.itemEffectActivityLevelValue.toInt())
+        o.put("itemEffectActivityLevelMinutesRemaining", c.itemEffectActivityLevelMinutesRemaining.toInt())
+        o.put("itemEffectVitalPointsChangeValue", c.itemEffectVitalPointsChangeValue.toInt())
+        o.put("itemEffectVitalPointsChangeMinutesRemaining", c.itemEffectVitalPointsChangeMinutesRemaining.toInt())
+        o.put("transformationCountdownInMinutes", c.transformationCountdownInMinutes.toInt())
+        o.put("injuryStatus", c.injuryStatus.name)
+        o.put("trophies", c.trophies.toInt())
+        o.put("currentPhaseBattlesWon", c.currentPhaseBattlesWon.toInt())
+        o.put("currentPhaseBattlesLost", c.currentPhaseBattlesLost.toInt())
+        o.put("totalBattlesWon", c.totalBattlesWon.toInt())
+        o.put("totalBattlesLost", c.totalBattlesLost.toInt())
+        o.put("activityLevel", c.activityLevel.toInt())
+        o.put("heartRateCurrent", c.heartRateCurrent.toInt())
+        o.put("transformationHistory", JSONArray().apply {
+            c.transformationHistory.forEach {
+                put(JSONArray(listOf(it.toCharIndex.toInt(), it.year.toInt(), it.month.toInt(), it.day.toInt())))
+            }
+        })
+        o.put("vitalHistory", JSONArray().apply {
+            c.vitalHistory.forEach {
+                put(JSONArray(listOf(it.vitalsGained.toInt(), it.year.toInt(), it.month.toInt(), it.day.toInt())))
+            }
+        })
+        o.put("appReserved2", JSONArray(c.appReserved2.map { it.toInt() }))
+
+        if (c is BENfcCharacter) {
+            o.put("trainingHp", c.trainingHp.toInt())
+            o.put("trainingAp", c.trainingAp.toInt())
+            o.put("trainingBp", c.trainingBp.toInt())
+            o.put("remainingTrainingTimeInMinutes", c.remainingTrainingTimeInMinutes.toInt())
+            o.put("abilityRarity", c.abilityRarity.name)
+            o.put("abilityType", c.abilityType.toInt())
+            o.put("abilityBranch", c.abilityBranch.toInt())
+            o.put("abilityReset", c.abilityReset.toInt())
+            o.put("rank", c.rank.toInt())
+            o.put("itemType", c.itemType.toInt())
+            o.put("itemMultiplier", c.itemMultiplier.toInt())
+            o.put("itemRemainingTime", c.itemRemainingTime.toInt())
+            o.put("fwMajor", c.characterCreationFirmwareVersion.majorVersion.toInt())
+            o.put("fwMinor", c.characterCreationFirmwareVersion.minorVersion.toInt())
+        } else if (c is VBNfcCharacter) {
+            o.put("generation", c.generation.toInt())
+            o.put("totalTrophies", c.totalTrophies.toInt())
+            o.put("specialMissions", JSONArray().apply {
+                c.specialMissions.forEach {
+                    put(JSONObject().apply {
+                        put("type", it.type.name)
+                        put("id", it.id.toInt())
+                        put("goal", it.goal.toInt())
+                        put("timeLimit", it.timeLimitInMinutes.toInt())
+                        put("progress", it.progress.toInt())
+                        put("elapsed", it.timeElapsedInMinutes.toInt())
+                        put("status", it.status.name)
+                    })
+                }
+            })
+        }
+        return o
+    }
+
+    private fun fromJson(o: JSONObject): NfcCharacter {
+        fun i(key: String) = o.optInt(key, 0)
+        val transformations = o.getJSONArray("transformationHistory").let { arr ->
+            Array(arr.length()) { idx ->
+                val t = arr.getJSONArray(idx)
+                NfcCharacter.Transformation(
+                    toCharIndex = t.getInt(0).toUByte(),
+                    year = t.getInt(1).toUShort(),
+                    month = t.getInt(2).toUByte(),
+                    day = t.getInt(3).toUByte()
+                )
+            }
+        }
+        val vitals = o.getJSONArray("vitalHistory").let { arr ->
+            Array(arr.length()) { idx ->
+                val v = arr.getJSONArray(idx)
+                NfcCharacter.DailyVitals(
+                    vitalsGained = v.getInt(0).toUShort(),
+                    year = v.getInt(1).toUShort(),
+                    month = v.getInt(2).toUByte(),
+                    day = v.getInt(3).toUByte()
+                )
+            }
+        }
+        val reserved2 = o.optJSONArray("appReserved2")?.let { arr ->
+            Array(3) { idx -> if (idx < arr.length()) arr.getInt(idx).toUShort() else 0u.toUShort() }
+        } ?: Array(3) { 0u.toUShort() }
+        val attribute = NfcCharacter.Attribute.valueOf(o.getString("attribute"))
+        val injury = NfcCharacter.InjuryStatus.valueOf(o.getString("injuryStatus"))
+
+        return if (o.getString("type") == "BE") {
+            BENfcCharacter(
+                dimId = i("dimId").toUShort(),
+                charIndex = i("charIndex").toUShort(),
+                stage = i("stage").toByte(),
+                attribute = attribute,
+                ageInDays = i("ageInDays").toByte(),
+                nextAdventureMissionStage = i("nextAdventureMissionStage").toByte(),
+                mood = i("mood").toByte(),
+                vitalPoints = i("vitalPoints").toUShort(),
+                itemEffectMentalStateValue = i("itemEffectMentalStateValue").toByte(),
+                itemEffectMentalStateMinutesRemaining = i("itemEffectMentalStateMinutesRemaining").toByte(),
+                itemEffectActivityLevelValue = i("itemEffectActivityLevelValue").toByte(),
+                itemEffectActivityLevelMinutesRemaining = i("itemEffectActivityLevelMinutesRemaining").toByte(),
+                itemEffectVitalPointsChangeValue = i("itemEffectVitalPointsChangeValue").toByte(),
+                itemEffectVitalPointsChangeMinutesRemaining = i("itemEffectVitalPointsChangeMinutesRemaining").toByte(),
+                transformationCountdownInMinutes = i("transformationCountdownInMinutes").toUShort(),
+                injuryStatus = injury,
+                trainingPp = i("trophies").toUShort(),
+                currentPhaseBattlesWon = i("currentPhaseBattlesWon").toUShort(),
+                currentPhaseBattlesLost = i("currentPhaseBattlesLost").toUShort(),
+                totalBattlesWon = i("totalBattlesWon").toUShort(),
+                totalBattlesLost = i("totalBattlesLost").toUShort(),
+                activityLevel = i("activityLevel").toByte(),
+                heartRateCurrent = i("heartRateCurrent").toUByte(),
+                transformationHistory = transformations,
+                vitalHistory = vitals,
+                appReserved1 = ByteArray(12),
+                appReserved2 = reserved2,
+                trainingHp = i("trainingHp").toUShort(),
+                trainingAp = i("trainingAp").toUShort(),
+                trainingBp = i("trainingBp").toUShort(),
+                remainingTrainingTimeInMinutes = i("remainingTrainingTimeInMinutes").toUShort(),
+                abilityRarity = NfcCharacter.AbilityRarity.valueOf(o.optString("abilityRarity", "None")),
+                abilityType = i("abilityType").toUShort(),
+                abilityBranch = i("abilityBranch").toUShort(),
+                abilityReset = i("abilityReset").toByte(),
+                rank = i("rank").toByte(),
+                itemType = i("itemType").toByte(),
+                itemMultiplier = i("itemMultiplier").toByte(),
+                itemRemainingTime = i("itemRemainingTime").toByte(),
+                otp0 = ByteArray(8),
+                otp1 = ByteArray(8),
+                characterCreationFirmwareVersion = FirmwareVersion(
+                    majorVersion = i("fwMajor").toByte(),
+                    minorVersion = i("fwMinor").toByte()
+                )
+            )
+        } else {
+            val missions = o.optJSONArray("specialMissions")?.let { arr ->
+                Array(arr.length()) { idx ->
+                    val m = arr.getJSONObject(idx)
+                    SpecialMission(
+                        type = SpecialMission.Type.valueOf(m.getString("type")),
+                        id = m.getInt("id").toUShort(),
+                        goal = m.getInt("goal").toUShort(),
+                        timeLimitInMinutes = m.getInt("timeLimit").toUShort(),
+                        progress = m.getInt("progress").toUShort(),
+                        timeElapsedInMinutes = m.getInt("elapsed").toUShort(),
+                        status = SpecialMission.Status.valueOf(m.getString("status"))
+                    )
+                }
+            } ?: emptyArray()
+            VBNfcCharacter(
+                dimId = i("dimId").toUShort(),
+                charIndex = i("charIndex").toUShort(),
+                stage = i("stage").toByte(),
+                attribute = attribute,
+                ageInDays = i("ageInDays").toByte(),
+                nextAdventureMissionStage = i("nextAdventureMissionStage").toByte(),
+                mood = i("mood").toByte(),
+                vitalPoints = i("vitalPoints").toUShort(),
+                itemEffectMentalStateValue = i("itemEffectMentalStateValue").toByte(),
+                itemEffectMentalStateMinutesRemaining = i("itemEffectMentalStateMinutesRemaining").toByte(),
+                itemEffectActivityLevelValue = i("itemEffectActivityLevelValue").toByte(),
+                itemEffectActivityLevelMinutesRemaining = i("itemEffectActivityLevelMinutesRemaining").toByte(),
+                itemEffectVitalPointsChangeValue = i("itemEffectVitalPointsChangeValue").toByte(),
+                itemEffectVitalPointsChangeMinutesRemaining = i("itemEffectVitalPointsChangeMinutesRemaining").toByte(),
+                transformationCountdownInMinutes = i("transformationCountdownInMinutes").toUShort(),
+                injuryStatus = injury,
+                trophies = i("trophies").toUShort(),
+                currentPhaseBattlesWon = i("currentPhaseBattlesWon").toUShort(),
+                currentPhaseBattlesLost = i("currentPhaseBattlesLost").toUShort(),
+                totalBattlesWon = i("totalBattlesWon").toUShort(),
+                totalBattlesLost = i("totalBattlesLost").toUShort(),
+                activityLevel = i("activityLevel").toByte(),
+                heartRateCurrent = i("heartRateCurrent").toUByte(),
+                transformationHistory = transformations,
+                vitalHistory = vitals,
+                appReserved1 = ByteArray(12),
+                appReserved2 = reserved2,
+                generation = i("generation").toUShort(),
+                totalTrophies = i("totalTrophies").toUShort(),
+                specialMissions = missions
+            )
+        }
+    }
+}
diff --git a/app/src/main/java/com/github/nacabaro/vbhelper/utils/DebugLog.kt b/app/src/main/java/com/github/nacabaro/vbhelper/utils/DebugLog.kt
